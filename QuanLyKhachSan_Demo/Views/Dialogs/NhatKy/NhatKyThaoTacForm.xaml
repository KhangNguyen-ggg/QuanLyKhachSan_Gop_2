<Window x:Class="QuanLyKhachSan.Views.Dialogs.NhatKyThaoTacForm"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Thông tin nhật ký thao tác" Width="700" Height="700" MinWidth="540" MinHeight="400"
    WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
    Background="{StaticResource BackgroundBrush}" FontFamily="Segoe UI">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/QuanLyKhachSan;component/Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <!-- Bố cục cố định: tiêu đề, vùng nhập cuộn, hàng nút phía dưới. -->
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock x:Name="txtTieuDe" Text="Thông tin nhật ký thao tác" FontSize="22" FontWeight="SemiBold"
                       Foreground="{StaticResource GoldBrush}" TextWrapping="Wrap"/>
            </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="pnlNoiDung" Margin="0,0,12,0">
<TextBlock x:Name="txtThongBao" Text="Chức năng đang được hoàn thiện. Thay đổi chưa được lưu." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                <TextBlock Text="Từ ngày" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5"/>
                <DatePicker x:Name="dtpTuNgay" Height="36" Foreground="Black" Background="White"/>
                <TextBlock Text="Đến ngày" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5"/>
                <DatePicker x:Name="dtpDenNgay" Height="36" Foreground="Black" Background="White"/>
                <TextBlock Text="Tài khoản" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5"/>
                <ComboBox x:Name="cboTaiKhoan" Style="{StaticResource DarkComboBox}" SelectedIndex="0" MinHeight="36">
                    <ComboBoxItem Style="{StaticResource ReadableComboBoxItem}" Content="Tất cả"/>
                </ComboBox>
                <TextBlock Text="Hành động" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5"/>
                <ComboBox x:Name="cboHanhDong" Style="{StaticResource DarkComboBox}" SelectedIndex="0" MinHeight="36">
                    <ComboBoxItem Style="{StaticResource ReadableComboBoxItem}" Content="Tất cả"/>
                    <ComboBoxItem Style="{StaticResource ReadableComboBoxItem}" Content="Thêm"/>
                    <ComboBoxItem Style="{StaticResource ReadableComboBoxItem}" Content="Sửa"/>
                    <ComboBoxItem Style="{StaticResource ReadableComboBoxItem}" Content="Xóa"/>
                    <ComboBoxItem Style="{StaticResource ReadableComboBoxItem}" Content="Thu tiền"/>
                    <ComboBoxItem Style="{StaticResource ReadableComboBoxItem}" Content="Nhận phòng"/>
                    <ComboBoxItem Style="{StaticResource ReadableComboBoxItem}" Content="Trả phòng"/>
                </ComboBox>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="btnDong" Content="Đóng" Style="{StaticResource SecondaryButton}"
                    Click="btnDong_Click" IsCancel="True" MinWidth="100"/>
            <Button x:Name="btnLuu" Content="Xác nhận" Style="{StaticResource PrimaryButton}"
                    Click="btnLuu_Click" MinWidth="140" Margin="8,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>