<Window x:Class="QuanLyKhachSan.Views.Dialogs.GoiDichVuChiTietWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Chi tiết — Gói dịch vụ" Width="760" Height="700" MinWidth="540" MinHeight="400"
    WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource BackgroundBrush}" FontFamily="Segoe UI">
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/QuanLyKhachSan;component/Resources/Styles.xaml"/>
    </ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="{Binding TenGoi, StringFormat='Chi tiết — Gói dịch vụ — {0}'}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource GoldBrush}" TextWrapping="Wrap"/>
            <TextBlock x:Name="txtThongBao" Text="Nhấn Sửa để chỉnh sửa thông tin của dòng này." Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <TabControl x:Name="tabChiTiet" Grid.Row="1" Style="{StaticResource DarkTabControl}">
            <TabItem x:Name="tabThongTin" Header="Thông tin" Style="{StaticResource DarkTabItem}" Padding="16,12">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,12,0">
                <TextBlock Text="Mã" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
                <TextBox x:Name="txtMa" Text="{Binding Ma, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource DarkTextBox}"/>
                <TextBlock Text="Tên gói" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
                <TextBox x:Name="txtTenGoi" Text="{Binding TenGoi, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource DarkTextBox}"/>
                <TextBlock Text="Giá gói" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
                <TextBox x:Name="txtGiaGoi" Text="{Binding GiaGoi, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource DarkTextBox}"/>
                <TextBlock Text="Mô tả" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
                <TextBox x:Name="txtMoTa" Text="{Binding MoTa, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource DarkTextBox}"/>
                <TextBlock Text="Trạng thái" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
                <TextBox x:Name="txtTrangThai" Text="{Binding TrangThai, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource DarkTextBox}"/>
        </StackPanel></ScrollViewer>
            </TabItem>
            <TabItem x:Name="tabLienKet" Header="Thành phần gói" Style="{StaticResource DarkTabItem}" Padding="16,12">
                    <Grid x:Name="pnlLienKet" Margin="0,12,0,0">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Button x:Name="btnThanhPhanGoiThemMoi" Content="Thêm thành phần" Click="btnThemLienKet_Click" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,0,0,12"/>
                        <DataGrid x:Name="dgvThanhPhanGoi" Grid.Row="1" MouseDoubleClick="LienKet_DoubleClick" Style="{StaticResource DarkDataGrid}" CellStyle="{StaticResource DarkDataGridCell}" RowStyle="{StaticResource DarkDataGridRow}" ColumnHeaderStyle="{StaticResource DarkColumnHeader}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Dịch vụ" Binding="{Binding DichVu}" Width="*" MinWidth="95"/>
                                <DataGridTextColumn Header="Số lượng" Binding="{Binding SoLuong}" Width="*" MinWidth="95"/>
                                <DataGridTextColumn Header="Đơn giá thành phần" Binding="{Binding DonGiaThanhPhan}" Width="*" MinWidth="95"/>
                                <DataGridTextColumn Header="Ghi chú" Binding="{Binding GhiChu}" Width="*" MinWidth="95"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Grid.Row="2" Text="Nhấp đúp một dòng để sửa hoặc xóa. Dùng nút Thêm khi danh sách còn trống." Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,0" TextWrapping="Wrap"/>
                    </Grid>
            </TabItem>
        </TabControl>
        <WrapPanel Grid.Row="2" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="btnGoiDichVuThemMoi" Content="Thêm gói dịch vụ" Click="btnGoiDichVuThemMoi_Click" Style="{StaticResource PrimaryButton}" Margin="8,4,0,4" MinWidth="90"/>
            <Button x:Name="btnGoiDichVuSuaThongTin" Content="Sửa gói dịch vụ" Click="btnSua_Click" Style="{StaticResource SecondaryButton}" Margin="8,4,0,4" MinWidth="90"/>
            <Button x:Name="btnGoiDichVuXoa" Content="Xóa gói dịch vụ" Click="btnXoa_Click" Style="{StaticResource DangerButton}" Margin="8,4,0,4" MinWidth="90"/>
            <Button x:Name="btnLuuSua" Content="Lưu thay đổi" Click="btnLuuSua_Click" Style="{StaticResource PrimaryButton}" Margin="8,4,0,4" Visibility="Collapsed"/>
            <Button x:Name="btnHuySua" Content="Hủy sửa" Click="btnHuySua_Click" Style="{StaticResource SecondaryButton}" Margin="8,4,0,4" Visibility="Collapsed"/>
            <Button x:Name="btnDong" Content="Đóng" Click="btnDong_Click" Style="{StaticResource SecondaryButton}" Margin="8,4,0,4" IsCancel="True" MinWidth="90"/>
        </WrapPanel>
    </Grid>
</Window>
