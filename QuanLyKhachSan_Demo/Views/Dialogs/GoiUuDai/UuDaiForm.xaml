<Window x:Class="QuanLyKhachSan.Views.Dialogs.UuDaiForm"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Thông tin ưu đãi" Width="700" Height="700" MinWidth="540" MinHeight="400"
    WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
    Background="{StaticResource BackgroundBrush}" FontFamily="Segoe UI">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/QuanLyKhachSan;component/Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <!-- Bố cục cố định: tiêu đề, vùng nhập cuộn, hàng nút phía dưới. -->
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock x:Name="txtTieuDe" Text="Thông tin ưu đãi" FontSize="22" FontWeight="SemiBold"
                       Foreground="{StaticResource GoldBrush}" TextWrapping="Wrap"/>
            </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,12,0">
                <TextBlock Text="Tên ưu đãi" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5"/>
                <TextBox x:Name="txtTenUuDai" Text="Ưu đãi mùa thu" Style="{StaticResource DarkTextBox}" MinHeight="38"/>
                <TextBlock Text="Mã áp dụng" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5"/>
                <TextBox x:Name="txtMaApDung" Text="THU2026" Style="{StaticResource DarkTextBox}" MinHeight="38"/>
                <TextBlock Text="Loại giảm" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5"/>
                <ComboBox x:Name="cboLoaiGiam" Style="{StaticResource DarkComboBox}" SelectedIndex="0" MinHeight="36">
                    <ComboBoxItem Style="{StaticResource ReadableComboBoxItem}" Content="Phần trăm"/>
                    <ComboBoxItem Style="{StaticResource ReadableComboBoxItem}" Content="Số tiền"/>
                </ComboBox>
                <TextBlock Text="Giá trị giảm" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5"/>
                <TextBox x:Name="txtGiaTriGiam" Text="10" Style="{StaticResource DarkTextBox}" MinHeight="38"/>
                <TextBlock Text="Giảm tối đa (đ)" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5"/>
                <TextBox x:Name="txtGiamToiDaD" Text="500000" Style="{StaticResource DarkTextBox}" MinHeight="38"/>
                <TextBlock Text="Đơn tối thiểu (đ)" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5"/>
                <TextBox x:Name="txtDonToiThieuD" Text="2000000" Style="{StaticResource DarkTextBox}" MinHeight="38"/>
                <TextBlock Text="Từ ngày" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5"/>
                <DatePicker x:Name="dtpTuNgay" SelectedDate="2026-09-01" Height="36" Foreground="Black" Background="White"/>
                <TextBlock Text="Đến ngày" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5"/>
                <DatePicker x:Name="dtpDenNgay" SelectedDate="2026-10-31" Height="36" Foreground="Black" Background="White"/>
                <TextBlock Text="Điều kiện bổ sung" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5"/>
                <TextBox x:Name="txtDieuKienBoSung" Text="Áp dụng cho khách lưu trú" Style="{StaticResource DarkTextBox}" MinHeight="90" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                <TextBlock Text="Trạng thái" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5"/>
                <ComboBox x:Name="cboTrangThai" Style="{StaticResource DarkComboBox}" SelectedIndex="0" MinHeight="36">
                    <ComboBoxItem Style="{StaticResource ReadableComboBoxItem}" Content="Đang hoạt động"/>
                    <ComboBoxItem Style="{StaticResource ReadableComboBoxItem}" Content="Ngừng hoạt động"/>
                </ComboBox>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="btnDong" Content="Đóng" Style="{StaticResource SecondaryButton}"
                    Click="btnDong_Click" IsCancel="True" MinWidth="100"/>
            <Button x:Name="btnLuu" Content="Xác nhận" Style="{StaticResource PrimaryButton}"
                    Click="btnLuu_Click" MinWidth="140" Margin="8,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
