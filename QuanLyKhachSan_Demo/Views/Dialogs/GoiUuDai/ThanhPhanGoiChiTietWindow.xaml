<Window x:Class="QuanLyKhachSan.Views.Dialogs.ThanhPhanGoiChiTietWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Chi tiết — Thành phần gói" Width="760" Height="700" MinWidth="540" MinHeight="400"
    WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource BackgroundBrush}" FontFamily="Segoe UI">
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/QuanLyKhachSan;component/Resources/Styles.xaml"/>
    </ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,14">
            <TextBlock x:Name="txtTieuDe" Text="Chi tiết — Thành phần gói" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource GoldBrush}" TextWrapping="Wrap"/>
            <TextBlock x:Name="txtThongBao" Text="Nhấn Sửa để chỉnh sửa thông tin của dòng này." Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,12,0">
                <TextBlock Text="Gói" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
                <TextBox x:Name="txtGoi" Text="{Binding Goi, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource DarkTextBox}"/>
                <TextBlock Text="Dịch vụ" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
                <TextBox x:Name="txtDichVu" Text="{Binding DichVu, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource DarkTextBox}"/>
                <TextBlock Text="Số lượng" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
                <TextBox x:Name="txtSoLuong" Text="{Binding SoLuong, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource DarkTextBox}"/>
                <TextBlock Text="Đơn giá thành phần" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
                <TextBox x:Name="txtDonGiaThanhPhan" Text="{Binding DonGiaThanhPhan, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource DarkTextBox}"/>
                <TextBlock Text="Ghi chú" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
                <TextBox x:Name="txtGhiChu" Text="{Binding GhiChu, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource DarkTextBox}"/>
        </StackPanel></ScrollViewer>
        <WrapPanel Grid.Row="2" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="btnThanhPhanGoiSuaThongTin" Content="Sửa thông tin" Click="btnSua_Click" Style="{StaticResource SecondaryButton}" Margin="8,4,0,4" MinWidth="90"/>
            <Button x:Name="btnThanhPhanGoiXoa" Content="Xóa" Click="btnXoa_Click" Style="{StaticResource DangerButton}" Margin="8,4,0,4" MinWidth="90"/>
            <Button x:Name="btnLuuSua" Content="Lưu thay đổi" Click="btnLuuSua_Click" Style="{StaticResource PrimaryButton}" Margin="8,4,0,4" Visibility="Collapsed"/>
            <Button x:Name="btnHuySua" Content="Hủy sửa" Click="btnHuySua_Click" Style="{StaticResource SecondaryButton}" Margin="8,4,0,4" Visibility="Collapsed"/>
            <Button x:Name="btnDong" Content="Đóng" Click="btnDong_Click" Style="{StaticResource SecondaryButton}" Margin="8,4,0,4" IsCancel="True" MinWidth="90"/>
        </WrapPanel>
    </Grid>
</Window>
