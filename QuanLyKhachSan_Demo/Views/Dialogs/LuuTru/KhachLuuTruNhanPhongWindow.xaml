<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="QuanLyKhachSan.Views.Dialogs.KhachLuuTruNhanPhongWindow" Title="Nhận phòng" Width="720" Height="740" MinWidth="540" MinHeight="420" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource BackgroundBrush}" FontFamily="Segoe UI">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/QuanLyKhachSan;component/Resources/Styles.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock Text="Nhận phòng" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource GoldBrush}" Margin="0,0,0,14" />
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="0,0,12,0">
        <TextBlock Text="Lượt xếp phòng (mã)" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5" />
        <ComboBox x:Name="cboXepPhong" Style="{StaticResource DarkComboBox}" MinHeight="36" DisplayMemberPath="MaXepPhong" SelectedValuePath="MaXepPhong" SelectionChanged="Xep_Changed" />
        <TextBlock Text="Phòng" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5" />
        <TextBox x:Name="txtPhong" Text="{Binding SoPhong, Mode=OneWay}" Style="{StaticResource DarkTextBox}" MinHeight="36" IsReadOnly="True" />
        <TextBlock Text="Thực hiện cho lượt xếp phòng đang chọn. Đơn có nhiều phòng có thể nhận/trả từng phòng." Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5" />
      </StackPanel>
    </ScrollViewer>
    <WrapPanel Grid.Row="2" HorizontalAlignment="Right" Margin="0,18,0,0">
      <Button Content="Đóng" Click="btnDong_Click" IsCancel="True" Style="{StaticResource SecondaryButton}" MinWidth="100" x:Name="btnDong" />
      <Button x:Name="btnLuu" Content="Lưu" Click="btnLuu_Click" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" MinWidth="130" />
    </WrapPanel>
  </Grid>
</Window>
