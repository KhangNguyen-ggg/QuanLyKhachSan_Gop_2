<Window x:Class="QuanLyKhachSan.Views.Dialogs.LichSuLuuTruChiTietWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Chi tiết — Lịch sử lưu trú" Width="720" Height="740" MinWidth="540" MinHeight="420" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource BackgroundBrush}" FontFamily="Segoe UI">
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/QuanLyKhachSan;component/Resources/Styles.xaml" /></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
 <TextBlock Text="Chi tiết — Lịch sử lưu trú" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource GoldBrush}" Margin="0,0,0,14" />
 <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,12,0"><TextBlock Text="Mã xếp phòng" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5" /><TextBlock Text="{Binding MaXepPhong}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" /><TextBlock Text="Mã đơn" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5" /><TextBlock Text="{Binding MaDatPhong}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" /><TextBlock Text="Phòng" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5" /><TextBlock Text="{Binding SoPhong}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" /><TextBlock Text="Người đặt phòng" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5" /><TextBlock Text="{Binding HoTen}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" /><TextBlock Text="Nhận thực tế" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5" /><TextBlock Text="{Binding NgayNhanThucTe, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" /><TextBlock Text="Trả thực tế" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5" /><TextBlock Text="{Binding NgayTraThucTe, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" /><TextBlock Text="Trạng thái" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5" /><TextBlock Text="{Binding TrangThai, Converter={StaticResource StatusTextConverter}}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" /><TextBlock Text="Dịch vụ" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5"/><TextBlock Text="Chưa có dữ liệu" Foreground="{StaticResource TextPrimaryBrush}"/><TextBlock Text="Hóa đơn" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5"/><TextBlock Text="Chưa có dữ liệu" Foreground="{StaticResource TextPrimaryBrush}"/></StackPanel></ScrollViewer>
 <WrapPanel Grid.Row="2" HorizontalAlignment="Right" Margin="0,18,0,0"><Button Content="Đóng" Click="btnDong_Click" IsCancel="True" Style="{StaticResource SecondaryButton}" MinWidth="100" x:Name="btnDong" /></WrapPanel></Grid>
</Window>