<Window x:Class="QuanLyKhachSan.Views.Dialogs.CapVatTuNoiBoChiTietWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Chi tiết cấp nội bộ" Width="820" Height="760" MinWidth="620" MinHeight="450" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
    Background="{StaticResource BackgroundBrush}" FontFamily="Segoe UI">
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/QuanLyKhachSan;component/Resources/Styles.xaml"/>
    </ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,12">
            <TextBlock x:Name="txtTieuDe" Text="Chi tiết cấp nội bộ" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource GoldBrush}"/>
            <TextBlock x:Name="txtThongBao" TextWrapping="Wrap" Foreground="{StaticResource DangerBrush}" Margin="0,6,0,0" AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,12,0">
                <TextBlock Text="Mã phiếu" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
                <TextBox x:Name="txt0" Style="{StaticResource DarkTextBox}" Text="{Binding MaPhieuCap, Mode=OneWay}" IsReadOnly="True" MinHeight="36" />
                <TextBlock Text="Mục đích" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
                <TextBox x:Name="txt1" Style="{StaticResource DarkTextBox}" Text="{Binding MucDich, Converter={StaticResource StatusTextConverter}, Mode=OneWay}" IsReadOnly="True" MinHeight="36" />
                <TextBlock Text="Kho" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
                <TextBox x:Name="txt2" Style="{StaticResource DarkTextBox}" Text="{Binding Kho, Mode=OneWay}" IsReadOnly="True" MinHeight="36" />
                <TextBlock Text="Nhân viên lập" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
                <TextBox x:Name="txt3" Style="{StaticResource DarkTextBox}" Text="{Binding NhanVien, Mode=OneWay}" IsReadOnly="True" MinHeight="36" />
                <TextBlock Text="Tham chiếu" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
                <TextBox x:Name="txt4" Style="{StaticResource DarkTextBox}" Text="{Binding ThamChieu, Mode=OneWay}" IsReadOnly="True" MinHeight="36" />
                <TextBlock Text="Ngày cấp" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
                <TextBox x:Name="txt5" Style="{StaticResource DarkTextBox}" Text="{Binding NgayCap, StringFormat={}{0:dd/MM/yyyy HH:mm}, Mode=OneWay}" IsReadOnly="True" MinHeight="36" />
                <TextBlock Text="Trạng thái" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
                <TextBox x:Name="txt6" Style="{StaticResource DarkTextBox}" Text="{Binding TrangThai, Converter={StaticResource StatusTextConverter}, Mode=OneWay}" IsReadOnly="True" MinHeight="36" />
                <TextBlock Text="Ghi chú" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
                <TextBox x:Name="txt7" Style="{StaticResource DarkTextBox}" Text="{Binding GhiChu, Mode=OneWay}" IsReadOnly="True" MinHeight="36" />
            <Button x:Name="btnCapVatTuNoiBoThemVatTu" Content="Thêm vật tư" Click="btnThemDong_Click" Style="{StaticResource PrimaryButton}" Margin="8,4,0,4" MinWidth="100"/><DataGrid x:Name="dgvChiTiet" MouseDoubleClick="ChiTiet_DoubleClick" Style="{StaticResource DarkDataGrid}" CellStyle="{StaticResource DarkDataGridCell}" RowStyle="{StaticResource DarkDataGridRow}" ColumnHeaderStyle="{StaticResource DarkColumnHeader}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MinHeight="180" MaxHeight="340" Margin="0,14,0,0">
                <DataGrid.Columns>
                <DataGridTextColumn Header="Vật tư" Binding="{Binding TenVatTu}" Width="*" MinWidth="110"/>
                <DataGridTextColumn Header="Số lượng" Binding="{Binding SoLuong}" Width="*" MinWidth="110"/>
                <DataGridTextColumn Header="Đơn vị" Binding="{Binding DonViTinh}" Width="*" MinWidth="110"/>
                </DataGrid.Columns></DataGrid>
        </StackPanel></ScrollViewer>
        <WrapPanel Grid.Row="2" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="btnCapVatTuNoiBoXacNhan" Content="Xác nhận phiếu" Click="btnXacNhan_Click" Style="{StaticResource PrimaryButton}" Margin="8,4,0,4" MinWidth="100"/>
            <Button x:Name="btnCapVatTuNoiBoHuyPhieuCap" Content="Hủy phiếu Mới" Click="btnHuy_Click" Style="{StaticResource DangerButton}" Margin="8,4,0,4" MinWidth="100"/>
            <Button x:Name="btnDong" Content="Đóng" Click="btnDong_Click" IsCancel="True" Style="{StaticResource SecondaryButton}" Margin="8,4,0,4" MinWidth="100"/>
        </WrapPanel>
    </Grid>
</Window>
