<Window x:Class="QuanLyKhachSan.Views.Dialogs.PhieuNhapXuatChiTietWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Chi tiết — Phiếu nhập / xuất" Width="760" Height="700" MinWidth="540" MinHeight="400"
    WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource BackgroundBrush}" FontFamily="Segoe UI">
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/QuanLyKhachSan;component/Resources/Styles.xaml"/>
    </ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="{Binding MaPhieu, StringFormat='Chi tiết — Phiếu nhập / xuất — {0}'}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource GoldBrush}" TextWrapping="Wrap"/>
            <TextBlock x:Name="txtThongBao" Text="Nhấn Sửa để chỉnh sửa thông tin của dòng này." Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <TabControl x:Name="tabChiTiet" Grid.Row="1" Style="{StaticResource DarkTabControl}">
            <TabItem x:Name="tabThongTin" Header="Thông tin" Style="{StaticResource DarkTabItem}" Padding="16,12">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,12,0">
                <TextBlock Text="Mã phiếu" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
                <TextBox x:Name="txtMaPhieu" Text="{Binding MaPhieu, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource DarkTextBox}"/>
                <TextBlock Text="Loại" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
                <TextBox x:Name="txtLoai" Text="{Binding Loai, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource DarkTextBox}"/>
                <TextBlock Text="Kho" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
                <TextBox x:Name="txtKho" Text="{Binding Kho, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource DarkTextBox}"/>
                <TextBlock Text="Nhà cung cấp" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
                <TextBox x:Name="txtNhaCungCap" Text="{Binding NhaCungCap, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource DarkTextBox}"/>
                <TextBlock Text="Ngày" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
                <TextBox x:Name="txtNgay" Text="{Binding Ngay, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource DarkTextBox}"/>
                <TextBlock Text="Nhân viên" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
                <TextBox x:Name="txtNhanVien" Text="{Binding NhanVien, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource DarkTextBox}"/>
                <TextBlock Text="Ghi chú" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
                <TextBox x:Name="txtGhiChu" Text="{Binding GhiChu, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource DarkTextBox}"/>
        </StackPanel></ScrollViewer>
            </TabItem>
            <TabItem x:Name="tabLienKet" Header="Dòng vật tư" Style="{StaticResource DarkTabItem}" Padding="16,12">
                    <Grid x:Name="pnlLienKet" Margin="0,12,0,0">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Button x:Name="btnChiTietPhieuKhoThemMoi" Content="Thêm dòng vật tư" Click="btnThemLienKet_Click" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,0,0,12"/>
                        <DataGrid x:Name="dgvChiTietPhieuKho" Grid.Row="1" MouseDoubleClick="LienKet_DoubleClick" Style="{StaticResource DarkDataGrid}" CellStyle="{StaticResource DarkDataGridCell}" RowStyle="{StaticResource DarkDataGridRow}" ColumnHeaderStyle="{StaticResource DarkColumnHeader}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Vật tư" Binding="{Binding VatTu}" Width="*" MinWidth="95"/>
                                <DataGridTextColumn Header="Số lượng" Binding="{Binding SoLuong}" Width="*" MinWidth="95"/>
                                <DataGridTextColumn Header="Đơn vị" Binding="{Binding DonVi}" Width="*" MinWidth="95"/>
                                <DataGridTextColumn Header="Đơn giá" Binding="{Binding DonGia}" Width="*" MinWidth="95"/>
                                <DataGridTextColumn Header="Thành tiền" Binding="{Binding ThanhTien}" Width="*" MinWidth="95"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Grid.Row="2" Text="Nhấp đúp một dòng để sửa hoặc xóa. Dùng nút Thêm khi danh sách còn trống." Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,0" TextWrapping="Wrap"/>
                    </Grid>
            </TabItem>
        </TabControl>
        <WrapPanel Grid.Row="2" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="btnPhieuNhapXuatTaoPhieu" Content="Tạo phiếu" Click="btnPhieuNhapXuatTaoPhieu_Click" Style="{StaticResource PrimaryButton}" Margin="8,4,0,4" MinWidth="90"/>
            <Button x:Name="btnPhieuNhapXuatSuaPhieu" Content="Sửa phiếu" Click="btnSua_Click" Style="{StaticResource SecondaryButton}" Margin="8,4,0,4" MinWidth="90"/>
            <Button x:Name="btnPhieuNhapXuatXacNhanPhieu" Content="Xác nhận phiếu" Click="btnPhieuNhapXuatXacNhanPhieu_Click" Style="{StaticResource SecondaryButton}" Margin="8,4,0,4" MinWidth="90"/>
            <Button x:Name="btnPhieuNhapXuatHuyPhieu" Content="Hủy phiếu" Click="btnPhieuNhapXuatHuyPhieu_Click" Style="{StaticResource DangerButton}" Margin="8,4,0,4" MinWidth="90"/>
            <Button x:Name="btnLuuSua" Content="Lưu thay đổi" Click="btnLuuSua_Click" Style="{StaticResource PrimaryButton}" Margin="8,4,0,4" Visibility="Collapsed"/>
            <Button x:Name="btnHuySua" Content="Hủy sửa" Click="btnHuySua_Click" Style="{StaticResource SecondaryButton}" Margin="8,4,0,4" Visibility="Collapsed"/>
            <Button x:Name="btnDong" Content="Đóng" Click="btnDong_Click" Style="{StaticResource SecondaryButton}" Margin="8,4,0,4" IsCancel="True" MinWidth="90"/>
        </WrapPanel>
    </Grid>
</Window>
