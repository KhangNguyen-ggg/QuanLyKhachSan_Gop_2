<Window x:Class="QuanLyKhachSan.Views.Dialogs.PhieuNhapXuatChiTietWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Chi tiết phiếu kho" Width="820" Height="760" MinWidth="620" MinHeight="450" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
    Background="{StaticResource BackgroundBrush}" FontFamily="Segoe UI">
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/QuanLyKhachSan;component/Resources/Styles.xaml"/>
    </ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,12">
            <TextBlock x:Name="txtTieuDe" Text="Chi tiết phiếu kho" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource GoldBrush}"/>
            <TextBlock x:Name="txtThongBao" TextWrapping="Wrap" Foreground="{StaticResource DangerBrush}" Margin="0,6,0,0" AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,12,0">
<StackPanel x:Name="pnlThongTin">
                <TextBlock Text="Mã phiếu" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
                <TextBox x:Name="txtMaPhieu" Style="{StaticResource DarkTextBox}" Text="{Binding MaPhieu, Mode=OneWay}" IsReadOnly="True" MinHeight="36" Tag="Khoa"/>
                <TextBlock Text="Loại phiếu" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
                <ComboBox x:Name="cboLoaiPhieu" Style="{StaticResource DarkComboBox}" MinHeight="36" />
                <TextBlock Text="Kho" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
                <ComboBox x:Name="cboKho" Style="{StaticResource DarkComboBox}" MinHeight="36" />
                <TextBlock Text="Nhà cung cấp (tùy chọn)" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
                <ComboBox x:Name="cboNhaCungCap" Style="{StaticResource DarkComboBox}" MinHeight="36" />
                <TextBlock Text="Ngày phiếu" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
                <DatePicker x:Name="dtpNgay"  SelectedDate="{Binding NgayPhieu, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinHeight="36" />
                <TextBlock Text="Nhân viên lập phiếu" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
                <ComboBox x:Name="cboNhanVien" Style="{StaticResource DarkComboBox}" MinHeight="36" />
                <TextBlock Text="Mục đích" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
                <TextBox x:Name="txtMucDich" Style="{StaticResource DarkTextBox}" Text="{Binding MucDich, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinHeight="36" />
                <TextBlock Text="Ghi chú" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
                <TextBox x:Name="txtGhiChu" Style="{StaticResource DarkTextBox}" Text="{Binding GhiChu, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinHeight="36" />
                <TextBlock Text="Trạng thái" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
                <TextBox x:Name="txtTrangThai" Style="{StaticResource DarkTextBox}" Text="{Binding TrangThai, Converter={StaticResource StatusTextConverter}, Mode=OneWay}" IsReadOnly="True" MinHeight="36" Tag="Khoa"/>
                <TextBlock Text="Tổng tiền" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
                <TextBox x:Name="txtTongTien" Style="{StaticResource DarkTextBox}" Text="{Binding TongTien, Converter={StaticResource VndConverter}, Mode=OneWay}" IsReadOnly="True" MinHeight="36" Tag="Khoa"/>
</StackPanel>
<StackPanel x:Name="pnlLienKet">
<Button x:Name="btnChiTietPhieuKhoThemMoi" Content="Thêm vật tư" Click="btnThemDong_Click" Style="{StaticResource PrimaryButton}" Margin="8,4,0,4" MinWidth="100"/><DataGrid x:Name="dgvChiTiet" MouseDoubleClick="ChiTiet_DoubleClick" Style="{StaticResource DarkDataGrid}" CellStyle="{StaticResource DarkDataGridCell}" RowStyle="{StaticResource DarkDataGridRow}" ColumnHeaderStyle="{StaticResource DarkColumnHeader}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MinHeight="180" MaxHeight="340" Margin="0,14,0,0">
<DataGrid.Columns>
<DataGridTextColumn Header="Vật tư" Binding="{Binding TenVatTu}" Width="*" MinWidth="110"/>
<DataGridTextColumn Header="Số lượng" Binding="{Binding SoLuong}" Width="*" MinWidth="110"/>
<DataGridTextColumn Header="Đơn vị" Binding="{Binding DonViTinh}" Width="*" MinWidth="110"/>
<DataGridTextColumn Header="Đơn giá" Binding="{Binding DonGia, Converter={StaticResource VndConverter}}" Width="*" MinWidth="110"/>
<DataGridTextColumn Header="Thành tiền" Binding="{Binding ThanhTien, Converter={StaticResource VndConverter}}" Width="*" MinWidth="110"/>
</DataGrid.Columns></DataGrid>
                <TextBlock Text="Nhân viên xác nhận phiếu" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
                <ComboBox x:Name="cboNguoiXacNhan" Style="{StaticResource DarkComboBox}" MinHeight="36" />
</StackPanel>
        </StackPanel></ScrollViewer>
        <WrapPanel Grid.Row="2" HorizontalAlignment="Right" Margin="0,16,0,0">
<WrapPanel x:Name="pnlThaoTac">
<Button x:Name="btnPhieuNhapXuatSuaPhieu" Content="Sửa phiếu" Click="btnSua_Click" Style="{StaticResource SecondaryButton}" Margin="8,4,0,4" MinWidth="100"/><Button x:Name="btnPhieuNhapXuatXacNhanPhieu" Content="Xác nhận phiếu" Click="btnXacNhan_Click" Style="{StaticResource PrimaryButton}" Margin="8,4,0,4" MinWidth="100"/><Button x:Name="btnPhieuNhapXuatHuyPhieu" Content="Hủy phiếu Mới" Click="btnHuy_Click" Style="{StaticResource DangerButton}" Margin="8,4,0,4" MinWidth="100"/></WrapPanel>
<WrapPanel x:Name="pnlLuu" Visibility="Collapsed">
<Button x:Name="btnLuuSua" Content="Lưu thay đổi" Click="btnLuuSua_Click" Style="{StaticResource PrimaryButton}" Margin="8,4,0,4" MinWidth="100"/><Button x:Name="btnHuySua" Content="Hủy sửa" Click="btnHuySua_Click" Style="{StaticResource SecondaryButton}" Margin="8,4,0,4" MinWidth="100"/></WrapPanel>
            <Button x:Name="btnDong" Content="Đóng" Click="btnDong_Click" IsCancel="True" Style="{StaticResource SecondaryButton}" Margin="8,4,0,4" MinWidth="100"/>
        </WrapPanel>
    </Grid>
</Window>
