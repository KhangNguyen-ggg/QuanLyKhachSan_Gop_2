<Window x:Class="QuanLyKhachSan.Views.Dialogs.PhieuNhapXuatForm"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Phiếu nhập / xuất" Width="820" Height="760" MinWidth="620" MinHeight="450" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
    Background="{StaticResource BackgroundBrush}" FontFamily="Segoe UI">
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/QuanLyKhachSan;component/Resources/Styles.xaml"/>
    </ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,12">
            <TextBlock x:Name="txtTieuDe" Text="Phiếu nhập / xuất" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource GoldBrush}"/>
            <TextBlock x:Name="txtThongBao" TextWrapping="Wrap" Foreground="{StaticResource DangerBrush}" Margin="0,6,0,0" AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,12,0">
                <TextBlock Text="Loại phiếu" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
                <ComboBox x:Name="cboLoaiPhieu" Style="{StaticResource DarkComboBox}" MinHeight="36" />
                <TextBlock Text="Kho" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
                <ComboBox x:Name="cboKho" Style="{StaticResource DarkComboBox}" MinHeight="36" />
                <TextBlock Text="Nhà cung cấp (tùy chọn)" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
                <ComboBox x:Name="cboNhaCungCap" Style="{StaticResource DarkComboBox}" MinHeight="36" />
                <TextBlock Text="Ngày phiếu" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
                <DatePicker x:Name="dtpNgay"  SelectedDate="{Binding NgayPhieu, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinHeight="36" />
                <TextBlock Text="Nhân viên lập phiếu" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
                <ComboBox x:Name="cboNhanVien" Style="{StaticResource DarkComboBox}" MinHeight="36" />
                <TextBlock Text="Mục đích" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
                <TextBox x:Name="txtMucDich" Style="{StaticResource DarkTextBox}" Text="{Binding MucDich, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinHeight="36" />
                <TextBlock Text="Ghi chú" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
                <TextBox x:Name="txtGhiChu" Style="{StaticResource DarkTextBox}" Text="{Binding GhiChu, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinHeight="36" />
        </StackPanel></ScrollViewer>
        <WrapPanel Grid.Row="2" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="btnLuu" Content="Lưu phiếu Mới" Click="btnLuu_Click" Style="{StaticResource PrimaryButton}" Margin="8,4,0,4" MinWidth="100"/>
            <Button x:Name="btnDong" Content="Đóng" Click="btnDong_Click" IsCancel="True" Style="{StaticResource SecondaryButton}" Margin="8,4,0,4" MinWidth="100"/>
        </WrapPanel>
    </Grid>
</Window>
