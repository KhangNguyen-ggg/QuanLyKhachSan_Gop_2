<Window x:Class="QuanLyKhachSan.Views.Dialogs.TonKhoChiTietWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Chi tiết tồn kho" Width="820" Height="760" MinWidth="620" MinHeight="450" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
    Background="{StaticResource BackgroundBrush}" FontFamily="Segoe UI">
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/QuanLyKhachSan;component/Resources/Styles.xaml"/>
    </ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,12">
            <TextBlock x:Name="txtTieuDe" Text="Chi tiết tồn kho" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource GoldBrush}"/>
            <TextBlock x:Name="txtThongBao" TextWrapping="Wrap" Foreground="{StaticResource DangerBrush}" Margin="0,6,0,0" AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,12,0">
                <TextBlock Text="Mã vật tư" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
                <TextBox x:Name="txtMaVatTu" Style="{StaticResource DarkTextBox}" Text="{Binding MaVatTu, Mode=OneWay}" IsReadOnly="True" MinHeight="36" />
                <TextBlock Text="Vật tư" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
                <TextBox x:Name="txtVatTu" Style="{StaticResource DarkTextBox}" Text="{Binding VatTu, Mode=OneWay}" IsReadOnly="True" MinHeight="36" />
                <TextBlock Text="Nhóm" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
                <TextBox x:Name="txtNhom" Style="{StaticResource DarkTextBox}" Text="{Binding Nhom, Mode=OneWay}" IsReadOnly="True" MinHeight="36" />
                <TextBlock Text="Kho" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
                <TextBox x:Name="txtKho" Style="{StaticResource DarkTextBox}" Text="{Binding Kho, Mode=OneWay}" IsReadOnly="True" MinHeight="36" />
                <TextBlock Text="Đơn vị" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
                <TextBox x:Name="txtDonVi" Style="{StaticResource DarkTextBox}" Text="{Binding DonVi, Mode=OneWay}" IsReadOnly="True" MinHeight="36" />
                <TextBlock Text="Tồn" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
                <TextBox x:Name="txtTon" Style="{StaticResource DarkTextBox}" Text="{Binding Ton, Mode=OneWay}" IsReadOnly="True" MinHeight="36" />
                <TextBlock Text="Tối thiểu" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
                <TextBox x:Name="txtToiThieu" Style="{StaticResource DarkTextBox}" Text="{Binding ToiThieu, Mode=OneWay}" IsReadOnly="True" MinHeight="36" />
                <TextBlock Text="Cảnh báo" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
                <TextBox x:Name="txtCanhBao" Style="{StaticResource DarkTextBox}" Text="{Binding CanhBao, Mode=OneWay}" IsReadOnly="True" MinHeight="36" />
            <TextBlock Text="Nhật ký biến động" Foreground="{StaticResource GoldBrush}" FontSize="18" Margin="0,16,0,0"/>
                <DataGrid x:Name="dgvNhatKy" Style="{StaticResource DarkDataGrid}" CellStyle="{StaticResource DarkDataGridCell}" RowStyle="{StaticResource DarkDataGridRow}" ColumnHeaderStyle="{StaticResource DarkColumnHeader}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MinHeight="180" MaxHeight="340" Margin="0,14,0,0">
                <DataGrid.Columns>
                <DataGridTextColumn Header="Thời gian" Binding="{Binding ThoiGian, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="*" MinWidth="110"/>
                <DataGridTextColumn Header="Biến động" Binding="{Binding BienDong}" Width="*" MinWidth="110"/>
                <DataGridTextColumn Header="Tồn trước" Binding="{Binding TonTruoc}" Width="*" MinWidth="110"/>
                <DataGridTextColumn Header="Tồn sau" Binding="{Binding TonSau}" Width="*" MinWidth="110"/>
                <DataGridTextColumn Header="Chứng từ" Binding="{Binding LoaiChungTu, Converter={StaticResource StatusTextConverter}}" Width="*" MinWidth="110"/>
                <DataGridTextColumn Header="Mã phiếu" Binding="{Binding MaChungTu}" Width="*" MinWidth="110"/>
                <DataGridTextColumn Header="Ghi chú" Binding="{Binding GhiChu}" Width="*" MinWidth="110"/>
                </DataGrid.Columns></DataGrid>
        </StackPanel></ScrollViewer>
        <WrapPanel Grid.Row="2" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="btnTonKhoChuyenKho" Content="Chuyển kho" Click="btnChuyen_Click" Style="{StaticResource SecondaryButton}" Margin="8,4,0,4"/>
            <Button x:Name="btnTonKhoNhapKho" Content="Nhập kho" Click="btnNhap_Click" Style="{StaticResource PrimaryButton}" Margin="8,4,0,4" MinWidth="100"/>
            <Button x:Name="btnTonKhoXuatKho" Content="Xuất kho" Click="btnXuat_Click" Style="{StaticResource SecondaryButton}" Margin="8,4,0,4" MinWidth="100"/>
            <Button x:Name="btnTonKhoDieuChinhTon" Content="Kiểm kê / điều chỉnh" Click="btnKiemKe_Click" Style="{StaticResource SecondaryButton}" Margin="8,4,0,4" MinWidth="100"/>
            <Button x:Name="btnDong" Content="Đóng" Click="btnDong_Click" IsCancel="True" Style="{StaticResource SecondaryButton}" Margin="8,4,0,4" MinWidth="100"/>
        </WrapPanel>
    </Grid>
</Window>
