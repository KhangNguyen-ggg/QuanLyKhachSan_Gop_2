<Window x:Class="QuanLyKhachSan.Views.Dialogs.ChiTietPhieuKhoForm"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Vật tư trong phiếu" Width="820" Height="760" MinWidth="620" MinHeight="450" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
    Background="{StaticResource BackgroundBrush}" FontFamily="Segoe UI">
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/QuanLyKhachSan;component/Resources/Styles.xaml"/>
    </ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,12">
            <TextBlock x:Name="txtTieuDe" Text="Vật tư trong phiếu" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource GoldBrush}"/>
            <TextBlock x:Name="txtThongBao" TextWrapping="Wrap" Foreground="{StaticResource DangerBrush}" Margin="0,6,0,0" AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,12,0">
                <TextBlock Text="Phiếu" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
                <TextBox x:Name="txtPhieu" Style="{StaticResource DarkTextBox}" Text="{Binding MaPhieu, Mode=OneWay}" IsReadOnly="True" MinHeight="36" />
                <TextBlock Text="Vật tư" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
                <ComboBox x:Name="cboVatTu" Style="{StaticResource DarkComboBox}" MinHeight="36" />
                <TextBlock Text="Số lượng" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
                <TextBox x:Name="txtSoLuong" Style="{StaticResource DarkTextBox}" Text="{Binding SoLuong, Mode=OneWay}" MinHeight="36" />
<StackPanel x:Name="pnlGia">
                <TextBlock Text="Đơn giá (tùy chọn)" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
                <TextBox x:Name="txtDonGiaD" Style="{StaticResource DarkTextBox}" Text="{Binding DonGia, Mode=OneWay}" MinHeight="36" />
                <TextBlock Text="Ghi chú" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
                <TextBox x:Name="txtGhiChu" Style="{StaticResource DarkTextBox}" Text="{Binding GhiChu, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinHeight="36" />
</StackPanel>
        </StackPanel></ScrollViewer>
        <WrapPanel Grid.Row="2" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="btnLuu" Content="Lưu" Click="btnLuu_Click" Style="{StaticResource PrimaryButton}" Margin="8,4,0,4" MinWidth="100"/>
            <Button x:Name="btnDong" Content="Đóng" Click="btnDong_Click" IsCancel="True" Style="{StaticResource SecondaryButton}" Margin="8,4,0,4" MinWidth="100"/>
        </WrapPanel>
    </Grid>
</Window>
