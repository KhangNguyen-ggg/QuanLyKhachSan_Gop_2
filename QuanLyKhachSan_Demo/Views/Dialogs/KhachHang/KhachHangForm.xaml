<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="QuanLyKhachSan.Views.Dialogs.KhachHangForm" Title="Thông tin khách hàng" Width="720" Height="740" MinWidth="540" MinHeight="420" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource BackgroundBrush}" FontFamily="Segoe UI">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/QuanLyKhachSan;component/Resources/Styles.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock Text="Thông tin khách hàng" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource GoldBrush}" Margin="0,0,0,14" />
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="0,0,12,0">
        <TextBlock Text="Họ tên" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5" />
        <TextBox x:Name="txtHoTen" Text="{Binding HoTen, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}" MinHeight="36" />
        <TextBlock Text="Loại giấy tờ" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5" />
        <ComboBox x:Name="cboLoaiGiayTo" Style="{StaticResource DarkComboBox}" MinHeight="36" IsEditable="False" SelectionChanged="LoaiGiayTo_Changed" SelectedItem="{Binding LoaiGiayTo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Text="Số giấy tờ" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5" />
        <TextBox x:Name="txtSoGiayTo" Style="{StaticResource DarkTextBox}" MinHeight="36" Text="{Binding SoGiayTo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock x:Name="txtHuongDanGiayTo" Text="Chọn loại giấy tờ rồi nhập mã số ghi trên giấy tờ." TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,5,0,0" />
        <TextBlock Text="Điện thoại" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5" />
        <TextBox x:Name="txtDienThoai" Text="{Binding SoDienThoai, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}" MinHeight="36" />
        <TextBlock Text="Email" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5" />
        <TextBox x:Name="txtEmail" Text="{Binding Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}" MinHeight="36" />
        <TextBlock Text="Quốc tịch" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5" />
        <TextBox x:Name="txtQuocTich" Text="{Binding QuocTich, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}" MinHeight="36" />
        <TextBlock Text="Địa chỉ" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5" />
        <TextBox x:Name="txtDiaChi" Text="{Binding DiaChi, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}" MinHeight="36" />
        <TextBlock Text="Ngày sinh" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5" />
        <DatePicker x:Name="dtpNgaySinh" MinHeight="36" Foreground="#14243B" Background="White" SelectedDate="{Binding NgaySinh, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Text="Giới tính" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5" />
        <ComboBox x:Name="cboGioiTinh" Style="{StaticResource DarkComboBox}" MinHeight="36" SelectedValuePath="Tag" SelectedValue="{Binding GioiTinh, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
          <ComboBoxItem Content="Nam" Tag="M" />
          <ComboBoxItem Content="Nữ" Tag="F" />
          <ComboBoxItem Content="Khác" Tag="O" />
        </ComboBox>
        <CheckBox x:Name="chkHoatDong" Content="Đang hoạt động" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,14,0,0" IsChecked="{Binding TrangThai, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Text="Ghi chú" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5" />
        <TextBox x:Name="txtGhiChu" Text="{Binding GhiChu, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}" MinHeight="36" />
      </StackPanel>
    </ScrollViewer>
    <WrapPanel Grid.Row="2" HorizontalAlignment="Right" Margin="0,18,0,0">
      <Button Content="Đóng" Click="btnDong_Click" IsCancel="True" Style="{StaticResource SecondaryButton}" MinWidth="100" x:Name="btnDong" />
      <Button x:Name="btnLuu" Content="Lưu" Click="btnLuu_Click" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" MinWidth="130" />
    </WrapPanel>
  </Grid>
</Window>
