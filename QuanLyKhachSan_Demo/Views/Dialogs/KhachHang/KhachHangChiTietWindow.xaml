<Window x:Class="QuanLyKhachSan.Views.Dialogs.KhachHangChiTietWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Chi tiết — Khách hàng" Width="720" Height="740" MinWidth="540" MinHeight="420" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource BackgroundBrush}" FontFamily="Segoe UI">
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/QuanLyKhachSan;component/Resources/Styles.xaml" /></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
 <TextBlock Text="Chi tiết — Khách hàng" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource GoldBrush}" Margin="0,0,0,14" />
 <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,12,0"><TextBlock Text="Mã khách" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5" /><TextBlock Text="{Binding MaKhachHang}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" /><TextBlock Text="Họ tên" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5" /><TextBlock Text="{Binding HoTen}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" /><TextBlock Text="Ngày sinh" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5" /><TextBlock Text="{Binding NgaySinh, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" /><TextBlock Text="Giới tính (M: Nam, F: Nữ, O: Khác)" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5" /><TextBlock Text="{Binding GioiTinh}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" /><TextBlock Text="Loại giấy tờ" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5" /><TextBlock Text="{Binding LoaiGiayTo}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" /><TextBlock Text="Số giấy tờ" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5" /><TextBlock Text="{Binding SoGiayTo}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" /><TextBlock Text="Điện thoại" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5" /><TextBlock Text="{Binding SoDienThoai}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" /><TextBlock Text="Email" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5" /><TextBlock Text="{Binding Email}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" /><TextBlock Text="Quốc tịch" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5" /><TextBlock Text="{Binding QuocTich}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" /><TextBlock Text="Địa chỉ" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5" /><TextBlock Text="{Binding DiaChi}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" /><TextBlock Text="Ghi chú" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5" /><TextBlock Text="{Binding GhiChu}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" /><TextBlock Text="Trạng thái" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5"/><TextBlock Text="{Binding TrangThai}" Foreground="{StaticResource TextPrimaryBrush}"/></StackPanel></ScrollViewer>
 <WrapPanel Grid.Row="2" HorizontalAlignment="Right" Margin="0,18,0,0">
<Button x:Name="btnKhachHangThemMoi" Content="Thêm mới" Click="btnKhachHangThemMoi_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8" /><Button x:Name="btnKhachHangSuaThongTin" Content="Sửa" Click="btnKhachHangSuaThongTin_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" /><Button x:Name="btnKhachHangXoa" Content="Xóa" Click="btnKhachHangXoa_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" /><Button Content="Đóng" Click="btnDong_Click" IsCancel="True" Style="{StaticResource SecondaryButton}" MinWidth="100" x:Name="btnDong" /></WrapPanel></Grid>
</Window>