<Window x:Class="QuanLyKhachSan.Views.Dialogs.TienNghiTheoLoaiForm"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Thông tin tiện nghi theo loại" Width="700" Height="700" MinWidth="540" MinHeight="400"
    WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
    Background="{StaticResource BackgroundBrush}" FontFamily="Segoe UI">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/QuanLyKhachSan;component/Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <!-- Bố cục cố định: tiêu đề, vùng nhập cuộn, hàng nút phía dưới. -->
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock x:Name="txtTieuDe" Text="Thông tin tiện nghi theo loại" FontSize="22" FontWeight="SemiBold"
                       Foreground="{StaticResource GoldBrush}" TextWrapping="Wrap"/>
            </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,12,0">
                <TextBlock Text="Loại phòng" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5"/>
                <ComboBox x:Name="cboLoaiPhong" Style="{StaticResource DarkComboBox}" SelectedIndex="0" MinHeight="36">
                    <ComboBoxItem Style="{StaticResource ReadableComboBoxItem}" Content="Deluxe"/>
                    <ComboBoxItem Style="{StaticResource ReadableComboBoxItem}" Content="Standard"/>
                    <ComboBoxItem Style="{StaticResource ReadableComboBoxItem}" Content="Suite"/>
                </ComboBox>
                <TextBlock Text="Tiện nghi" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5"/>
                <ComboBox x:Name="cboTienNghi" Style="{StaticResource DarkComboBox}" SelectedIndex="0" MinHeight="36">
                    <ComboBoxItem Style="{StaticResource ReadableComboBoxItem}" Content="Bồn tắm"/>
                    <ComboBoxItem Style="{StaticResource ReadableComboBoxItem}" Content="Ban công"/>
                    <ComboBoxItem Style="{StaticResource ReadableComboBoxItem}" Content="Két an toàn"/>
                </ComboBox>
                <TextBlock Text="Số lượng" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5"/>
                <TextBox x:Name="txtSoLuong" Text="1" Style="{StaticResource DarkTextBox}" MinHeight="38"/>
                <TextBlock Text="Ghi chú" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5"/>
                <TextBox x:Name="txtGhiChu" Text="" Style="{StaticResource DarkTextBox}" MinHeight="90" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="btnDong" Content="Đóng" Style="{StaticResource SecondaryButton}"
                    Click="btnDong_Click" IsCancel="True" MinWidth="100"/>
            <Button x:Name="btnLuu" Content="Xác nhận" Style="{StaticResource PrimaryButton}"
                    Click="btnLuu_Click" MinWidth="140" Margin="8,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
