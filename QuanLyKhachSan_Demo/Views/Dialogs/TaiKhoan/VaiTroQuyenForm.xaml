<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:sys="clr-namespace:System;assembly=System.Runtime" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" x:Class="QuanLyKhachSan.Views.Dialogs.VaiTroQuyenForm" mc:Ignorable="d" Title="Thông tin vai trò &amp; quyền" Width="700" Height="700" MinWidth="540" MinHeight="400" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource BackgroundBrush}" FontFamily="Segoe UI">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/QuanLyKhachSan;component/Resources/Styles.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <!-- Bố cục cố định: tiêu đề, vùng nhập cuộn, hàng nút phía dưới. -->
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Margin="0,0,0,14">
      <TextBlock x:Name="txtTieuDe" Text="Thông tin vai trò &amp; quyền" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource GoldBrush}" TextWrapping="Wrap"/>
    </StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="0,0,12,0">
        <TextBlock Text="Nhấn Xác nhận để lưu vai trò. Đóng form sẽ bỏ thay đổi chưa lưu." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
        <TextBlock Text="Tên vai trò" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5"/>
        <TextBox x:Name="txtTenVaiTro" Style="{StaticResource DarkTextBox}" MinHeight="38" Text="{Binding TenVaiTro, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
        <TextBlock Text="Ghi chú" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5"/>
        <TextBox x:Name="txtGhiChu" Style="{StaticResource DarkTextBox}" MinHeight="90" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Text="{Binding MoTa, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
        <TextBlock Text="Trạng thái" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5"/>
        <ComboBox x:Name="cboTrangThai" Style="{StaticResource DarkComboBox}" MinHeight="36" SelectedValuePath="Tag" SelectedValue="{Binding TrangThai, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}">
          <ComboBoxItem Content="Hoạt động">
            <ComboBoxItem.Tag>
              <sys:Boolean>True</sys:Boolean>
            </ComboBoxItem.Tag>
          </ComboBoxItem>
          <ComboBoxItem Content="Ngừng hoạt động">
            <ComboBoxItem.Tag>
              <sys:Boolean>False</sys:Boolean>
            </ComboBoxItem.Tag>
          </ComboBoxItem>
        </ComboBox>
      </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
      <Button x:Name="btnDong" Content="Đóng" Style="{StaticResource SecondaryButton}" Click="btnDong_Click" IsCancel="True" MinWidth="100"/>
      <Button x:Name="btnLuu" Content="Xác nhận" Style="{StaticResource PrimaryButton}" Click="btnLuu_Click" MinWidth="140" Margin="8,0,0,0"/>
    </StackPanel>
  </Grid>
</Window>
