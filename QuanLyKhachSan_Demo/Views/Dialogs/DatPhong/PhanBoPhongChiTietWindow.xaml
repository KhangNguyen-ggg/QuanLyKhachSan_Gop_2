<Window x:Class="QuanLyKhachSan.Views.Dialogs.PhanBoPhongChiTietWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Chi tiết — Phân bổ phòng" Width="720" Height="740" MinWidth="540" MinHeight="420" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource BackgroundBrush}" FontFamily="Segoe UI">
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/QuanLyKhachSan;component/Resources/Styles.xaml" /></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
 <TextBlock Text="Chi tiết — Phân bổ phòng" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource GoldBrush}" Margin="0,0,0,14" />
 <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,12,0"><TextBlock Text="Mã phân bổ" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5" /><TextBlock Text="{Binding MaXepPhong}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" /><TextBlock Text="Mã đơn" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5" /><TextBlock Text="{Binding MaDatPhong}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" /><TextBlock Text="Phòng" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5" /><TextBlock Text="{Binding SoPhong}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" /><TextBlock Text="Loại phòng" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5" /><TextBlock Text="{Binding TenLoaiPhong}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" /><TextBlock Text="Người lớn (chi tiết đặt)" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5" /><TextBlock Text="{Binding NguoiLon}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" /><TextBlock Text="Trẻ em (chi tiết đặt)" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5" /><TextBlock Text="{Binding TreEm}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" /><TextBlock Text="Đơn giá / đêm" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5" /><TextBlock Text="{Binding DonGiaDuKien, StringFormat={}{0:N0}}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" /><TextBlock Text="Trạng thái" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5" /><TextBlock Text="{Binding TrangThai, Converter={StaticResource StatusTextConverter}}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" /></StackPanel></ScrollViewer>
 <WrapPanel Grid.Row="2" HorizontalAlignment="Right" Margin="0,18,0,0">
<Button x:Name="btnPhanBoPhongThemPhong" Content="Thêm phòng" Click="btnPhanBoPhongThemPhong_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8" /><Button x:Name="btnPhanBoPhongDoiPhong" Content="Đổi phòng" Click="btnPhanBoPhongDoiPhong_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" /><Button x:Name="btnPhanBoPhongBoPhanBo" Content="Bỏ phân bổ" Click="btnPhanBoPhongBoPhanBo_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" /><Button Content="Đóng" Click="btnDong_Click" IsCancel="True" Style="{StaticResource SecondaryButton}" MinWidth="100" x:Name="btnDong" /></WrapPanel></Grid>
</Window>