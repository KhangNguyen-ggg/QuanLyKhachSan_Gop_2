<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="QuanLyKhachSan.Views.Dialogs.PhanBoPhongForm" Title="Phân bổ phòng" Width="720" Height="740" MinWidth="540" MinHeight="420" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource BackgroundBrush}" FontFamily="Segoe UI">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/QuanLyKhachSan;component/Resources/Styles.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock Text="Phân bổ phòng" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource GoldBrush}" Margin="0,0,0,14" />
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="0,0,12,0">
        <TextBlock Text="Đơn đặt phòng" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5" />
        <ComboBox x:Name="cboDatPhong" Style="{StaticResource DarkComboBox}" MinHeight="36" DisplayMemberPath="MaDatPhong" SelectedValuePath="MaDatPhong" SelectionChanged="Don_Changed" />
        <TextBlock Text="Chi tiết đặt phòng (mã)" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5" />
        <ComboBox x:Name="cboChiTiet" Style="{StaticResource DarkComboBox}" MinHeight="36" DisplayMemberPath="MaChiTietDatPhong" SelectedValuePath="MaChiTietDatPhong" SelectionChanged="ChiTiet_Changed" />
        <TextBlock Text="Loại phòng, ngày ở và số lượng được hiện theo chi tiết đã chọn." Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5" />
        <TextBox x:Name="txtChiTiet" Style="{StaticResource DarkTextBox}" MinHeight="36" IsReadOnly="True">
          <TextBox.Text>
            <MultiBinding Mode="OneWay" StringFormat="{}{0} · {1} phòng · {2:dd/MM/yyyy} – {3:dd/MM/yyyy}">
              <Binding Path="TenLoaiPhong" />
              <Binding Path="SoLuongPhong" />
              <Binding Path="NgayNhanDuKien" />
              <Binding Path="NgayTraDuKien" />
            </MultiBinding>
          </TextBox.Text>
        </TextBox>
        <TextBlock Text="Phòng cùng loại" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5" />
        <ComboBox x:Name="cboPhong" Style="{StaticResource DarkComboBox}" MinHeight="36" DisplayMemberPath="SoPhong" SelectedValuePath="MaPhong" />
        <TextBlock Text="Ghi chú" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5" />
        <TextBox x:Name="txtGhiChu" Text="{Binding GhiChu, Mode=OneWay}" Style="{StaticResource DarkTextBox}" MinHeight="36" />
      <TextBlock Text="Người lớn" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5"/><TextBox Text="{Binding SelectedItem.NguoiLon, ElementName=cboChiTiet, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource DarkTextBox}" MinHeight="36"/><TextBlock Text="Trẻ em" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5"/><TextBox Text="{Binding SelectedItem.TreEm, ElementName=cboChiTiet, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource DarkTextBox}" MinHeight="36"/><TextBlock Text="Giá áp dụng / đêm (đ)" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5"/><TextBox Text="{Binding SelectedItem.DonGiaDuKien, ElementName=cboChiTiet, Mode=OneWay, StringFormat=N2}" IsReadOnly="True" Style="{StaticResource DarkTextBox}" MinHeight="36"/></StackPanel>
    </ScrollViewer>
    <WrapPanel Grid.Row="2" HorizontalAlignment="Right" Margin="0,18,0,0">
      <Button Content="Đóng" Click="btnDong_Click" IsCancel="True" Style="{StaticResource SecondaryButton}" MinWidth="100" x:Name="btnDong" />
      <Button x:Name="btnLuu" Content="Lưu" Click="btnLuu_Click" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" MinWidth="130" />
    </WrapPanel>
  </Grid>
</Window>
