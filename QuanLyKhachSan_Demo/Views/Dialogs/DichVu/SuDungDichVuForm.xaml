<Window x:Class="QuanLyKhachSan.Views.Dialogs.SuDungDichVuForm"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Thông tin khách sử dụng dịch vụ" Width="700" Height="700" MinWidth="540" MinHeight="400"
    WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
    Background="{StaticResource BackgroundBrush}" FontFamily="Segoe UI">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/QuanLyKhachSan;component/Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <!-- Bố cục cố định: tiêu đề, vùng nhập cuộn, hàng nút phía dưới. -->
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock x:Name="txtTieuDe" Text="Thông tin khách sử dụng dịch vụ" FontSize="22" FontWeight="SemiBold"
                       Foreground="{StaticResource GoldBrush}" TextWrapping="Wrap"/>
            </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,12,0">
                <TextBlock Text="Đặt phòng" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5"/>
                <ComboBox x:Name="cboDatPhong" Style="{StaticResource DarkComboBox}" SelectedIndex="0" MinHeight="36">
                    <ComboBoxItem Style="{StaticResource ReadableComboBoxItem}" Content="DP001 — Nguyễn Minh Anh"/>
                    <ComboBoxItem Style="{StaticResource ReadableComboBoxItem}" Content="DP002 — Trần Quốc Bảo"/>
                    <ComboBoxItem Style="{StaticResource ReadableComboBoxItem}" Content="DP003 — Lê Thảo Vy"/>
                </ComboBox>
                <TextBlock Text="Khách hàng" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5"/>
                <ComboBox x:Name="cboKhachHang" Style="{StaticResource DarkComboBox}" SelectedIndex="0" MinHeight="36">
                    <ComboBoxItem Style="{StaticResource ReadableComboBoxItem}" Content="Nguyễn Minh Anh"/>
                    <ComboBoxItem Style="{StaticResource ReadableComboBoxItem}" Content="Trần Quốc Bảo"/>
                    <ComboBoxItem Style="{StaticResource ReadableComboBoxItem}" Content="Lê Thảo Vy"/>
                    <ComboBoxItem Style="{StaticResource ReadableComboBoxItem}" Content="Phạm Gia Hân"/>
                </ComboBox>
                <TextBlock Text="Dịch vụ / gói" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5"/>
                <ComboBox x:Name="cboDichVuGoi" Style="{StaticResource DarkComboBox}" SelectedIndex="0" MinHeight="36">
                    <ComboBoxItem Style="{StaticResource ReadableComboBoxItem}" Content="Ăn sáng buffet"/>
                    <ComboBoxItem Style="{StaticResource ReadableComboBoxItem}" Content="Hồ bơi"/>
                    <ComboBoxItem Style="{StaticResource ReadableComboBoxItem}" Content="Giặt ủi"/>
                    <ComboBoxItem Style="{StaticResource ReadableComboBoxItem}" Content="Gói nghỉ dưỡng"/>
                </ComboBox>
                <TextBlock Text="Số lượng" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5"/>
                <TextBox x:Name="txtSoLuong" Text="2" Style="{StaticResource DarkTextBox}" MinHeight="38"/>
                <TextBlock Text="Đơn giá (đ)" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5"/>
                <TextBox x:Name="txtDonGiaD" Text="150000" Style="{StaticResource DarkTextBox}" MinHeight="38"/>
                <TextBlock Text="Thời điểm sử dụng" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5"/>
                <TextBox x:Name="txtThoiDiemSuDung" Text="27/09/2026 07:30" Style="{StaticResource DarkTextBox}" MinHeight="38"/>
                <TextBlock Text="Nhân viên" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5"/>
                <ComboBox x:Name="cboNhanVien" Style="{StaticResource DarkComboBox}" SelectedIndex="0" MinHeight="36">
                    <ComboBoxItem Style="{StaticResource ReadableComboBoxItem}" Content="Nguyễn Văn An — NV001"/>
                    <ComboBoxItem Style="{StaticResource ReadableComboBoxItem}" Content="Trần Ngọc Bảo — NV003"/>
                    <ComboBoxItem Style="{StaticResource ReadableComboBoxItem}" Content="Lê Mỹ Duyên — NV005"/>
                </ComboBox>
                <TextBlock Text="Kho" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5"/>
                <ComboBox x:Name="cboKho" Style="{StaticResource DarkComboBox}" SelectedIndex="0" MinHeight="36">
                    <ComboBoxItem Style="{StaticResource ReadableComboBoxItem}" Content="Kho tổng"/>
                    <ComboBoxItem Style="{StaticResource ReadableComboBoxItem}" Content="Kho buồng phòng"/>
                    <ComboBoxItem Style="{StaticResource ReadableComboBoxItem}" Content="Kho nhà hàng"/>
                </ComboBox>
                <TextBlock Text="Ghi chú" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5"/>
                <TextBox x:Name="txtGhiChu" Text="" Style="{StaticResource DarkTextBox}" MinHeight="90" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="btnDong" Content="Đóng" Style="{StaticResource SecondaryButton}"
                    Click="btnDong_Click" IsCancel="True" MinWidth="100"/>
            <Button x:Name="btnLuu" Content="Xác nhận" Style="{StaticResource PrimaryButton}"
                    Click="btnLuu_Click" MinWidth="140" Margin="8,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
