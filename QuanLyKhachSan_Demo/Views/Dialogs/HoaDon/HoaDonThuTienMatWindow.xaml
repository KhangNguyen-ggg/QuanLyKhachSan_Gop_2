<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="QuanLyKhachSan.Views.Dialogs.HoaDonThuTienMatWindow" Title="Thu tiền" Width="720" Height="740" MinWidth="540" MinHeight="420" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource BackgroundBrush}" FontFamily="Segoe UI">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/QuanLyKhachSan;component/Resources/Styles.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock Text="Thu tiền" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource GoldBrush}" Margin="0,0,0,14" />
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="0,0,12,0">
        <TextBlock Text="Hóa đơn" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5" />
        <TextBox x:Name="txtHoaDon" Text="{Binding MaHoaDon, Mode=OneWay}" Style="{StaticResource DarkTextBox}" MinHeight="36" IsReadOnly="True" />
        <TextBlock Text="Tổng phải thu phòng và dịch vụ sau ưu đãi (đ)" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5" />
        <TextBox x:Name="txtPhaiThu" Text="{Binding PhaiThu, Mode=OneWay, StringFormat=N2}" Style="{StaticResource DarkTextBox}" MinHeight="36" IsReadOnly="True" />
        <TextBlock Text="Đã thu (đ)" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5" />
        <TextBox x:Name="txtDaThu" Text="{Binding DaThu, Mode=OneWay, StringFormat=N2}" Style="{StaticResource DarkTextBox}" MinHeight="36" IsReadOnly="True" />
        <TextBlock Text="Còn thiếu (đ)" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5" />
        <TextBox x:Name="txtConThieu" Text="{Binding ConThieu, Mode=OneWay, StringFormat=N2}" Style="{StaticResource DarkTextBox}" MinHeight="36" IsReadOnly="True" />
        <TextBlock Text="Số tiền thu lần này (ví dụ 500000)" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5" />
        <TextBox x:Name="txtSoTien" Text="{Binding SoTien, Mode=OneWay}" Style="{StaticResource DarkTextBox}" MinHeight="36" />
        <TextBlock Text="Nhân viên thu" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5" />
        <ComboBox x:Name="cboNhanVien" Style="{StaticResource DarkComboBox}" MinHeight="36" DisplayMemberPath="HoTen" SelectedValuePath="MaNhanVien" />
        <TextBlock Text="Ghi chú" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5" />
        <TextBox x:Name="txtGhiChu" Text="" Style="{StaticResource DarkTextBox}" MinHeight="36" />
      <TextBlock Text="Phương thức" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5"/><TextBox Text="Tiền mặt" IsReadOnly="True" Style="{StaticResource DarkTextBox}" MinHeight="36"/></StackPanel>
    </ScrollViewer>
    <WrapPanel Grid.Row="2" HorizontalAlignment="Right" Margin="0,18,0,0">
      <Button Content="Đóng" Click="btnDong_Click" IsCancel="True" Style="{StaticResource SecondaryButton}" MinWidth="100" x:Name="btnDong" />
      <Button x:Name="btnLuu" Content="Lưu" Click="btnLuu_Click" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" MinWidth="130" IsEnabled="{Binding DuocThu, Mode=OneWay}" />
    </WrapPanel>
  </Grid>
</Window>
