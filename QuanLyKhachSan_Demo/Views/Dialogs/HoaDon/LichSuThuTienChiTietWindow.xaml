<Window x:Class="QuanLyKhachSan.Views.Dialogs.LichSuThuTienChiTietWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Chi tiết — Lịch sử thu tiền" Width="720" Height="740" MinWidth="540" MinHeight="420" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource BackgroundBrush}" FontFamily="Segoe UI">
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/QuanLyKhachSan;component/Resources/Styles.xaml" /></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
 <TextBlock Text="Chi tiết — Lịch sử thu tiền" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource GoldBrush}" Margin="0,0,0,14" />
 <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,12,0"><TextBlock Text="Mã phiếu thu" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5" /><TextBlock Text="{Binding MaThanhToan}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" /><TextBlock Text="Mã hóa đơn" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5" /><TextBlock Text="{Binding MaHoaDon}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" /><TextBlock Text="Thời gian" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5" /><TextBlock Text="{Binding ThoiGianThanhToan, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" /><TextBlock Text="Số tiền" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5" /><TextBlock Text="{Binding SoTien, StringFormat={}{0:N0}}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" /><TextBlock Text="Nhân viên thu" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5" /><TextBlock Text="{Binding HoTen}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" /><TextBlock Text="Trạng thái" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5" /><TextBlock Text="{Binding TrangThai, Converter={StaticResource StatusTextConverter}}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" /><TextBlock Text="Ghi chú" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5" /><TextBlock Text="{Binding GhiChu}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" /><TextBlock Text="Phương thức" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5"/><TextBlock Text="Tiền mặt" Foreground="{StaticResource TextPrimaryBrush}"/></StackPanel></ScrollViewer>
 <WrapPanel Grid.Row="2" HorizontalAlignment="Right" Margin="0,18,0,0"><Button Content="Đóng" Click="btnDong_Click" IsCancel="True" Style="{StaticResource SecondaryButton}" MinWidth="100" x:Name="btnDong" /></WrapPanel></Grid>
</Window>