<Window x:Class="QuanLyKhachSan.Views.Dialogs.NhanVienForm"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Thông tin nhân viên" Width="700" Height="700" MinWidth="540" MinHeight="400"
    WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
    Background="{StaticResource BackgroundBrush}" FontFamily="Segoe UI">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/QuanLyKhachSan;component/Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <!-- Bố cục cố định: tiêu đề, vùng nhập cuộn, hàng nút phía dưới. -->
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock x:Name="txtTieuDe" Text="Thông tin nhân viên" FontSize="22" FontWeight="SemiBold"
                       Foreground="{StaticResource GoldBrush}" TextWrapping="Wrap"/>
            </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,12,0">
                <TextBlock Text="Mã nhân viên" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5"/>
                <TextBox x:Name="txtMaNhanVien" Text="NV006" Style="{StaticResource DarkTextBox}" MinHeight="38"/>
                <TextBlock Text="Họ tên" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5"/>
                <TextBox x:Name="txtHoTen" Text="Nguyễn Văn An" Style="{StaticResource DarkTextBox}" MinHeight="38"/>
                <TextBlock Text="Giới tính" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5"/>
                <ComboBox x:Name="cboGioiTinh" Style="{StaticResource DarkComboBox}" SelectedIndex="0" MinHeight="36">
                    <ComboBoxItem Style="{StaticResource ReadableComboBoxItem}" Content="Nam"/>
                    <ComboBoxItem Style="{StaticResource ReadableComboBoxItem}" Content="Nữ"/>
                    <ComboBoxItem Style="{StaticResource ReadableComboBoxItem}" Content="Khác"/>
                </ComboBox>
                <TextBlock Text="Ngày sinh" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5"/>
                <DatePicker x:Name="dtpNgaySinh" SelectedDate="1995-05-10" Height="36" Foreground="Black" Background="White"/>
                <TextBlock Text="Phòng ban" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5"/>
                <ComboBox x:Name="cboPhongBan" Style="{StaticResource DarkComboBox}" SelectedIndex="0" MinHeight="36">
                    <ComboBoxItem Style="{StaticResource ReadableComboBoxItem}" Content="Ban quản lý"/>
                    <ComboBoxItem Style="{StaticResource ReadableComboBoxItem}" Content="Lễ tân"/>
                    <ComboBoxItem Style="{StaticResource ReadableComboBoxItem}" Content="Kho"/>
                    <ComboBoxItem Style="{StaticResource ReadableComboBoxItem}" Content="Buồng phòng"/>
                    <ComboBoxItem Style="{StaticResource ReadableComboBoxItem}" Content="Nhân sự"/>
                </ComboBox>
                <TextBlock Text="Chức vụ" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5"/>
                <ComboBox x:Name="cboChucVu" Style="{StaticResource DarkComboBox}" SelectedIndex="0" MinHeight="36">
                    <ComboBoxItem Style="{StaticResource ReadableComboBoxItem}" Content="Giám đốc"/>
                    <ComboBoxItem Style="{StaticResource ReadableComboBoxItem}" Content="Nhân viên lễ tân"/>
                    <ComboBoxItem Style="{StaticResource ReadableComboBoxItem}" Content="Thủ kho"/>
                    <ComboBoxItem Style="{StaticResource ReadableComboBoxItem}" Content="Nhân viên buồng phòng"/>
                </ComboBox>
                <TextBlock Text="Điện thoại" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5"/>
                <TextBox x:Name="txtDienThoai" Text="0901111111" Style="{StaticResource DarkTextBox}" MinHeight="38"/>
                <TextBlock Text="Email" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5"/>
                <TextBox x:Name="txtEmail" Text="nhanvien@example.com" Style="{StaticResource DarkTextBox}" MinHeight="38"/>
                <TextBlock Text="Địa chỉ" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5"/>
                <TextBox x:Name="txtDiaChi" Text="TP. Hồ Chí Minh" Style="{StaticResource DarkTextBox}" MinHeight="38"/>
                <TextBlock Text="Ngày vào làm" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5"/>
                <DatePicker x:Name="dtpNgayVaoLam" SelectedDate="2026-01-01" Height="36" Foreground="Black" Background="White"/>
                <TextBlock Text="Lương cơ bản (đ)" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5"/>
                <TextBox x:Name="txtLuongCoBanD" Text="9000000" Style="{StaticResource DarkTextBox}" MinHeight="38"/>
                <TextBlock Text="Trạng thái" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5"/>
                <ComboBox x:Name="cboTrangThai" Style="{StaticResource DarkComboBox}" SelectedIndex="0" MinHeight="36">
                    <ComboBoxItem Style="{StaticResource ReadableComboBoxItem}" Content="Đang làm"/>
                    <ComboBoxItem Style="{StaticResource ReadableComboBoxItem}" Content="Tạm nghỉ"/>
                    <ComboBoxItem Style="{StaticResource ReadableComboBoxItem}" Content="Đã nghỉ"/>
                </ComboBox>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="btnDong" Content="Đóng" Style="{StaticResource SecondaryButton}"
                    Click="btnDong_Click" IsCancel="True" MinWidth="100"/>
            <Button x:Name="btnLuu" Content="Xác nhận" Style="{StaticResource PrimaryButton}"
                    Click="btnLuu_Click" MinWidth="140" Margin="8,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
