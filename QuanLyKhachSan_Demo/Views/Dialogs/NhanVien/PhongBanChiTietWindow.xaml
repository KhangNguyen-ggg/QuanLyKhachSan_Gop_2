<Window x:Class="QuanLyKhachSan.Views.Dialogs.PhongBanChiTietWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    Title="Chi tiết — Phòng ban" Width="760" Height="700" MinWidth="540" MinHeight="400"
    WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource BackgroundBrush}" FontFamily="Segoe UI">
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/QuanLyKhachSan;component/Resources/Styles.xaml"/>
    </ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="Chi tiết — Phòng ban" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource GoldBrush}" TextWrapping="Wrap"/>
            <TextBlock x:Name="txtThongBao" Text="Nhấn Sửa để chỉnh sửa thông tin của dòng này." Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,12,0">
                <TextBlock Text="Mã" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
                <TextBox x:Name="txtMa" Text="{Binding MaPhongBan, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource DarkTextBox}"/>
                <TextBlock Text="Tên phòng ban" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
                <TextBox x:Name="txtTenPhongBan" Text="{Binding TenPhongBan, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" Style="{StaticResource DarkTextBox}"/>
                <TextBlock Text="Mô tả" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
                <TextBox x:Name="txtMoTa" Text="{Binding MoTa, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" Style="{StaticResource DarkTextBox}"
                         MinHeight="90" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                <TextBlock Text="Trạng thái" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
                <ComboBox x:Name="cboTrangThai" Style="{StaticResource DarkComboBox}" IsEnabled="False"
                          SelectedValuePath="Tag" SelectedValue="{Binding TrangThai, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <ComboBoxItem Style="{StaticResource ReadableComboBoxItem}" Content="Đang hoạt động">
                        <ComboBoxItem.Tag><sys:Boolean>True</sys:Boolean></ComboBoxItem.Tag>
                    </ComboBoxItem>
                    <ComboBoxItem Style="{StaticResource ReadableComboBoxItem}" Content="Ngừng hoạt động">
                        <ComboBoxItem.Tag><sys:Boolean>False</sys:Boolean></ComboBoxItem.Tag>
                    </ComboBoxItem>
                </ComboBox>
        </StackPanel></ScrollViewer>
        <WrapPanel Grid.Row="2" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="btnPhongBanSuaThongTin" Content="Sửa" Click="btnSua_Click" Style="{StaticResource SecondaryButton}" Margin="8,4,0,4" MinWidth="90"/>
            <Button x:Name="btnPhongBanXoa" Content="Xóa" Click="btnXoa_Click"
                    Style="{StaticResource DangerButton}" Margin="8,4,0,4" MinWidth="90"/>
            <Button x:Name="btnLuuSua" Content="Lưu thay đổi" Click="btnLuuSua_Click" Style="{StaticResource PrimaryButton}" Margin="8,4,0,4" Visibility="Collapsed"/>
            <Button x:Name="btnHuySua" Content="Hủy sửa" Click="btnHuySua_Click" Style="{StaticResource SecondaryButton}" Margin="8,4,0,4" Visibility="Collapsed"/>
            <Button x:Name="btnDong" Content="Đóng" Click="btnDong_Click" Style="{StaticResource SecondaryButton}" Margin="8,4,0,4" IsCancel="True" MinWidth="90"/>
        </WrapPanel>
    </Grid>
</Window>
