<Window x:Class="QuanLyKhachSan.Views.Dialogs.NhanVienChiTietWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="clr-namespace:QuanLyKhachSan.Helpers"
    Title="Chi tiết — Nhân viên" Width="760" Height="740" MinWidth="540" MinHeight="400"
    WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource BackgroundBrush}" FontFamily="Segoe UI">
    <Window.Resources><ResourceDictionary>
        <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/QuanLyKhachSan;component/Resources/Styles.xaml"/></ResourceDictionary.MergedDictionaries>
        <helpers:GioConverter x:Key="GioConverter"/>
    </ResourceDictionary></Window.Resources>
    <!-- Bớt: bỏ nút Thêm và khối Sửa/Lưu lặp; nút Sửa dùng lại form nhập có bản nháp. -->
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,14">
            <TextBlock x:Name="txtTieuDe" Text="Chi tiết — Nhân viên" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource GoldBrush}" TextWrapping="Wrap"/>
            <TextBlock x:Name="txtThongBao" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,12,0">
            <TextBlock Text="Mã" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
            <TextBox x:Name="txtMa" Text="{Binding MaNhanVien, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource DarkTextBox}" MinHeight="36"/>
            <TextBlock Text="Họ tên" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
            <TextBox x:Name="txtHoTen" Text="{Binding HoTen, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource DarkTextBox}" MinHeight="36"/>
            <TextBlock Text="Giới tính" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
            <TextBox x:Name="txtGioiTinh" Text="{Binding GioiTinh, Mode=OneWay, Converter={StaticResource StatusTextConverter}}" IsReadOnly="True" Style="{StaticResource DarkTextBox}" MinHeight="36"/>
            <TextBlock Text="Ngày sinh" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
            <TextBox x:Name="dtpNgaySinh" Text="{Binding NgaySinh, Mode=OneWay, StringFormat=dd/MM/yyyy}" IsReadOnly="True" Style="{StaticResource DarkTextBox}" MinHeight="36"/>
            <TextBlock Text="Phòng ban" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
            <TextBox x:Name="txtPhongBan" Text="{Binding PhongBan, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource DarkTextBox}" MinHeight="36"/>
            <TextBlock Text="Chức vụ" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
            <TextBox x:Name="txtChucVu" Text="{Binding ChucVu, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource DarkTextBox}" MinHeight="36"/>
            <TextBlock Text="Điện thoại" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
            <TextBox x:Name="txtDienThoai" Text="{Binding SoDienThoai, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource DarkTextBox}" MinHeight="36"/>
            <TextBlock Text="Email" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
            <TextBox x:Name="txtEmail" Text="{Binding Email, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource DarkTextBox}" MinHeight="36"/>
            <TextBlock Text="Địa chỉ" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
            <TextBox x:Name="txtDiaChi" Text="{Binding DiaChi, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource DarkTextBox}" MinHeight="36"/>
            <TextBlock Text="Ngày vào làm" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
            <TextBox x:Name="dtpNgayVaoLam" Text="{Binding NgayVaoLam, Mode=OneWay, StringFormat=dd/MM/yyyy}" IsReadOnly="True" Style="{StaticResource DarkTextBox}" MinHeight="36"/>
            <TextBlock Text="Lương cơ bản (đ)" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
            <TextBox x:Name="txtLuongCoBanD" Text="{Binding LuongCoBan, Mode=OneWay, StringFormat=N2}" IsReadOnly="True" Style="{StaticResource DarkTextBox}" MinHeight="36"/>
            <TextBlock Text="Trạng thái" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
            <TextBox x:Name="txtTrangThai" Text="{Binding TrangThai, Mode=OneWay, Converter={StaticResource StatusTextConverter}}" IsReadOnly="True" Style="{StaticResource DarkTextBox}" MinHeight="36"/>
        </StackPanel></ScrollViewer>
        <WrapPanel Grid.Row="2" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="btnNhanVienSuaThongTin" Content="Sửa" Click="btnSua_Click" Style="{StaticResource SecondaryButton}" Margin="8,4,0,4" MinWidth="100" />
            <Button x:Name="btnNhanVienXoa" Content="Xóa" Click="btnXoa_Click" Style="{StaticResource DangerButton}" Margin="8,4,0,4" MinWidth="100" />
            <Button x:Name="btnDong" Content="Đóng" Click="btnDong_Click" Style="{StaticResource SecondaryButton}" Margin="8,4,0,4" MinWidth="100" IsCancel="True"/>
        </WrapPanel>
    </Grid>
</Window>
