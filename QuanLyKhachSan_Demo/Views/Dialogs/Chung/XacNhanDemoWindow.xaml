<Window x:Class="QuanLyKhachSan.Views.Dialogs.XacNhanDemoWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Xác nhận thao tác" Width="700" Height="700" MinWidth="540" MinHeight="400"
    WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
    Background="{StaticResource BackgroundBrush}" FontFamily="Segoe UI">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/QuanLyKhachSan;component/Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <!-- Bố cục cố định: tiêu đề, vùng nhập cuộn, hàng nút phía dưới. -->
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock x:Name="txtTieuDe" Text="Xác nhận thao tác" FontSize="22" FontWeight="SemiBold"
                       Foreground="{StaticResource GoldBrush}" TextWrapping="Wrap"/>
            </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,12,0">
                <TextBlock x:Name="txtNoiDung" Text="Bạn đang xem bước xác nhận thao tác."
                           Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" FontSize="16"/>
                <TextBlock Text="Ghi chú / lý do" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,18,0,5"/>
                <TextBox x:Name="txtLyDo" Style="{StaticResource DarkTextBox}" Height="100" AcceptsReturn="True" TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="btnDong" Content="Đóng" Style="{StaticResource SecondaryButton}"
                    Click="btnDong_Click" IsCancel="True" MinWidth="100"/>
            <Button x:Name="btnLuu" Content="Xác nhận" Style="{StaticResource PrimaryButton}"
                    Click="btnLuu_Click" MinWidth="140" Margin="8,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
