<Window x:Class="QuanLyKhachSan.Views.Dialogs.PhanQuyenWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Phân quyền" Width="700" Height="700" MinWidth="540" MinHeight="400"
    WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
    Background="{StaticResource BackgroundBrush}" FontFamily="Segoe UI">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/QuanLyKhachSan;component/Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <!-- Bố cục cố định: tiêu đề, vùng nhập cuộn, hàng nút phía dưới. -->
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock x:Name="txtTieuDe" Text="Phân quyền" FontSize="22" FontWeight="SemiBold"
                       Foreground="{StaticResource GoldBrush}" TextWrapping="Wrap"/>
            </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="pnlNoiDung" Margin="0,0,12,0">
<TextBlock x:Name="txtThongBao" Text="Chức năng đang được hoàn thiện. Thay đổi chưa được lưu." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                <TextBlock Text="Vai trò" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5"/>
                <ComboBox x:Name="cboVaiTro" Style="{StaticResource DarkComboBox}" DisplayMemberPath="TenVaiTro" SelectedValuePath="MaVaiTro" MinHeight="36"></ComboBox>
                <WrapPanel Margin="0,16,0,8">
                    <Button x:Name="btnChonTatCa" Content="Chọn tất cả" Click="btnChonTatCa_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                    <Button x:Name="btnBoChon" Content="Bỏ chọn" Click="btnBoChon_Click" Style="{StaticResource SecondaryButton}"/>
                </WrapPanel>
                <TextBlock Text="Phòng" Foreground="{StaticResource GoldBrush}" Margin="0,12,0,8"/>
                <WrapPanel>
                    <CheckBox x:Name="chkPhongXem" Content="Xem" IsChecked="False" Foreground="{StaticResource TextPrimaryBrush}" MinWidth="95" Margin="0,4,8,4"/>
                    <CheckBox x:Name="chkPhongThem" Content="Thêm" IsChecked="False" Foreground="{StaticResource TextPrimaryBrush}" MinWidth="95" Margin="0,4,8,4"/>
                    <CheckBox x:Name="chkPhongSua" Content="Sửa" IsChecked="False" Foreground="{StaticResource TextPrimaryBrush}" MinWidth="95" Margin="0,4,8,4"/>
                    <CheckBox x:Name="chkPhongXoa" Content="Xóa" IsChecked="False" Foreground="{StaticResource TextPrimaryBrush}" MinWidth="95" Margin="0,4,8,4"/>
                    <CheckBox x:Name="chkPhongXacNhan" Content="Xác nhận" IsChecked="False" Foreground="{StaticResource TextPrimaryBrush}" MinWidth="95" Margin="0,4,8,4"/>
                </WrapPanel>
                <TextBlock Text="Đặt phòng" Foreground="{StaticResource GoldBrush}" Margin="0,12,0,8"/>
                <WrapPanel>
                    <CheckBox x:Name="chkDatPhongXem" Content="Xem" IsChecked="False" Foreground="{StaticResource TextPrimaryBrush}" MinWidth="95" Margin="0,4,8,4"/>
                    <CheckBox x:Name="chkDatPhongThem" Content="Thêm" IsChecked="False" Foreground="{StaticResource TextPrimaryBrush}" MinWidth="95" Margin="0,4,8,4"/>
                    <CheckBox x:Name="chkDatPhongSua" Content="Sửa" IsChecked="False" Foreground="{StaticResource TextPrimaryBrush}" MinWidth="95" Margin="0,4,8,4"/>
                    <CheckBox x:Name="chkDatPhongXoa" Content="Xóa" IsChecked="False" Foreground="{StaticResource TextPrimaryBrush}" MinWidth="95" Margin="0,4,8,4"/>
                    <CheckBox x:Name="chkDatPhongXacNhan" Content="Xác nhận" IsChecked="False" Foreground="{StaticResource TextPrimaryBrush}" MinWidth="95" Margin="0,4,8,4"/>
                </WrapPanel>
                <TextBlock Text="Lưu trú" Foreground="{StaticResource GoldBrush}" Margin="0,12,0,8"/>
                <WrapPanel>
                    <CheckBox x:Name="chkLuuTruXem" Content="Xem" IsChecked="False" Foreground="{StaticResource TextPrimaryBrush}" MinWidth="95" Margin="0,4,8,4"/>
                    <CheckBox x:Name="chkLuuTruThem" Content="Thêm" IsChecked="False" Foreground="{StaticResource TextPrimaryBrush}" MinWidth="95" Margin="0,4,8,4"/>
                    <CheckBox x:Name="chkLuuTruSua" Content="Sửa" IsChecked="False" Foreground="{StaticResource TextPrimaryBrush}" MinWidth="95" Margin="0,4,8,4"/>
                    <CheckBox x:Name="chkLuuTruXoa" Content="Xóa" IsChecked="False" Foreground="{StaticResource TextPrimaryBrush}" MinWidth="95" Margin="0,4,8,4"/>
                    <CheckBox x:Name="chkLuuTruXacNhan" Content="Xác nhận" IsChecked="False" Foreground="{StaticResource TextPrimaryBrush}" MinWidth="95" Margin="0,4,8,4"/>
                </WrapPanel>
                <TextBlock Text="Khách hàng" Foreground="{StaticResource GoldBrush}" Margin="0,12,0,8"/>
                <WrapPanel>
                    <CheckBox x:Name="chkKhachHangXem" Content="Xem" IsChecked="False" Foreground="{StaticResource TextPrimaryBrush}" MinWidth="95" Margin="0,4,8,4"/>
                    <CheckBox x:Name="chkKhachHangThem" Content="Thêm" IsChecked="False" Foreground="{StaticResource TextPrimaryBrush}" MinWidth="95" Margin="0,4,8,4"/>
                    <CheckBox x:Name="chkKhachHangSua" Content="Sửa" IsChecked="False" Foreground="{StaticResource TextPrimaryBrush}" MinWidth="95" Margin="0,4,8,4"/>
                    <CheckBox x:Name="chkKhachHangXoa" Content="Xóa" IsChecked="False" Foreground="{StaticResource TextPrimaryBrush}" MinWidth="95" Margin="0,4,8,4"/>
                    <CheckBox x:Name="chkKhachHangXacNhan" Content="Xác nhận" IsChecked="False" Foreground="{StaticResource TextPrimaryBrush}" MinWidth="95" Margin="0,4,8,4"/>
                </WrapPanel>
                <TextBlock Text="Dịch vụ" Foreground="{StaticResource GoldBrush}" Margin="0,12,0,8"/>
                <WrapPanel>
                    <CheckBox x:Name="chkDichVuXem" Content="Xem" IsChecked="False" Foreground="{StaticResource TextPrimaryBrush}" MinWidth="95" Margin="0,4,8,4"/>
                    <CheckBox x:Name="chkDichVuThem" Content="Thêm" IsChecked="False" Foreground="{StaticResource TextPrimaryBrush}" MinWidth="95" Margin="0,4,8,4"/>
                    <CheckBox x:Name="chkDichVuSua" Content="Sửa" IsChecked="False" Foreground="{StaticResource TextPrimaryBrush}" MinWidth="95" Margin="0,4,8,4"/>
                    <CheckBox x:Name="chkDichVuXoa" Content="Xóa" IsChecked="False" Foreground="{StaticResource TextPrimaryBrush}" MinWidth="95" Margin="0,4,8,4"/>
                    <CheckBox x:Name="chkDichVuXacNhan" Content="Xác nhận" IsChecked="False" Foreground="{StaticResource TextPrimaryBrush}" MinWidth="95" Margin="0,4,8,4"/>
                </WrapPanel>
                <TextBlock Text="Hóa đơn" Foreground="{StaticResource GoldBrush}" Margin="0,12,0,8"/>
                <WrapPanel>
                    <CheckBox x:Name="chkHoaDonXem" Content="Xem" IsChecked="False" Foreground="{StaticResource TextPrimaryBrush}" MinWidth="95" Margin="0,4,8,4"/>
                    <CheckBox x:Name="chkHoaDonThem" Content="Thêm" IsChecked="False" Foreground="{StaticResource TextPrimaryBrush}" MinWidth="95" Margin="0,4,8,4"/>
                    <CheckBox x:Name="chkHoaDonSua" Content="Sửa" IsChecked="False" Foreground="{StaticResource TextPrimaryBrush}" MinWidth="95" Margin="0,4,8,4"/>
                    <CheckBox x:Name="chkHoaDonXoa" Content="Xóa" IsChecked="False" Foreground="{StaticResource TextPrimaryBrush}" MinWidth="95" Margin="0,4,8,4"/>
                    <CheckBox x:Name="chkHoaDonXacNhan" Content="Xác nhận" IsChecked="False" Foreground="{StaticResource TextPrimaryBrush}" MinWidth="95" Margin="0,4,8,4"/>
                </WrapPanel>
                <TextBlock Text="Kho" Foreground="{StaticResource GoldBrush}" Margin="0,12,0,8"/>
                <WrapPanel>
                    <CheckBox x:Name="chkKhoXem" Content="Xem" IsChecked="False" Foreground="{StaticResource TextPrimaryBrush}" MinWidth="95" Margin="0,4,8,4"/>
                    <CheckBox x:Name="chkKhoThem" Content="Thêm" IsChecked="False" Foreground="{StaticResource TextPrimaryBrush}" MinWidth="95" Margin="0,4,8,4"/>
                    <CheckBox x:Name="chkKhoSua" Content="Sửa" IsChecked="False" Foreground="{StaticResource TextPrimaryBrush}" MinWidth="95" Margin="0,4,8,4"/>
                    <CheckBox x:Name="chkKhoXoa" Content="Xóa" IsChecked="False" Foreground="{StaticResource TextPrimaryBrush}" MinWidth="95" Margin="0,4,8,4"/>
                    <CheckBox x:Name="chkKhoXacNhan" Content="Xác nhận" IsChecked="False" Foreground="{StaticResource TextPrimaryBrush}" MinWidth="95" Margin="0,4,8,4"/>
                </WrapPanel>
                <TextBlock Text="Nhân viên" Foreground="{StaticResource GoldBrush}" Margin="0,12,0,8"/>
                <WrapPanel>
                    <CheckBox x:Name="chkNhanVienXem" Content="Xem" IsChecked="False" Foreground="{StaticResource TextPrimaryBrush}" MinWidth="95" Margin="0,4,8,4"/>
                    <CheckBox x:Name="chkNhanVienThem" Content="Thêm" IsChecked="False" Foreground="{StaticResource TextPrimaryBrush}" MinWidth="95" Margin="0,4,8,4"/>
                    <CheckBox x:Name="chkNhanVienSua" Content="Sửa" IsChecked="False" Foreground="{StaticResource TextPrimaryBrush}" MinWidth="95" Margin="0,4,8,4"/>
                    <CheckBox x:Name="chkNhanVienXoa" Content="Xóa" IsChecked="False" Foreground="{StaticResource TextPrimaryBrush}" MinWidth="95" Margin="0,4,8,4"/>
                    <CheckBox x:Name="chkNhanVienXacNhan" Content="Xác nhận" IsChecked="False" Foreground="{StaticResource TextPrimaryBrush}" MinWidth="95" Margin="0,4,8,4"/>
                </WrapPanel>
                <TextBlock Text="Nhân sự" Foreground="{StaticResource GoldBrush}" Margin="0,12,0,8"/>
                <WrapPanel>
                    <CheckBox x:Name="chkNhanSuXem" Content="Xem" IsChecked="False" Foreground="{StaticResource TextPrimaryBrush}" MinWidth="95" Margin="0,4,8,4"/>
                    <CheckBox x:Name="chkNhanSuThem" Content="Thêm" IsChecked="False" Foreground="{StaticResource TextPrimaryBrush}" MinWidth="95" Margin="0,4,8,4"/>
                    <CheckBox x:Name="chkNhanSuSua" Content="Sửa" IsChecked="False" Foreground="{StaticResource TextPrimaryBrush}" MinWidth="95" Margin="0,4,8,4"/>
                    <CheckBox x:Name="chkNhanSuXoa" Content="Xóa" IsChecked="False" Foreground="{StaticResource TextPrimaryBrush}" MinWidth="95" Margin="0,4,8,4"/>
                    <CheckBox x:Name="chkNhanSuXacNhan" Content="Xác nhận" IsChecked="False" Foreground="{StaticResource TextPrimaryBrush}" MinWidth="95" Margin="0,4,8,4"/>
                </WrapPanel>
                <TextBlock Text="Buồng phòng" Foreground="{StaticResource GoldBrush}" Margin="0,12,0,8"/>
                <WrapPanel>
                    <CheckBox x:Name="chkBuongPhongXem" Content="Xem" IsChecked="False" Foreground="{StaticResource TextPrimaryBrush}" MinWidth="95" Margin="0,4,8,4"/>
                    <CheckBox x:Name="chkBuongPhongThem" Content="Thêm" IsChecked="False" Foreground="{StaticResource TextPrimaryBrush}" MinWidth="95" Margin="0,4,8,4"/>
                    <CheckBox x:Name="chkBuongPhongSua" Content="Sửa" IsChecked="False" Foreground="{StaticResource TextPrimaryBrush}" MinWidth="95" Margin="0,4,8,4"/>
                    <CheckBox x:Name="chkBuongPhongXoa" Content="Xóa" IsChecked="False" Foreground="{StaticResource TextPrimaryBrush}" MinWidth="95" Margin="0,4,8,4"/>
                    <CheckBox x:Name="chkBuongPhongXacNhan" Content="Xác nhận" IsChecked="False" Foreground="{StaticResource TextPrimaryBrush}" MinWidth="95" Margin="0,4,8,4"/>
                </WrapPanel>
                <TextBlock Text="Danh mục" Foreground="{StaticResource GoldBrush}" Margin="0,12,0,8"/>
                <WrapPanel>
                    <CheckBox x:Name="chkDanhMucXem" Content="Xem" IsChecked="False" Foreground="{StaticResource TextPrimaryBrush}" MinWidth="95" Margin="0,4,8,4"/>
                    <CheckBox x:Name="chkDanhMucThem" Content="Thêm" IsChecked="False" Foreground="{StaticResource TextPrimaryBrush}" MinWidth="95" Margin="0,4,8,4"/>
                    <CheckBox x:Name="chkDanhMucSua" Content="Sửa" IsChecked="False" Foreground="{StaticResource TextPrimaryBrush}" MinWidth="95" Margin="0,4,8,4"/>
                    <CheckBox x:Name="chkDanhMucXoa" Content="Xóa" IsChecked="False" Foreground="{StaticResource TextPrimaryBrush}" MinWidth="95" Margin="0,4,8,4"/>
                    <CheckBox x:Name="chkDanhMucXacNhan" Content="Xác nhận" IsChecked="False" Foreground="{StaticResource TextPrimaryBrush}" MinWidth="95" Margin="0,4,8,4"/>
                </WrapPanel>
                <TextBlock Text="Tài khoản" Foreground="{StaticResource GoldBrush}" Margin="0,12,0,8"/>
                <WrapPanel>
                    <CheckBox x:Name="chkTaiKhoanXem" Content="Xem" IsChecked="False" Foreground="{StaticResource TextPrimaryBrush}" MinWidth="95" Margin="0,4,8,4"/>
                    <CheckBox x:Name="chkTaiKhoanThem" Content="Thêm" IsChecked="False" Foreground="{StaticResource TextPrimaryBrush}" MinWidth="95" Margin="0,4,8,4"/>
                    <CheckBox x:Name="chkTaiKhoanSua" Content="Sửa" IsChecked="False" Foreground="{StaticResource TextPrimaryBrush}" MinWidth="95" Margin="0,4,8,4"/>
                    <CheckBox x:Name="chkTaiKhoanXoa" Content="Xóa" IsChecked="False" Foreground="{StaticResource TextPrimaryBrush}" MinWidth="95" Margin="0,4,8,4"/>
                    <CheckBox x:Name="chkTaiKhoanXacNhan" Content="Xác nhận" IsChecked="False" Foreground="{StaticResource TextPrimaryBrush}" MinWidth="95" Margin="0,4,8,4"/>
                </WrapPanel>
                <TextBlock Text="Nhật ký" Foreground="{StaticResource GoldBrush}" Margin="0,12,0,8"/>
                <WrapPanel>
                    <CheckBox x:Name="chkNhatKyXem" Content="Xem" IsChecked="False" Foreground="{StaticResource TextPrimaryBrush}" MinWidth="95" Margin="0,4,8,4"/>
                    <CheckBox x:Name="chkNhatKyThem" Content="Thêm" IsChecked="False" Foreground="{StaticResource TextPrimaryBrush}" MinWidth="95" Margin="0,4,8,4"/>
                    <CheckBox x:Name="chkNhatKySua" Content="Sửa" IsChecked="False" Foreground="{StaticResource TextPrimaryBrush}" MinWidth="95" Margin="0,4,8,4"/>
                    <CheckBox x:Name="chkNhatKyXoa" Content="Xóa" IsChecked="False" Foreground="{StaticResource TextPrimaryBrush}" MinWidth="95" Margin="0,4,8,4"/>
                    <CheckBox x:Name="chkNhatKyXacNhan" Content="Xác nhận" IsChecked="False" Foreground="{StaticResource TextPrimaryBrush}" MinWidth="95" Margin="0,4,8,4"/>
                </WrapPanel>

            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="btnDong" Content="Đóng" Style="{StaticResource SecondaryButton}"
                    Click="btnDong_Click" IsCancel="True" MinWidth="100"/>
            <Button x:Name="btnLuu" Content="Xác nhận" Style="{StaticResource PrimaryButton}"
                    Click="btnLuu_Click" MinWidth="140" Margin="8,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>