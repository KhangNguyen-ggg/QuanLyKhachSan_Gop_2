<Window x:Class="QuanLyKhachSan.Views.Dialogs.CaLamViecForm"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Thông tin ca làm việc" Width="700" Height="700" MinWidth="540" MinHeight="400"
    WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
    Background="{StaticResource BackgroundBrush}" FontFamily="Segoe UI">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/QuanLyKhachSan;component/Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <!-- Bố cục cố định: tiêu đề, vùng nhập cuộn, hàng nút phía dưới. -->
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock x:Name="txtTieuDe" Text="Thông tin ca làm việc" FontSize="22" FontWeight="SemiBold"
                       Foreground="{StaticResource GoldBrush}" TextWrapping="Wrap"/>
            </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,12,0">
                <TextBlock Text="Mã ca" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5"/>
                <TextBox x:Name="txtMaCa" Text="CL01" Style="{StaticResource DarkTextBox}" MinHeight="38" IsReadOnly="True"/>
                <TextBlock Text="Tên ca" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5"/>
                <TextBox x:Name="txtTenCa" Text="Ca sáng" Style="{StaticResource DarkTextBox}" MinHeight="38"/>
                <TextBlock Text="Giờ bắt đầu" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5"/>
                <TextBox x:Name="txtGioBatDau" Text="06:00" Style="{StaticResource DarkTextBox}" MinHeight="38"/>
                <TextBlock Text="Giờ kết thúc" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5"/>
                <TextBox x:Name="txtGioKetThuc" Text="14:00" Style="{StaticResource DarkTextBox}" MinHeight="38"/>
                <TextBlock Text="Số giờ" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5"/>
                <TextBox x:Name="txtSoGio" Text="8" Style="{StaticResource DarkTextBox}" MinHeight="38"/>
                <TextBlock Text="Trạng thái" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5"/>
                <ComboBox x:Name="cboTrangThai" Style="{StaticResource DarkComboBox}" SelectedIndex="0" MinHeight="36">
                    <ComboBoxItem Style="{StaticResource ReadableComboBoxItem}" Content="Đang hoạt động"/>
                    <ComboBoxItem Style="{StaticResource ReadableComboBoxItem}" Content="Ngừng hoạt động"/>
                </ComboBox>
            </StackPanel>
        </ScrollViewer>
        <Grid Grid.Row="2" Margin="0,20,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button x:Name="btnLuu" Content="Xác nhận" Style="{StaticResource SuccessButton}"
                        Click="btnLuu_Click" MinWidth="140" Margin="0,0,8,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="btnDong" Content="Đóng" Style="{StaticResource SecondaryButton}"
                        Click="btnDong_Click" IsCancel="True" MinWidth="100" Margin="0,0,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
