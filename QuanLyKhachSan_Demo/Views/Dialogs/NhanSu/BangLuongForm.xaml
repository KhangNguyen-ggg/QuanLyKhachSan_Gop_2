<Window x:Class="QuanLyKhachSan.Views.Dialogs.BangLuongForm"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Thông tin bảng lương" Width="700" Height="700" MinWidth="540" MinHeight="400"
    WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
    Background="{StaticResource BackgroundBrush}" FontFamily="Segoe UI">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/QuanLyKhachSan;component/Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <!-- Bố cục cố định: tiêu đề, vùng nhập cuộn, hàng nút phía dưới. -->
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock x:Name="txtTieuDe" Text="Thông tin bảng lương" FontSize="22" FontWeight="SemiBold"
                       Foreground="{StaticResource GoldBrush}" TextWrapping="Wrap"/>
            </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,12,0">
                <TextBlock Text="Nhân viên" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5"/>
                <ComboBox x:Name="cboNhanVien" Style="{StaticResource DarkComboBox}" SelectedIndex="0" MinHeight="36">
                    <ComboBoxItem Style="{StaticResource ReadableComboBoxItem}" Content="Nguyễn Văn An — NV001"/>
                    <ComboBoxItem Style="{StaticResource ReadableComboBoxItem}" Content="Trần Ngọc Bảo — NV003"/>
                    <ComboBoxItem Style="{StaticResource ReadableComboBoxItem}" Content="Lê Mỹ Duyên — NV005"/>
                </ComboBox>
                <TextBlock Text="Tháng" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5"/>
                <TextBox x:Name="txtThang" Text="9" Style="{StaticResource DarkTextBox}" MinHeight="38"/>
                <TextBlock Text="Năm" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5"/>
                <TextBox x:Name="txtNam" Text="2026" Style="{StaticResource DarkTextBox}" MinHeight="38"/>
                <TextBlock Text="Lương cơ bản (đ)" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5"/>
                <TextBox x:Name="txtLuongCoBanD" Text="9000000" Style="{StaticResource DarkTextBox}" MinHeight="38"/>
                <TextBlock Text="Tiền công (đ)" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5"/>
                <TextBox x:Name="txtTienCongD" Text="9000000" Style="{StaticResource DarkTextBox}" MinHeight="38"/>
                <TextBlock Text="Tiền tăng ca (đ)" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5"/>
                <TextBox x:Name="txtTienTangCaD" Text="500000" Style="{StaticResource DarkTextBox}" MinHeight="38"/>
                <TextBlock Text="Thưởng (đ)" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5"/>
                <TextBox x:Name="txtThuongD" Text="300000" Style="{StaticResource DarkTextBox}" MinHeight="38"/>
                <TextBlock Text="Phụ cấp (đ)" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5"/>
                <TextBox x:Name="txtPhuCapD" Text="500000" Style="{StaticResource DarkTextBox}" MinHeight="38"/>
                <TextBlock Text="Khấu trừ (đ)" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5"/>
                <TextBox x:Name="txtKhauTruD" Text="200000" Style="{StaticResource DarkTextBox}" MinHeight="38"/>
                <TextBlock Text="Thuế (đ)" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5"/>
                <TextBox x:Name="txtThueD" Text="0" Style="{StaticResource DarkTextBox}" MinHeight="38"/>
                <TextBlock Text="Thực lĩnh (đ)" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5"/>
                <TextBox x:Name="txtThucLinhMinhHoaD" Text="10100000" Style="{StaticResource DarkTextBox}" MinHeight="38"/>
                <TextBlock Text="Ghi chú" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5"/>
                <TextBox x:Name="txtGhiChu" Text="" Style="{StaticResource DarkTextBox}" MinHeight="90" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
            </StackPanel>
        </ScrollViewer>
        <Grid Grid.Row="2" Margin="0,20,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button x:Name="btnLuu" Content="Xác nhận" Style="{StaticResource SuccessButton}"
                        Click="btnLuu_Click" MinWidth="140" Margin="0,0,8,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="btnDong" Content="Đóng" Style="{StaticResource SecondaryButton}"
                        Click="btnDong_Click" IsCancel="True" MinWidth="100" Margin="0,0,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
