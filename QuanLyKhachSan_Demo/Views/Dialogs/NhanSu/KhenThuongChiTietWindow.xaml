<Window x:Class="QuanLyKhachSan.Views.Dialogs.KhenThuongChiTietWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="clr-namespace:QuanLyKhachSan.Helpers"
    Title="Chi tiết khen thưởng" Width="760" Height="740" MinWidth="540" MinHeight="400"
    WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource BackgroundBrush}" FontFamily="Segoe UI">
    <Window.Resources><ResourceDictionary>
        <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/QuanLyKhachSan;component/Resources/Styles.xaml"/></ResourceDictionary.MergedDictionaries>
        <helpers:GioConverter x:Key="GioConverter"/>
    </ResourceDictionary></Window.Resources>
    <!-- Thêm: sửa ngay trong cửa sổ; mã và các trường tự tính không mở khóa. -->
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,14">
            <TextBlock x:Name="txtTieuDe" Text="Chi tiết khen thưởng" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource GoldBrush}" TextWrapping="Wrap"/>
            <TextBlock x:Name="txtThongBao" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="pnlThongTin" Margin="0,0,12,0">
                <TextBlock Text="Mã khen thưởng" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
                <TextBox x:Name="txtMa" Style="{StaticResource DarkTextBox}" Text="{Binding MaKhenThuong, Mode=OneWay}" Tag="Khoa" IsReadOnly="True" MinHeight="36"/>

            <TextBlock Text="Nhân viên" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
            <ComboBox x:Name="cboNhanVien" Style="{StaticResource DarkComboBox}" MinHeight="36"/>
            <TextBlock Text="Ngày khen thưởng" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
            <DatePicker x:Name="dtpNgay" SelectedDate="{Binding NgayKhenThuong, Mode=OneWay}" Height="36" Foreground="Black" Background="White"/>
            <TextBlock Text="Lý do" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
            <TextBox x:Name="txtLyDo" Text="{Binding LyDo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  Style="{StaticResource DarkTextBox}" MinHeight="36"/>
            <TextBlock Text="Hình thức" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
            <ComboBox x:Name="cboHinhThuc" Style="{StaticResource DarkComboBox}" MinHeight="36"/>
            <TextBlock Text="Số tiền (đ; biểu dương/giấy khen nhập 0)" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
            <TextBox x:Name="txtSoTienD" Text="{Binding SoTien, Mode=OneWay}"  Style="{StaticResource DarkTextBox}" MinHeight="36"/>
            <TextBlock Text="Trạng thái" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
            <ComboBox x:Name="cboTrangThai" Style="{StaticResource DarkComboBox}" MinHeight="36"/>
            <TextBlock Text="Ghi chú" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
            <TextBox x:Name="txtGhiChu" Text="{Binding GhiChu, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  Style="{StaticResource DarkTextBox}" MinHeight="36"/>
        </StackPanel></ScrollViewer>
        <WrapPanel Grid.Row="2" HorizontalAlignment="Right" Margin="0,16,0,0">
<WrapPanel x:Name="pnlThaoTac">
<Button x:Name="btnKhenThuongSuaThongTin" Content="Sửa" Click="btnSua_Click" Style="{StaticResource SecondaryButton}" Margin="8,4,0,4" MinWidth="100"/><Button x:Name="btnKhenThuongXoa" Content="Xóa" Click="btnXoa_Click" Style="{StaticResource DangerButton}" Margin="8,4,0,4" MinWidth="100"/></WrapPanel>
<WrapPanel x:Name="pnlLuu" Visibility="Collapsed">
<Button x:Name="btnLuuSua" Content="Lưu thay đổi" Click="btnLuuSua_Click" Style="{StaticResource PrimaryButton}" Margin="8,4,0,4" MinWidth="100"/><Button x:Name="btnHuySua" Content="Hủy sửa" Click="btnHuySua_Click" Style="{StaticResource SecondaryButton}" Margin="8,4,0,4" MinWidth="100"/></WrapPanel>
<Button x:Name="btnDong" Content="Đóng" Click="btnDong_Click" Style="{StaticResource SecondaryButton}" Margin="8,4,0,4" MinWidth="100" IsCancel="True"/>
</WrapPanel>
    </Grid>
</Window>
