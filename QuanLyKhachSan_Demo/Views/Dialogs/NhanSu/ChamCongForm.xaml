<Window x:Class="QuanLyKhachSan.Views.Dialogs.ChamCongForm"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="clr-namespace:QuanLyKhachSan.Helpers"
    Title="Thông tin chấm công" Width="760" Height="740" MinWidth="540" MinHeight="400"
    WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource BackgroundBrush}" FontFamily="Segoe UI">
    <Window.Resources><ResourceDictionary>
        <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/QuanLyKhachSan;component/Resources/Styles.xaml"/></ResourceDictionary.MergedDictionaries>
        <helpers:GioConverter x:Key="GioConverter"/>
    </ResourceDictionary></Window.Resources>
    <!-- Thêm: form dùng cho cả tạo mới và sửa; mã tự sinh, bỏ dữ liệu mẫu và ô nhập mã. -->
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,14">
            <TextBlock x:Name="txtTieuDe" Text="Thông tin chấm công" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource GoldBrush}" TextWrapping="Wrap"/>
            <TextBlock x:Name="txtThongBao" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,12,0">
            <TextBlock Text="Lịch (nhân viên và ngày được lấy từ lịch)" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
            <ComboBox x:Name="cboLich" Style="{StaticResource DarkComboBox}" MinHeight="36"/>
            <TextBlock Text="Ngày vào" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
            <DatePicker x:Name="dtpNgayVao"  Height="36" Foreground="Black" Background="White"/>
            <TextBlock Text="Giờ vào (HH:mm)" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
            <TextBox x:Name="txtGioVao"   Style="{StaticResource DarkTextBox}" MinHeight="36"/>
            <TextBlock Text="Ngày ra (chọn ngày hôm sau nếu ca qua đêm)" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
            <DatePicker x:Name="dtpNgayRa"  Height="36" Foreground="Black" Background="White"/>
            <TextBlock Text="Giờ ra (HH:mm)" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
            <TextBox x:Name="txtGioRa"   Style="{StaticResource DarkTextBox}" MinHeight="36"/>
            <TextBlock Text="Giờ thường (tự tính khi lưu)" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
            <TextBox x:Name="txtGioThuong" Text="{Binding SoGioLam, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource DarkTextBox}" MinHeight="36"/>
            <TextBlock Text="Số giờ tăng ca" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
            <TextBox x:Name="txtTangCa" Text="{Binding SoGioTangCa, Mode=OneWay}"  Style="{StaticResource DarkTextBox}" MinHeight="36"/>
            <TextBlock Text="Trạng thái (đủ/thiếu công được tính lại theo giờ)" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
            <ComboBox x:Name="cboTrangThai" Style="{StaticResource DarkComboBox}" MinHeight="36"/>
            <TextBlock Text="Ghi chú" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
            <TextBox x:Name="txtGhiChu" Text="{Binding GhiChu, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  Style="{StaticResource DarkTextBox}" MinHeight="36"/>
        </StackPanel></ScrollViewer>
        <WrapPanel Grid.Row="2" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="btnLuu" Content="Lưu" Click="btnLuu_Click" Style="{StaticResource PrimaryButton}" Margin="8,4,0,4" MinWidth="100" />
            <Button x:Name="btnDong" Content="Đóng" Click="btnDong_Click" Style="{StaticResource SecondaryButton}" Margin="8,4,0,4" MinWidth="100" IsCancel="True"/>
        </WrapPanel>
    </Grid>
</Window>
