<Window x:Class="QuanLyKhachSan.Views.Dialogs.BangLuongChiTietWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Chi tiết — Bảng lương" Width="760" Height="700" MinWidth="540" MinHeight="400"
    WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource BackgroundBrush}" FontFamily="Segoe UI">
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/QuanLyKhachSan;component/Resources/Styles.xaml"/>
    </ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="Chi tiết — Bảng lương" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource GoldBrush}" TextWrapping="Wrap"/>
            <TextBlock x:Name="txtThongBao" Text="Nhấn Sửa để chỉnh sửa thông tin của dòng này." Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,12,0">
            
            
                <TextBlock Text="Mã" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
                <TextBox x:Name="txtMa" Text="{Binding Ma, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource DarkTextBox}"/>
                <TextBlock Text="Nhân viên" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
                <TextBox x:Name="txtNhanVien" Text="{Binding NhanVien, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource DarkTextBox}"/>
                <TextBlock Text="Kỳ" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
                <TextBox x:Name="txtKy" Text="{Binding Ky, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource DarkTextBox}"/>
                <TextBlock Text="Tiền công" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
                <TextBox x:Name="txtTienCong" Text="{Binding TienCong, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource DarkTextBox}"/>
                <TextBlock Text="Tăng ca" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
                <TextBox x:Name="txtTangCa" Text="{Binding TangCa, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource DarkTextBox}"/>
                <TextBlock Text="Thưởng" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
                <TextBox x:Name="txtThuong" Text="{Binding Thuong, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource DarkTextBox}"/>
                <TextBlock Text="Phụ cấp" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
                <TextBox x:Name="txtPhuCap" Text="{Binding PhuCap, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource DarkTextBox}"/>
                <TextBlock Text="Khấu trừ" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
                <TextBox x:Name="txtKhauTru" Text="{Binding KhauTru, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource DarkTextBox}"/>
                <TextBlock Text="Thuế (đ)" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5"/>
                <TextBox x:Name="txtThueD" Text="0" Style="{StaticResource DarkTextBox}" MinHeight="38"/>
                <TextBlock Text="Thực lĩnh" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
                <TextBox x:Name="txtThucLinh" Text="{Binding ThucLinh, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource DarkTextBox}"/>
                <TextBlock Text="Trạng thái" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
                <TextBox x:Name="txtTrangThai" Text="{Binding TrangThai, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource DarkTextBox}"/>
        </StackPanel></ScrollViewer>
        <WrapPanel Grid.Row="2" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="btnBangLuongLapBangLuong" Content="Lưu bảng lương" Click="btnBangLuongLapBangLuong_Click" Style="{StaticResource PrimaryButton}" Margin="8,4,0,4" MinWidth="90"/>
            <Button x:Name="btnBangLuongSuaThongTin" Content="Sửa" Click="btnSua_Click" Style="{StaticResource SecondaryButton}" Margin="8,4,0,4" MinWidth="90"/>
            <Button x:Name="btnBangLuongXoa" Content="Xóa" Click="btnXoa_Click" Style="{StaticResource DangerButton}" Margin="8,4,0,4" MinWidth="90"/>
            <Button x:Name="btnLuuSua" Content="Lưu thay đổi" Click="btnLuuSua_Click" Style="{StaticResource PrimaryButton}" Margin="8,4,0,4" Visibility="Collapsed"/>
            <Button x:Name="btnHuySua" Content="Hủy sửa" Click="btnHuySua_Click" Style="{StaticResource SecondaryButton}" Margin="8,4,0,4" Visibility="Collapsed"/>
            <Button x:Name="btnDong" Content="Đóng" Click="btnDong_Click" Style="{StaticResource SecondaryButton}" Margin="8,4,0,4" IsCancel="True" MinWidth="90"/>
        </WrapPanel>
    </Grid>
</Window>
