<Window x:Class="QuanLyKhachSan.Views.Dialogs.BangLuongChiTietWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="clr-namespace:QuanLyKhachSan.Helpers"
    Title="Chi tiết bảng lương" Width="760" Height="740" MinWidth="540" MinHeight="400"
    WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource BackgroundBrush}" FontFamily="Segoe UI">
    <Window.Resources><ResourceDictionary>
        <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/QuanLyKhachSan;component/Resources/Styles.xaml"/></ResourceDictionary.MergedDictionaries>
        <helpers:GioConverter x:Key="GioConverter"/>
    </ResourceDictionary></Window.Resources>
    <!-- Thêm: sửa ngay trong cửa sổ; mã và các trường tự tính không mở khóa. -->
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,14">
            <TextBlock x:Name="txtTieuDe" Text="Chi tiết bảng lương" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource GoldBrush}" TextWrapping="Wrap"/>
            <TextBlock x:Name="txtThongBao" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="pnlThongTin" Margin="0,0,12,0">
                <TextBlock Text="Mã bảng lương" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
                <TextBox x:Name="txtMa" Style="{StaticResource DarkTextBox}" Text="{Binding MaBangLuong, Mode=OneWay}" Tag="Khoa" IsReadOnly="True" MinHeight="36"/>

            <TextBlock Text="Nhân viên" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
            <ComboBox x:Name="cboNhanVien" Style="{StaticResource DarkComboBox}" MinHeight="36"/>
            <TextBlock Text="Tháng" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
            <TextBox x:Name="txtThang" Text="{Binding Thang, Mode=OneWay}"  Style="{StaticResource DarkTextBox}" MinHeight="36"/>
            <TextBlock Text="Năm" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
            <TextBox x:Name="txtNam" Text="{Binding Nam, Mode=OneWay}"  Style="{StaticResource DarkTextBox}" MinHeight="36"/>
            <TextBlock Text="Lương cơ bản tham chiếu (đ)" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
            <TextBox x:Name="txtLuongCoBanD" Text="{Binding LuongCoBan, Mode=OneWay}"  TextChanged="Tien_TextChanged" Style="{StaticResource DarkTextBox}" MinHeight="36"/>
            <TextBlock Text="Tiền công (đ)" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
            <TextBox x:Name="txtTienCongD" Text="{Binding TienCong, Mode=OneWay}"  TextChanged="Tien_TextChanged" Style="{StaticResource DarkTextBox}" MinHeight="36"/>
            <TextBlock Text="Tiền tăng ca (đ)" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
            <TextBox x:Name="txtTienTangCaD" Text="{Binding TienTangCa, Mode=OneWay}"  TextChanged="Tien_TextChanged" Style="{StaticResource DarkTextBox}" MinHeight="36"/>
            <TextBlock Text="Tiền thưởng kỳ này (đ)" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
            <TextBox x:Name="txtThuongD" Text="{Binding TienThuong, Mode=OneWay}"  TextChanged="Tien_TextChanged" Style="{StaticResource DarkTextBox}" MinHeight="36"/>
            <TextBlock Text="Phụ cấp (đ)" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
            <TextBox x:Name="txtPhuCapD" Text="{Binding TienPhuCap, Mode=OneWay}"  TextChanged="Tien_TextChanged" Style="{StaticResource DarkTextBox}" MinHeight="36"/>
            <TextBlock Text="Khấu trừ (đ)" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
            <TextBox x:Name="txtKhauTruD" Text="{Binding TienKhauTru, Mode=OneWay}"  TextChanged="Tien_TextChanged" Style="{StaticResource DarkTextBox}" MinHeight="36"/>
            <TextBlock Text="Thuế (đ)" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
            <TextBox x:Name="txtThueD" Text="{Binding Thue, Mode=OneWay}"  TextChanged="Tien_TextChanged" Style="{StaticResource DarkTextBox}" MinHeight="36"/>
            <TextBlock Text="Tổng lương (tự tính)" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
            <TextBox x:Name="txtTongLuong" Text="{Binding TongLuong, Mode=OneWay}" Tag="Khoa" IsReadOnly="True" Style="{StaticResource DarkTextBox}" MinHeight="36"/>
            <TextBlock Text="Thực lĩnh (tự tính)" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
            <TextBox x:Name="txtThucLinhMinhHoaD" Text="{Binding ThucLinh, Mode=OneWay}" Tag="Khoa" IsReadOnly="True" Style="{StaticResource DarkTextBox}" MinHeight="36"/>
            <TextBlock Text="Trạng thái" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
            <ComboBox x:Name="cboTrangThai" Style="{StaticResource DarkComboBox}" MinHeight="36"/>
            <TextBlock Text="Ghi chú" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
            <TextBox x:Name="txtGhiChu" Text="{Binding GhiChu, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  Style="{StaticResource DarkTextBox}" MinHeight="36"/>
            <TextBlock Text="Nạp là thay giá trị tham chiếu và thưởng kỳ này; tiền công nhập riêng, không tự quy đổi từ chấm công." TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
            <Button x:Name="btnNapLuongThuong" Content="Nạp lương cơ bản và thưởng đã duyệt" Click="btnNapLuongThuong_Click" Style="{StaticResource SecondaryButton}" Margin="8,4,0,4" MinWidth="100" />
        </StackPanel></ScrollViewer>
        <WrapPanel Grid.Row="2" HorizontalAlignment="Right" Margin="0,16,0,0">
<WrapPanel x:Name="pnlThaoTac">
<Button x:Name="btnBangLuongSuaThongTin" Content="Sửa" Click="btnSua_Click" Style="{StaticResource SecondaryButton}" Margin="8,4,0,4" MinWidth="100"/><Button x:Name="btnBangLuongXoa" Content="Xóa" Click="btnXoa_Click" Style="{StaticResource DangerButton}" Margin="8,4,0,4" MinWidth="100"/></WrapPanel>
<WrapPanel x:Name="pnlLuu" Visibility="Collapsed">
<Button x:Name="btnLuuSua" Content="Lưu thay đổi" Click="btnLuuSua_Click" Style="{StaticResource PrimaryButton}" Margin="8,4,0,4" MinWidth="100"/><Button x:Name="btnHuySua" Content="Hủy sửa" Click="btnHuySua_Click" Style="{StaticResource SecondaryButton}" Margin="8,4,0,4" MinWidth="100"/></WrapPanel>
<Button x:Name="btnDong" Content="Đóng" Click="btnDong_Click" Style="{StaticResource SecondaryButton}" Margin="8,4,0,4" MinWidth="100" IsCancel="True"/>
</WrapPanel>
    </Grid>
</Window>
