<Window x:Class="QuanLyKhachSan.Views.Dialogs.ChamCongChiTietWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="clr-namespace:QuanLyKhachSan.Helpers"
    Title="Chi tiết — Chấm công" Width="760" Height="740" MinWidth="540" MinHeight="400"
    WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource BackgroundBrush}" FontFamily="Segoe UI">
    <Window.Resources><ResourceDictionary>
        <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/QuanLyKhachSan;component/Resources/Styles.xaml"/></ResourceDictionary.MergedDictionaries>
        <helpers:GioConverter x:Key="GioConverter"/>
    </ResourceDictionary></Window.Resources>
    <!-- Bớt: bỏ nút Thêm và khối Sửa/Lưu lặp; nút Sửa dùng lại form nhập có bản nháp. -->
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,14">
            <TextBlock x:Name="txtTieuDe" Text="Chi tiết — Chấm công" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource GoldBrush}" TextWrapping="Wrap"/>
            <TextBlock x:Name="txtThongBao" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,12,0">
            <TextBlock Text="Mã" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
            <TextBox x:Name="txtMa" Text="{Binding MaChamCong, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource DarkTextBox}" MinHeight="36"/>
            <TextBlock Text="Lịch (nhân viên và ngày được lấy từ lịch)" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
            <TextBox x:Name="txtLich" Text="{Binding MaLich, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource DarkTextBox}" MinHeight="36"/>
            <TextBlock Text="Giờ thường" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
            <TextBox x:Name="txtGioThuong" Text="{Binding SoGioLam, Mode=OneWay, StringFormat=N2}" IsReadOnly="True" Style="{StaticResource DarkTextBox}" MinHeight="36"/>
            <TextBlock Text="Số giờ tăng ca" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
            <TextBox x:Name="txtTangCa" Text="{Binding SoGioTangCa, Mode=OneWay, StringFormat=N2}" IsReadOnly="True" Style="{StaticResource DarkTextBox}" MinHeight="36"/>
            <TextBlock Text="Trạng thái (đủ/thiếu công được tính lại theo giờ)" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
            <TextBox x:Name="txtTrangThai" Text="{Binding TrangThai, Mode=OneWay, Converter={StaticResource StatusTextConverter}}" IsReadOnly="True" Style="{StaticResource DarkTextBox}" MinHeight="36"/>
            <TextBlock Text="Ghi chú" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
            <TextBox x:Name="txtGhiChu" Text="{Binding GhiChu, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource DarkTextBox}" MinHeight="36"/>
            <TextBlock Text="Ngày chấm" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
            <TextBox x:Name="txtNgayChamCong" Text="{Binding NgayChamCong, StringFormat=dd/MM/yyyy HH:mm}" IsReadOnly="True" Style="{StaticResource DarkTextBox}" MinHeight="36"/>
            <TextBlock Text="Ngày/giờ vào" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
            <TextBox x:Name="txtGioVao" Text="{Binding GioVao, StringFormat=dd/MM/yyyy HH:mm}" IsReadOnly="True" Style="{StaticResource DarkTextBox}" MinHeight="36"/>
            <TextBlock Text="Ngày/giờ ra" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
            <TextBox x:Name="txtGioRa" Text="{Binding GioRa, StringFormat=dd/MM/yyyy HH:mm}" IsReadOnly="True" Style="{StaticResource DarkTextBox}" MinHeight="36"/>
        </StackPanel></ScrollViewer>
        <WrapPanel Grid.Row="2" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="btnChamCongSuaThongTin" Content="Sửa" Click="btnSua_Click" Style="{StaticResource SecondaryButton}" Margin="8,4,0,4" MinWidth="100" />
            <Button x:Name="btnChamCongXoa" Content="Xóa" Click="btnXoa_Click" Style="{StaticResource DangerButton}" Margin="8,4,0,4" MinWidth="100" />
            <Button x:Name="btnDong" Content="Đóng" Click="btnDong_Click" Style="{StaticResource SecondaryButton}" Margin="8,4,0,4" MinWidth="100" IsCancel="True"/>
        </WrapPanel>
    </Grid>
</Window>
