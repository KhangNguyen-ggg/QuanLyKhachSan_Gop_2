<Window x:Class="QuanLyKhachSan.Views.Dialogs.LichLamViecChiTietWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="clr-namespace:QuanLyKhachSan.Helpers"
    Title="Chi tiết — Lịch làm việc" Width="760" Height="740" MinWidth="540" MinHeight="400"
    WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource BackgroundBrush}" FontFamily="Segoe UI">
    <Window.Resources><ResourceDictionary>
        <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/QuanLyKhachSan;component/Resources/Styles.xaml"/></ResourceDictionary.MergedDictionaries>
        <helpers:GioConverter x:Key="GioConverter"/>
    </ResourceDictionary></Window.Resources>
    <!-- Bớt: bỏ nút Thêm và khối Sửa/Lưu lặp; nút Sửa dùng lại form nhập có bản nháp. -->
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,14">
            <TextBlock x:Name="txtTieuDe" Text="Chi tiết — Lịch làm việc" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource GoldBrush}" TextWrapping="Wrap"/>
            <TextBlock x:Name="txtThongBao" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,12,0">
            <TextBlock Text="Mã" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
            <TextBox x:Name="txtMa" Text="{Binding MaLich, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource DarkTextBox}" MinHeight="36"/>
            <TextBlock Text="Nhân viên" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
            <TextBox x:Name="txtNhanVien" Text="{Binding NhanVien, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource DarkTextBox}" MinHeight="36"/>
            <TextBlock Text="Ngày làm" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
            <TextBox x:Name="dtpNgayLam" Text="{Binding NgayLam, Mode=OneWay, StringFormat=dd/MM/yyyy}" IsReadOnly="True" Style="{StaticResource DarkTextBox}" MinHeight="36"/>
            <TextBlock Text="Ca làm việc" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
            <TextBox x:Name="txtCa" Text="{Binding Ca, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource DarkTextBox}" MinHeight="36"/>
            <TextBlock Text="Trạng thái" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
            <TextBox x:Name="txtTrangThai" Text="{Binding TrangThai, Mode=OneWay, Converter={StaticResource StatusTextConverter}}" IsReadOnly="True" Style="{StaticResource DarkTextBox}" MinHeight="36"/>
            <TextBlock Text="Ghi chú" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
            <TextBox x:Name="txtGhiChu" Text="{Binding GhiChu, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource DarkTextBox}" MinHeight="36"/>
        </StackPanel></ScrollViewer>
        <WrapPanel Grid.Row="2" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="btnLichLamViecSuaThongTin" Content="Sửa" Click="btnSua_Click" Style="{StaticResource SecondaryButton}" Margin="8,4,0,4" MinWidth="100" />
            <Button x:Name="btnLichLamViecXoa" Content="Xóa" Click="btnXoa_Click" Style="{StaticResource DangerButton}" Margin="8,4,0,4" MinWidth="100" />
            <Button x:Name="btnDong" Content="Đóng" Click="btnDong_Click" Style="{StaticResource SecondaryButton}" Margin="8,4,0,4" MinWidth="100" IsCancel="True"/>
        </WrapPanel>
    </Grid>
</Window>
