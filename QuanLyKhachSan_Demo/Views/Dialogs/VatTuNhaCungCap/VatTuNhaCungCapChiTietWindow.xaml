<Window x:Class="QuanLyKhachSan.Views.Dialogs.VatTuNhaCungCapChiTietWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Chi tiết — Nguồn cung vật tư" Width="820" Height="760" MinWidth="620" MinHeight="450" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
    Background="{StaticResource BackgroundBrush}" FontFamily="Segoe UI">
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/QuanLyKhachSan;component/Resources/Styles.xaml"/>
    </ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,12">
            <TextBlock x:Name="txtTieuDe" Text="Chi tiết — Nguồn cung vật tư" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource GoldBrush}"/>
            <TextBlock x:Name="txtThongBao" TextWrapping="Wrap" Foreground="{StaticResource DangerBrush}" Margin="0,6,0,0" AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,12,0">
<StackPanel x:Name="pnlThongTin">
                <TextBlock Text="Vật tư" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
                <TextBox x:Name="txtVatTu" Style="{StaticResource DarkTextBox}" Text="{Binding VatTu, Mode=OneWay}" IsReadOnly="True" MinHeight="36" Tag="Khoa"/>
                <TextBlock Text="Nhà cung cấp" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
                <TextBox x:Name="txtNhaCungCap" Style="{StaticResource DarkTextBox}" Text="{Binding NhaCungCap, Mode=OneWay}" IsReadOnly="True" MinHeight="36" Tag="Khoa"/>
                <TextBlock Text="Mã sản phẩm NCC" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
                <TextBox x:Name="txtMaSanPhamNCC" Style="{StaticResource DarkTextBox}" Text="{Binding MaSanPhamNCC, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinHeight="36" />
                <TextBlock Text="Giá nhập (tùy chọn)" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
                <TextBox x:Name="txtGiaNhapD" Style="{StaticResource DarkTextBox}" Text="{Binding DonGiaNhap, Mode=OneWay}" MinHeight="36" />
                <TextBlock Text="Ngày cung cấp (tùy chọn)" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
                <DatePicker x:Name="dtpNgay"  SelectedDate="{Binding ThoiGianCungCap, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinHeight="36" />
                <TextBlock Text="Ghi chú" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
                <TextBox x:Name="txtGhiChu" Style="{StaticResource DarkTextBox}" Text="{Binding GhiChu, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinHeight="36" />
                <TextBlock Text="Trạng thái" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
                <ComboBox x:Name="cboTrangThai" Style="{StaticResource DarkComboBox}" MinHeight="36" />
</StackPanel>
        </StackPanel></ScrollViewer>
        <WrapPanel Grid.Row="2" HorizontalAlignment="Right" Margin="0,16,0,0">
<WrapPanel x:Name="pnlThaoTac">
<Button x:Name="btnVatTuNhaCungCapSuaThongTin" Content="Sửa thông tin" Click="btnSua_Click" Style="{StaticResource SecondaryButton}" Margin="8,4,0,4" MinWidth="100"/><Button x:Name="btnVatTuNhaCungCapXoa" Content="Xóa" Click="btnXoa_Click" Style="{StaticResource DangerButton}" Margin="8,4,0,4" MinWidth="100"/></WrapPanel>
<WrapPanel x:Name="pnlLuu" Visibility="Collapsed">
<Button x:Name="btnLuuSua" Content="Lưu thay đổi" Click="btnLuuSua_Click" Style="{StaticResource PrimaryButton}" Margin="8,4,0,4" MinWidth="100"/><Button x:Name="btnHuySua" Content="Hủy sửa" Click="btnHuySua_Click" Style="{StaticResource SecondaryButton}" Margin="8,4,0,4" MinWidth="100"/></WrapPanel>
            <Button x:Name="btnDong" Content="Đóng" Click="btnDong_Click" IsCancel="True" Style="{StaticResource SecondaryButton}" Margin="8,4,0,4" MinWidth="100"/>
        </WrapPanel>
    </Grid>
</Window>
