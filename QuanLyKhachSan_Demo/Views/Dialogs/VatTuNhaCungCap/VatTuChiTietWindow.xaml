<Window x:Class="QuanLyKhachSan.Views.Dialogs.VatTuChiTietWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Chi tiết — Vật tư" Width="820" Height="760" MinWidth="620" MinHeight="450" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
    Background="{StaticResource BackgroundBrush}" FontFamily="Segoe UI">
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/QuanLyKhachSan;component/Resources/Styles.xaml"/>
    </ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,12">
            <TextBlock x:Name="txtTieuDe" Text="Chi tiết — Vật tư" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource GoldBrush}"/>
            <TextBlock x:Name="txtThongBao" TextWrapping="Wrap" Foreground="{StaticResource DangerBrush}" Margin="0,6,0,0" AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,12,0">
<StackPanel x:Name="pnlThongTin">
                <TextBlock Text="Mã vật tư" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
                <TextBox x:Name="txtMaLoaiVatTu" Style="{StaticResource DarkTextBox}" Text="{Binding MaLoaiVatTu, Mode=OneWay}" IsReadOnly="True" MinHeight="36" Tag="Khoa"/>
                <TextBlock Text="Tên vật tư" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
                <TextBox x:Name="txtTenVatTu" Style="{StaticResource DarkTextBox}" Text="{Binding TenVatTu, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinHeight="36" />
                <TextBlock Text="Nhóm vật tư" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
                <ComboBox x:Name="cboNhom" Style="{StaticResource DarkComboBox}" MinHeight="36" />
                <TextBlock Text="Đơn vị tính" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
                <TextBox x:Name="txtDonVi" Style="{StaticResource DarkTextBox}" Text="{Binding DonViTinh, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinHeight="36" />
                <TextBlock Text="Kho mặc định (có thể bỏ trống)" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
                <ComboBox x:Name="cboKho" Style="{StaticResource DarkComboBox}" MinHeight="36" />
                <TextBlock Text="Tồn tối thiểu (tối đa 4 số lẻ)" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
                <TextBox x:Name="txtTonToiThieu" Style="{StaticResource DarkTextBox}" Text="{Binding SoLuongToiThieu, Mode=OneWay}" MinHeight="36" />
                <TextBlock Text="Mô tả" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
                <TextBox x:Name="txtGhiChu" Style="{StaticResource DarkTextBox}" Text="{Binding MoTa, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinHeight="36" />
                <TextBlock Text="Trạng thái" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
                <ComboBox x:Name="cboTrangThai" Style="{StaticResource DarkComboBox}" MinHeight="36" />
</StackPanel>
        </StackPanel></ScrollViewer>
        <WrapPanel Grid.Row="2" HorizontalAlignment="Right" Margin="0,16,0,0">
<WrapPanel x:Name="pnlThaoTac">
<Button x:Name="btnVatTuSuaThongTin" Content="Sửa thông tin" Click="btnSua_Click" Style="{StaticResource SecondaryButton}" Margin="8,4,0,4" MinWidth="100"/><Button x:Name="btnVatTuXoa" Content="Xóa" Click="btnXoa_Click" Style="{StaticResource DangerButton}" Margin="8,4,0,4" MinWidth="100"/></WrapPanel>
<WrapPanel x:Name="pnlLuu" Visibility="Collapsed">
<Button x:Name="btnLuuSua" Content="Lưu thay đổi" Click="btnLuuSua_Click" Style="{StaticResource PrimaryButton}" Margin="8,4,0,4" MinWidth="100"/><Button x:Name="btnHuySua" Content="Hủy sửa" Click="btnHuySua_Click" Style="{StaticResource SecondaryButton}" Margin="8,4,0,4" MinWidth="100"/></WrapPanel>
            <Button x:Name="btnDong" Content="Đóng" Click="btnDong_Click" IsCancel="True" Style="{StaticResource SecondaryButton}" Margin="8,4,0,4" MinWidth="100"/>
        </WrapPanel>
    </Grid>
</Window>
