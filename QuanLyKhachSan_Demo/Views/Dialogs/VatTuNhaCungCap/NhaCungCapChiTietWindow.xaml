<Window x:Class="QuanLyKhachSan.Views.Dialogs.NhaCungCapChiTietWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Chi tiết — Nhà cung cấp" Width="820" Height="760" MinWidth="620" MinHeight="450" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
    Background="{StaticResource BackgroundBrush}" FontFamily="Segoe UI">
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/QuanLyKhachSan;component/Resources/Styles.xaml"/>
    </ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,12">
            <TextBlock x:Name="txtTieuDe" Text="Chi tiết — Nhà cung cấp" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource GoldBrush}"/>
            <TextBlock x:Name="txtThongBao" TextWrapping="Wrap" Foreground="{StaticResource DangerBrush}" Margin="0,6,0,0" AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,12,0">
<StackPanel x:Name="pnlThongTin">
                <TextBlock Text="Mã nhà cung cấp" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
                <TextBox x:Name="txtMaNhaCungCap" Style="{StaticResource DarkTextBox}" Text="{Binding MaNhaCungCap, Mode=OneWay}" IsReadOnly="True" MinHeight="36" Tag="Khoa"/>
                <TextBlock Text="Tên nhà cung cấp" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
                <TextBox x:Name="txtTenNhaCungCap" Style="{StaticResource DarkTextBox}" Text="{Binding TenNhaCungCap, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinHeight="36" />
                <TextBlock Text="Người đại diện" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
                <TextBox x:Name="txtNguoiDaiDien" Style="{StaticResource DarkTextBox}" Text="{Binding NguoiDaiDien, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinHeight="36" />
                <TextBlock Text="Điện thoại" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
                <TextBox x:Name="txtDienThoai" Style="{StaticResource DarkTextBox}" Text="{Binding SoDienThoai, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinHeight="36" />
                <TextBlock Text="Email" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
                <TextBox x:Name="txtEmail" Style="{StaticResource DarkTextBox}" Text="{Binding Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinHeight="36" />
                <TextBlock Text="Địa chỉ" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
                <TextBox x:Name="txtDiaChi" Style="{StaticResource DarkTextBox}" Text="{Binding DiaChi, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinHeight="36" />
                <TextBlock Text="Loại cung cấp" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
                <TextBox x:Name="txtLoaiCungCap" Style="{StaticResource DarkTextBox}" Text="{Binding LoaiCungCap, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinHeight="36" />
                <TextBlock Text="Ghi chú" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
                <TextBox x:Name="txtGhiChu" Style="{StaticResource DarkTextBox}" Text="{Binding GhiChu, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinHeight="36" />
                <TextBlock Text="Trạng thái" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
                <ComboBox x:Name="cboTrangThai" Style="{StaticResource DarkComboBox}" MinHeight="36" />
</StackPanel>
<StackPanel x:Name="pnlLienKet"><TextBlock Text="Vật tư do nhà cung cấp này cung cấp" FontSize="18" Foreground="{StaticResource GoldBrush}" Margin="0,20,0,8"/>
<Button x:Name="btnVatTuNhaCungCapThemMoi" Content="Thêm vật tư" Click="btnNguonCung_Click" Style="{StaticResource PrimaryButton}" Margin="8,4,0,4" MinWidth="100"/><DataGrid x:Name="dgvVatTuNhaCungCap" MouseDoubleClick="NguonCung_DoubleClick" Style="{StaticResource DarkDataGrid}" CellStyle="{StaticResource DarkDataGridCell}" RowStyle="{StaticResource DarkDataGridRow}" ColumnHeaderStyle="{StaticResource DarkColumnHeader}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MinHeight="180" MaxHeight="340" Margin="0,14,0,0">
<DataGrid.Columns>
<DataGridTextColumn Header="Vật tư" Binding="{Binding VatTu}" Width="*" MinWidth="110"/>
<DataGridTextColumn Header="Mã NCC" Binding="{Binding MaSanPhamNCC}" Width="*" MinWidth="110"/>
<DataGridTextColumn Header="Giá nhập" Binding="{Binding DonGiaNhap, Converter={StaticResource VndConverter}}" Width="*" MinWidth="110"/>
<DataGridTextColumn Header="Trạng thái" Binding="{Binding TrangThai, Converter={StaticResource BoolToStatusConverter}, ConverterParameter=Text}" Width="*" MinWidth="110"/>
</DataGrid.Columns></DataGrid>
</StackPanel>
        </StackPanel></ScrollViewer>
        <WrapPanel Grid.Row="2" HorizontalAlignment="Right" Margin="0,16,0,0">
<WrapPanel x:Name="pnlThaoTac">
<Button x:Name="btnNhaCungCapSuaThongTin" Content="Sửa thông tin" Click="btnSua_Click" Style="{StaticResource SecondaryButton}" Margin="8,4,0,4" MinWidth="100"/><Button x:Name="btnNhaCungCapXoa" Content="Xóa" Click="btnXoa_Click" Style="{StaticResource DangerButton}" Margin="8,4,0,4" MinWidth="100"/></WrapPanel>
<WrapPanel x:Name="pnlLuu" Visibility="Collapsed">
<Button x:Name="btnLuuSua" Content="Lưu thay đổi" Click="btnLuuSua_Click" Style="{StaticResource PrimaryButton}" Margin="8,4,0,4" MinWidth="100"/><Button x:Name="btnHuySua" Content="Hủy sửa" Click="btnHuySua_Click" Style="{StaticResource SecondaryButton}" Margin="8,4,0,4" MinWidth="100"/></WrapPanel>
            <Button x:Name="btnDong" Content="Đóng" Click="btnDong_Click" IsCancel="True" Style="{StaticResource SecondaryButton}" Margin="8,4,0,4" MinWidth="100"/>
        </WrapPanel>
    </Grid>
</Window>
