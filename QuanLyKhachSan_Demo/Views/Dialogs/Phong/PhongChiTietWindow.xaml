<Window x:Class="QuanLyKhachSan.Views.Dialogs.PhongChiTietWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Chi tiết phòng" Width="700" Height="700" MinWidth="540" MinHeight="400"
    WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
    Background="{StaticResource BackgroundBrush}" FontFamily="Segoe UI">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/QuanLyKhachSan;component/Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <!-- Bố cục cố định: tiêu đề, vùng nhập cuộn, hàng nút phía dưới. -->
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock x:Name="txtTieuDe" Text="Chi tiết phòng" FontSize="22" FontWeight="SemiBold"
                       Foreground="{StaticResource GoldBrush}" TextWrapping="Wrap"/>
            </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,12,0">
                <TextBlock Text="Mã" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
                <TextBlock x:Name="txtMa" Text="{Binding Ma}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="15" TextWrapping="Wrap"/>
                <TextBlock Text="Số phòng" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
                <TextBlock x:Name="txtSoPhong" Text="{Binding SoPhong}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="15" TextWrapping="Wrap"/>
                <TextBlock Text="Loại phòng" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
                <TextBlock x:Name="txtLoaiPhong" Text="{Binding LoaiPhong}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="15" TextWrapping="Wrap"/>
                <TextBlock Text="Tầng" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
                <TextBlock x:Name="txtTang" Text="{Binding Tang}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="15" TextWrapping="Wrap"/>
                <TextBlock Text="Sức chứa" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
                <TextBlock x:Name="txtSucChua" Text="{Binding SucChua}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="15" TextWrapping="Wrap"/>
                <TextBlock Text="Giá / đêm" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
                <TextBlock x:Name="txtGiaDem" Text="{Binding GiaDem}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="15" TextWrapping="Wrap"/>
                <TextBlock Text="Tình trạng" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
                <TextBlock x:Name="txtTinhTrang" Text="{Binding TinhTrang}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="15"/>
                <TextBlock Text="Vệ sinh" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
                <TextBlock x:Name="txtVeSinh" Text="{Binding VeSinh}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="15" TextWrapping="Wrap"/>
                <TextBlock Text="Khai thác" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
                <TextBlock x:Name="txtKhaiThac" Text="{Binding KhaiThac}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="15" TextWrapping="Wrap"/>

            </StackPanel>
        </ScrollViewer>
        <WrapPanel Grid.Row="2" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="btnPhongSuaThongTin" Content="Sửa thông tin" Click="btnPhongSuaThongTin_Click" Style="{StaticResource SecondaryButton}" Margin="0,4,8,4"/>
            <Button x:Name="btnTinhTrangPhongCapNhatTinhTrang" Content="Cập nhật tình trạng" Click="btnTinhTrangPhongCapNhatTinhTrang_Click" Style="{StaticResource PrimaryButton}" Margin="0,4,8,4"/>
            <Button x:Name="btnPhongXoa" Content="Xóa" Click="btnPhongXoa_Click" Style="{StaticResource DangerButton}" Margin="0,4,8,4"/>
            <Button x:Name="btnDong" Content="Đóng" Style="{StaticResource SecondaryButton}"
                    Click="btnDong_Click" IsCancel="True" MinWidth="100" Margin="0,4,0,4"/>

        </WrapPanel>
    </Grid>
</Window>
