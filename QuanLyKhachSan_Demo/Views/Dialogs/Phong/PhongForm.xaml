<Window x:Class="QuanLyKhachSan.Views.Dialogs.PhongForm"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Thông tin danh sách phòng" Width="700" Height="700" MinWidth="540" MinHeight="400"
    WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
    Background="{StaticResource BackgroundBrush}" FontFamily="Segoe UI">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/QuanLyKhachSan;component/Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <!-- Bố cục cố định: tiêu đề, vùng nhập cuộn, hàng nút phía dưới. -->
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock x:Name="txtTieuDe" Text="Thông tin danh sách phòng" FontSize="22" FontWeight="SemiBold"
                       Foreground="{StaticResource GoldBrush}" TextWrapping="Wrap"/>
            </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,12,0">
                <TextBlock Text="Số phòng" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5"/>
                <TextBox x:Name="txtSoPhong" Text="201" Style="{StaticResource DarkTextBox}" MinHeight="38"/>
                <TextBlock Text="Loại phòng" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5"/>
                <ComboBox x:Name="cboLoaiPhong" Style="{StaticResource DarkComboBox}" SelectedIndex="0" MinHeight="36">
                    <ComboBoxItem Style="{StaticResource ReadableComboBoxItem}" Content="Deluxe"/>
                    <ComboBoxItem Style="{StaticResource ReadableComboBoxItem}" Content="Standard"/>
                    <ComboBoxItem Style="{StaticResource ReadableComboBoxItem}" Content="Suite"/>
                </ComboBox>
                <TextBlock Text="Tầng" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5"/>
                <ComboBox x:Name="cboTang" Style="{StaticResource DarkComboBox}" SelectedIndex="0" MinHeight="36">
                    <ComboBoxItem Style="{StaticResource ReadableComboBoxItem}" Content="Tầng 2 — Tòa A"/>
                    <ComboBoxItem Style="{StaticResource ReadableComboBoxItem}" Content="Tầng 3 — Tòa A"/>
                    <ComboBoxItem Style="{StaticResource ReadableComboBoxItem}" Content="Tầng 1 — Tòa B"/>
                </ComboBox>
                <StackPanel x:Name="pnlThongTinBoSung"><TextBlock Text="View" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5"/>
                <ComboBox x:Name="cboView" Style="{StaticResource DarkComboBox}" SelectedIndex="0" MinHeight="36">
                    <ComboBoxItem Style="{StaticResource ReadableComboBoxItem}" Content="Hướng biển"/>
                    <ComboBoxItem Style="{StaticResource ReadableComboBoxItem}" Content="Thành phố"/>
                    <ComboBoxItem Style="{StaticResource ReadableComboBoxItem}" Content="Sân vườn"/>
                </ComboBox>
                <TextBlock Text="Không hút thuốc" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5"/>
                <CheckBox x:Name="chkKhongHutThuoc" Content="Phòng không hút thuốc" IsChecked="True" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,6"/></StackPanel>
                <TextBlock Text="Vệ sinh" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5"/>
                <ComboBox x:Name="cboVeSinh" Style="{StaticResource DarkComboBox}" SelectedIndex="0" MinHeight="36">
                    <ComboBoxItem Style="{StaticResource ReadableComboBoxItem}" Content="Sạch"/>
                    <ComboBoxItem Style="{StaticResource ReadableComboBoxItem}" Content="Cần dọn"/>
                    <ComboBoxItem Style="{StaticResource ReadableComboBoxItem}" Content="Đang dọn"/>
                </ComboBox>
                <TextBlock Text="Trạng thái" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5"/>
                <ComboBox x:Name="cboKhaiThac" Style="{StaticResource DarkComboBox}" SelectedIndex="0" MinHeight="36">
                    <ComboBoxItem Style="{StaticResource ReadableComboBoxItem}" Content="Đang hoạt động"/>
                    <ComboBoxItem Style="{StaticResource ReadableComboBoxItem}" Content="Bảo trì"/>
                    <ComboBoxItem Style="{StaticResource ReadableComboBoxItem}" Content="Ngừng khai thác"/>
                </ComboBox>
                <TextBlock Text="Ghi chú" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,5"/>
                <TextBox x:Name="txtGhiChu" Text="" Style="{StaticResource DarkTextBox}" MinHeight="90" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
            <TextBlock x:Name="txtThongBao" Foreground="{StaticResource DangerBrush}" Margin="0,12,0,0" TextWrapping="Wrap"/></StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="btnDong" Content="Đóng" Style="{StaticResource SecondaryButton}"
                    Click="btnDong_Click" IsCancel="True" MinWidth="100"/>
            <Button x:Name="btnLuu" Content="Xác nhận" Style="{StaticResource PrimaryButton}"
                    Click="btnLuu_Click" MinWidth="140" Margin="8,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
