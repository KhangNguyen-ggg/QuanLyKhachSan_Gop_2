<Window x:Class="QuanLyKhachSan.Views.Dialogs.TinhTrangPhongChiTietWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Chi tiết — Tình trạng phòng" Width="700" Height="700" MinWidth="540" MinHeight="400"
    WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
    Background="{StaticResource BackgroundBrush}" FontFamily="Segoe UI">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/QuanLyKhachSan;component/Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <!-- Bố cục cố định: tiêu đề, vùng nhập cuộn, hàng nút phía dưới. -->
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock x:Name="txtTieuDe" Text="Chi tiết — Tình trạng phòng" FontSize="22" FontWeight="SemiBold"
                       Foreground="{StaticResource GoldBrush}" TextWrapping="Wrap"/>
            </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,12,0">
                <TextBlock Text="Phòng" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
                <TextBlock Text="201" Foreground="{StaticResource TextPrimaryBrush}" FontSize="15" TextWrapping="Wrap"/>
                <TextBlock Text="Tình trạng" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
                <TextBlock Text="Đang ở" Foreground="{StaticResource TextPrimaryBrush}" FontSize="15" TextWrapping="Wrap"/>
                <TextBlock Text="Khách / đặt phòng" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
                <TextBlock Text="Nguyễn Minh Anh / DP001" Foreground="{StaticResource TextPrimaryBrush}" FontSize="15" TextWrapping="Wrap"/>
                <TextBlock Text="Nhận phòng" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
                <TextBlock Text="27/09/2026" Foreground="{StaticResource TextPrimaryBrush}" FontSize="15" TextWrapping="Wrap"/>
                <TextBlock Text="Trả phòng" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
                <TextBlock Text="29/09/2026" Foreground="{StaticResource TextPrimaryBrush}" FontSize="15" TextWrapping="Wrap"/>
                <TextBlock Text="Vệ sinh" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
                <TextBlock Text="Sạch" Foreground="{StaticResource TextPrimaryBrush}" FontSize="15" TextWrapping="Wrap"/>

            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="btnDong" Content="Đóng" Style="{StaticResource SecondaryButton}"
                    Click="btnDong_Click" IsCancel="True" MinWidth="100"/>

        </StackPanel>
    </Grid>
</Window>
