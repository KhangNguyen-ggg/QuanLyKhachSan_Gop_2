<UserControl x:Class="QuanLyKhachSan.Views.TieuHaoView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource BackgroundBrush}" FontFamily="Segoe UI">
    <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/QuanLyKhachSan;component/Resources/Styles.xaml"/>
    </ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
    <!-- Bớt dữ liệu mẫu; danh sách lấy SQL khi Loaded, tìm/lọc và sau mỗi lần lưu. -->
    <TabControl x:Name="tabChinh" Style="{StaticResource DarkTabControl}">
        <TabItem x:Name="tabDinhMucTieuHao" Header="Định mức tiêu hao" Style="{StaticResource DarkTabItem}">
            <Grid Margin="0,14,0,0">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><StackPanel Orientation="Horizontal">
            <Button x:Name="btnDinhMucTieuHaoThemMoi" Content="Thêm định mức" Click="btnDinhMucTieuHaoThemMoi_Click" Style="{StaticResource PrimaryButton}" Margin="8,4,0,4" MinWidth="100"/>
                        <TextBox x:Name="txtTimDinhMucTieuHao" Width="220" Style="{StaticResource DarkTextBox}" Margin="8,4" ToolTip="Tìm không dấu: chữ, số và khoảng trắng"/>
                        <ComboBox x:Name="cboLocDinhMucTieuHao" Width="190" Style="{StaticResource DarkComboBox}" Margin="0,4,8,4"/>
            <Button x:Name="btnTimDinhMucTieuHao" Content="Tìm kiếm" Click="btnTimDinhMucTieuHao_Click" Style="{StaticResource SecondaryButton}" Margin="8,4,0,4" MinWidth="100"/>
            <Button x:Name="btnMoiDinhMucTieuHao" Content="Làm mới" Click="btnMoiDinhMucTieuHao_Click" Style="{StaticResource SecondaryButton}" Margin="8,4,0,4" MinWidth="100"/>
                    </StackPanel></ScrollViewer>
                    <TextBlock x:Name="txtLoiTimDinhMucTieuHao" Text="Chỉ nhập chữ, số và khoảng trắng." Foreground="{StaticResource DangerBrush}" Visibility="Collapsed" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>
                <DataGrid x:Name="dgvDinhMucTieuHao" MouseDoubleClick="DinhMucTieuHao_DoubleClick" Style="{StaticResource DarkDataGrid}" CellStyle="{StaticResource DarkDataGridCell}" RowStyle="{StaticResource DarkDataGridRow}" ColumnHeaderStyle="{StaticResource DarkColumnHeader}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Grid.Row="1" MinHeight="180" Margin="0,10,0,0">
                <DataGrid.Columns>
                <DataGridTextColumn Header="Dịch vụ" Binding="{Binding DichVu}" Width="*" MinWidth="110"/>
                <DataGridTextColumn Header="Vật tư" Binding="{Binding VatTu}" Width="*" MinWidth="110"/>
                <DataGridTextColumn Header="Số lượng mỗi lần" Binding="{Binding SoLuongTieuHao}" Width="*" MinWidth="110"/>
                <DataGridTextColumn Header="Đơn vị" Binding="{Binding DonVi}" Width="*" MinWidth="110"/>
                <DataGridTextColumn Header="Ghi chú" Binding="{Binding GhiChu}" Width="*" MinWidth="110"/>
                </DataGrid.Columns></DataGrid>

                <TextBlock x:Name="txtThongBaoDinhMucTieuHao" Grid.Row="2" Text="Nhấp đúp để xem chi tiết." TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,0"/>
            </Grid>
        </TabItem>
        <TabItem x:Name="tabCapVatTuNoiBo" Header="Cấp vật tư nội bộ" Style="{StaticResource DarkTabItem}">
            <Grid Margin="0,14,0,0">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><StackPanel Orientation="Horizontal">
            <Button x:Name="btnCapVatTuNoiBoTaoPhieuCap" Content="Tạo phiếu cấp" Click="btnCapVatTuNoiBoTaoPhieuCap_Click" Style="{StaticResource PrimaryButton}" Margin="8,4,0,4" MinWidth="100"/>
                        <TextBox x:Name="txtTimCapVatTuNoiBo" Width="220" Style="{StaticResource DarkTextBox}" Margin="8,4" ToolTip="Tìm không dấu: chữ, số và khoảng trắng"/>
                        <ComboBox x:Name="cboLocCapVatTuNoiBo" Width="190" Style="{StaticResource DarkComboBox}" Margin="0,4,8,4"/>
            <Button x:Name="btnTimCapVatTuNoiBo" Content="Tìm kiếm" Click="btnTimCapVatTuNoiBo_Click" Style="{StaticResource SecondaryButton}" Margin="8,4,0,4" MinWidth="100"/>
            <Button x:Name="btnMoiCapVatTuNoiBo" Content="Làm mới" Click="btnMoiCapVatTuNoiBo_Click" Style="{StaticResource SecondaryButton}" Margin="8,4,0,4" MinWidth="100"/>
                    </StackPanel></ScrollViewer>
                    <TextBlock x:Name="txtLoiTimCapVatTuNoiBo" Text="Chỉ nhập chữ, số và khoảng trắng." Foreground="{StaticResource DangerBrush}" Visibility="Collapsed" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>
                <DataGrid x:Name="dgvCapVatTuNoiBo" MouseDoubleClick="CapVatTuNoiBo_DoubleClick" Style="{StaticResource DarkDataGrid}" CellStyle="{StaticResource DarkDataGridCell}" RowStyle="{StaticResource DarkDataGridRow}" ColumnHeaderStyle="{StaticResource DarkColumnHeader}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Grid.Row="1" MinHeight="180" Margin="0,10,0,0">
                <DataGrid.Columns>
                <DataGridTextColumn Header="Mã phiếu" Binding="{Binding MaPhieuCap}" Width="*" MinWidth="110"/>
                <DataGridTextColumn Header="Mục đích" Binding="{Binding MucDich, Converter={StaticResource StatusTextConverter}}" Width="*" MinWidth="110"/>
                <DataGridTextColumn Header="Tham chiếu" Binding="{Binding ThamChieu}" Width="*" MinWidth="110"/>
                <DataGridTextColumn Header="Kho" Binding="{Binding Kho}" Width="*" MinWidth="110"/>
                <DataGridTextColumn Header="Nhân viên" Binding="{Binding NhanVien}" Width="*" MinWidth="110"/>
                <DataGridTextColumn Header="Số vật tư" Binding="{Binding SoDong}" Width="*" MinWidth="110"/>
                <DataGridTextColumn Header="Tổng lượng" Binding="{Binding TongSoLuong}" Width="*" MinWidth="110"/>
                <DataGridTextColumn Header="Ngày cấp" Binding="{Binding NgayCap, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="*" MinWidth="110"/>
                <DataGridTextColumn Header="Trạng thái" Binding="{Binding TrangThai, Converter={StaticResource StatusTextConverter}}" Width="*" MinWidth="110"/>
                </DataGrid.Columns></DataGrid>

                <TextBlock x:Name="txtThongBaoCapVatTuNoiBo" Grid.Row="2" Text="Nhấp đúp để xem chi tiết." TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,0"/>
            </Grid>
        </TabItem>
    </TabControl>
</UserControl>
