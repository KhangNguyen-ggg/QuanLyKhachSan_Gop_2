<UserControl x:Class="QuanLyKhachSan.Views.PhanBoPhongView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mau="clr-namespace:QuanLyKhachSan.Data"
    mc:Ignorable="d"
    d:DesignHeight="720" d:DesignWidth="1120"
    Background="{StaticResource BackgroundBrush}" FontFamily="Segoe UI">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/QuanLyKhachSan;component/Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="0,14,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="txtDonDangChon" Grid.Row="0" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource GoldBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <ScrollViewer Grid.Row="1" Margin="0,6,0,14" HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="btnPhanBoPhongThemPhong" Content="Chọn phòng" Click="btnPhanBoPhongThemPhong_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8"/>
                <TextBox x:Name="txtTimPhanBoPhong" Width="220" Style="{StaticResource DarkTextBox}" ToolTip="Từ khóa tìm kiếm" Margin="0,0,8,8"/>
                <ComboBox x:Name="cboLocPhanBoPhong" Width="190" SelectedValuePath="Tag" SelectedIndex="0" Style="{StaticResource DarkComboBox}" Margin="0,0,8,8">
                    <ComboBoxItem Style="{StaticResource ReadableComboBoxItem}" Content="Tất cả trạng thái" Tag=""/>
                    <ComboBoxItem Style="{StaticResource ReadableComboBoxItem}" Content="Đang ở" Tag="DaCheckIn"/>
                    <ComboBoxItem Style="{StaticResource ReadableComboBoxItem}" Content="Đã phân bổ" Tag="DaXep"/>
                </ComboBox>
                <Button x:Name="btnTimPhanBoPhong" Content="Tìm kiếm" Click="btnTimPhanBoPhong_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"/>
                <Button x:Name="btnMoiPhanBoPhong" Content="Làm mới" Click="btnMoiPhanBoPhong_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,0,8"/>
            </StackPanel>
        </ScrollViewer>
        <DataGrid Grid.Row="2" x:Name="dgvPhanBoPhong" MouseDoubleClick="PhanBoPhong_DoubleClick" Style="{StaticResource DarkDataGrid}"
                  CellStyle="{StaticResource DarkDataGridCell}" RowStyle="{StaticResource DarkDataGridRow}"
                  ColumnHeaderStyle="{StaticResource DarkColumnHeader}" IsReadOnly="True" SelectedIndex="0"
                  SelectedValuePath="MaXepPhong" AutoGenerateColumns="False" CanUserAddRows="False" MinHeight="180">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Đặt phòng" Binding="{Binding MaDatPhong}" Width="*" MinWidth="110"/>
                <DataGridTextColumn Header="Phòng" Binding="{Binding SoPhong}" Width="*" MinWidth="110"/>
                <DataGridTextColumn Header="Loại phòng" Binding="{Binding TenLoaiPhong}" Width="*" MinWidth="110"/>
                <DataGridTextColumn Header="Người lớn" Binding="{Binding NguoiLon}" Width="*" MinWidth="110"/>
                <DataGridTextColumn Header="Trẻ em" Binding="{Binding TreEm}" Width="*" MinWidth="110"/>
                <DataGridTextColumn Header="Giá áp dụng" Binding="{Binding DonGiaDuKien}" Width="*" MinWidth="110"/>
                <DataGridTextColumn Header="Trạng thái" Binding="{Binding TrangThai, Converter={StaticResource StatusTextConverter}}" Width="*" MinWidth="110"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="3" Text=" Nhấp đúp để xem chi tiết"
                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,0" TextWrapping="Wrap"/>
    </Grid>
</UserControl>
