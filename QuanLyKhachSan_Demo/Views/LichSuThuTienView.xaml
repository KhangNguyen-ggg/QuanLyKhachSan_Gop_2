<UserControl x:Class="QuanLyKhachSan.Views.LichSuThuTienView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:mau="clr-namespace:QuanLyKhachSan.Data"
    d:DesignWidth="1120" d:DesignHeight="720"
    Background="{StaticResource BackgroundBrush}" FontFamily="Segoe UI">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/QuanLyKhachSan;component/Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="0,14,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" Margin="0,6,0,14" HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="txtTimLichSuThuTien" Width="220" Style="{StaticResource DarkTextBox}" ToolTip="Từ khóa tìm kiếm" Margin="0,0,8,8"/>
                <ComboBox x:Name="cboLocLichSuThuTien" Width="190" SelectedValuePath="Tag" SelectedIndex="0" Style="{StaticResource DarkComboBox}" Margin="0,0,8,8">
                    <ComboBoxItem Style="{StaticResource ReadableComboBoxItem}" Content="Tất cả dữ liệu" Tag=""/>
                </ComboBox>
                <Button x:Name="btnTimLichSuThuTien" Content="Tìm kiếm" Click="btnTimLichSuThuTien_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"/>
                <Button x:Name="btnMoiLichSuThuTien" Content="Làm mới" Click="btnMoiLichSuThuTien_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,0,8"/>
            </StackPanel>
        </ScrollViewer>
        <DataGrid Grid.Row="1" x:Name="dgvLichSuThuTien" MouseDoubleClick="LichSuThuTien_DoubleClick" Style="{StaticResource DarkDataGrid}"
                  CellStyle="{StaticResource DarkDataGridCell}" RowStyle="{StaticResource DarkDataGridRow}"
                  ColumnHeaderStyle="{StaticResource DarkColumnHeader}" IsReadOnly="True" SelectedIndex="0"
                  SelectedValuePath="MaThanhToan" AutoGenerateColumns="False" CanUserAddRows="False" MinHeight="180">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Phiếu thu" Binding="{Binding MaThanhToan}" Width="*" MinWidth="110"/>
                <DataGridTextColumn Header="Hóa đơn" Binding="{Binding MaHoaDon}" Width="*" MinWidth="110"/>
                <DataGridTextColumn Header="Thời điểm" Binding="{Binding ThoiGianThanhToan}" Width="*" MinWidth="110"/>
                <DataGridTextColumn Header="Số tiền" Binding="{Binding SoTien}" Width="*" MinWidth="110"/>
                <DataGridTextColumn Header="Người thu" Binding="{Binding HoTen}" Width="*" MinWidth="110"/>
                <DataGridTextColumn Header="Ghi chú" Binding="{Binding GhiChu}" Width="*" MinWidth="110"/>
            <DataGridTemplateColumn Header="Phương thức" Width="*" MinWidth="110"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="Tiền mặt" ToolTip="Thông tin hiển thị của chức năng này" Foreground="{StaticResource TextPrimaryBrush}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
</DataGrid.Columns></DataGrid>

        <TextBlock Grid.Row="2" Text="Nhấp đúp để xem chi tiết"
                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,0" TextWrapping="Wrap"/>
    </Grid>
</UserControl>
