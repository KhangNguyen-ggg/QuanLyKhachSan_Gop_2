<UserControl x:Class="QuanLyKhachSan.Views.TaiKhoanView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:mau="clr-namespace:QuanLyKhachSan.Data"
    d:DesignWidth="1120" d:DesignHeight="720"
    Background="{StaticResource BackgroundBrush}" FontFamily="Segoe UI">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/QuanLyKhachSan;component/Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <!-- Mở file này bằng Designer. Mọi tab, nút và bảng đều khai báo cố định. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
<TabControl x:Name="tabChinh" Grid.Row="1" Style="{StaticResource DarkTabControl}">
            <TabItem x:Name="tabTaiKhoan" Header="Tài khoản" Style="{StaticResource DarkTabItem}">
                <Grid Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ScrollViewer Grid.Row="0" Margin="0,6,0,14" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Focusable="False">
                        <StackPanel Orientation="Horizontal">


                            <Button x:Name="btnTaiKhoanThemTaiKhoan" Content="Thêm tài khoản" Click="btnTaiKhoanThemTaiKhoan_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8"/>







                            <TextBox x:Name="txtTimTaiKhoan" Width="220" Style="{StaticResource DarkTextBox}" ToolTip="Từ khóa tìm kiếm" Margin="0,0,8,8"/>
                            <ComboBox x:Name="cboLocTaiKhoan" Width="190" SelectedValuePath="Tag" SelectedIndex="0" Style="{StaticResource DarkComboBox}" Margin="0,0,8,8">
                                <ComboBoxItem Style="{StaticResource ReadableComboBoxItem}" Content="Tất cả trạng thái" Tag=""/>
                                <ComboBoxItem Style="{StaticResource ReadableComboBoxItem}" Content="Hoạt động" Tag="HoatDong"/>
                                <ComboBoxItem Style="{StaticResource ReadableComboBoxItem}" Content="Đã khóa" Tag="Khoa"/>
                            </ComboBox>
                            <Button x:Name="btnTimTaiKhoan" Content="Tìm kiếm" Click="btnTimTaiKhoan_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"/>
                            <Button x:Name="btnMoiTaiKhoan" Content="Làm mới" Click="btnMoiTaiKhoan_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,0,8"/>


                        </StackPanel>
                    </ScrollViewer>
                    <DataGrid Grid.Row="1" x:Name="dgvTaiKhoan" MouseDoubleClick="TaiKhoan_DoubleClick" Style="{StaticResource DarkDataGrid}"
                              CellStyle="{StaticResource DarkDataGridCell}" RowStyle="{StaticResource DarkDataGridRow}"
                              ColumnHeaderStyle="{StaticResource DarkColumnHeader}" IsReadOnly="True" SelectedIndex="0"
                              AutoGenerateColumns="False" CanUserAddRows="False" MinHeight="180">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mã" Binding="{Binding MaTaiKhoan}" Width="*" MinWidth="110"/>
                            <DataGridTextColumn Header="Nhân viên" Binding="{Binding HoTen}" Width="*" MinWidth="110"/>
                            <DataGridTextColumn Header="Tên đăng nhập" Binding="{Binding TenDangNhap}" Width="*" MinWidth="110"/>
                            <DataGridTextColumn Header="Vai trò" Binding="{Binding TenVaiTro}" Width="*" MinWidth="110"/>
                            <DataGridTextColumn Header="Trạng thái" Binding="{Binding TrangThai, Converter={StaticResource StatusTextConverter}}" Width="*" MinWidth="110"/>
                            <DataGridTextColumn Header="Đăng nhập gần nhất" Binding="{Binding LanDangNhapCuoi}" Width="*" MinWidth="110"/>
                        </DataGrid.Columns>
                        <!-- Dữ liệu minh họa khai báo trực tiếp trong XAML. -->
                    </DataGrid>

                    <TextBlock x:Name="txtDataMode" Grid.Row="2" Text="Nhấp đúp để xem chi tiết"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,0" TextWrapping="Wrap"/>
                </Grid>
            </TabItem>
            <TabItem x:Name="tabVaiTroQuyen" Header="Vai trò &amp; quyền" Style="{StaticResource DarkTabItem}">
                <Grid Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ScrollViewer Grid.Row="0" Margin="0,6,0,14" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Focusable="False">
                        <StackPanel Orientation="Horizontal">


                            <Button x:Name="btnVaiTroQuyenThemVaiTro" Content="Thêm vai trò" Click="btnVaiTroQuyenThemVaiTro_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8"/>





                            <TextBox x:Name="txtTimVaiTroQuyen" Width="220" Style="{StaticResource DarkTextBox}" ToolTip="Từ khóa tìm kiếm" Margin="0,0,8,8"/>
                            <ComboBox x:Name="cboLocVaiTroQuyen" Width="190" SelectedValuePath="Tag" SelectedIndex="0" Style="{StaticResource DarkComboBox}" Margin="0,0,8,8">
                                <ComboBoxItem Style="{StaticResource ReadableComboBoxItem}" Content="Tất cả trạng thái" Tag=""/>
                                <ComboBoxItem Style="{StaticResource ReadableComboBoxItem}" Content="Đang hoạt động" Tag="True"/>
                            </ComboBox>
                            <Button x:Name="btnTimVaiTroQuyen" Content="Tìm kiếm" Click="btnTimVaiTroQuyen_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"/>
                            <Button x:Name="btnMoiVaiTroQuyen" Content="Làm mới" Click="btnMoiVaiTroQuyen_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,0,8"/>


                        </StackPanel>
                    </ScrollViewer>
                    <DataGrid Grid.Row="1" x:Name="dgvVaiTroQuyen" MouseDoubleClick="VaiTroQuyen_DoubleClick" Style="{StaticResource DarkDataGrid}"
                              CellStyle="{StaticResource DarkDataGridCell}" RowStyle="{StaticResource DarkDataGridRow}"
                              ColumnHeaderStyle="{StaticResource DarkColumnHeader}" IsReadOnly="True" SelectedIndex="0"
                              AutoGenerateColumns="False" CanUserAddRows="False" MinHeight="180">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mã" Binding="{Binding MaVaiTro}" Width="*" MinWidth="110"/>
                            <DataGridTextColumn Header="Tên vai trò" Binding="{Binding TenVaiTro}" Width="*" MinWidth="110"/>
                            <DataGridTextColumn Header="Mô tả" Binding="{Binding MoTa}" Width="*" MinWidth="110"/>
                            <DataGridTextColumn Header="Trạng thái" Binding="{Binding TrangThai, Converter={StaticResource StatusTextConverter}}" Width="*" MinWidth="110"/>
                        </DataGrid.Columns>
                        <!-- Dữ liệu minh họa khai báo trực tiếp trong XAML. -->
                    </DataGrid>

                    <TextBlock Grid.Row="2" Text="Nhấp đúp để xem chi tiết"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,0" TextWrapping="Wrap"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
