<UserControl x:Class="QuanLyKhachSan.Views.KhachHangView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:mau="clr-namespace:QuanLyKhachSan.Data"
    d:DesignWidth="1120" d:DesignHeight="720"
    Background="{StaticResource BackgroundBrush}" FontFamily="Segoe UI">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/QuanLyKhachSan;component/Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="0,14,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" Margin="0,6,0,14" HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="btnKhachHangThemMoi" Content="Thêm mới" Click="btnKhachHangThemMoi_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8"/>
                <TextBox x:Name="txtTimKhachHang" Width="220" Style="{StaticResource DarkTextBox}" ToolTip="Từ khóa tìm kiếm" Margin="0,0,8,8"/>
                <ComboBox x:Name="cboLocKhachHang" Width="190" SelectedValuePath="Tag" SelectedIndex="0" Style="{StaticResource DarkComboBox}" Margin="0,0,8,8">
                    <ComboBoxItem Style="{StaticResource ReadableComboBoxItem}" Content="Tất cả trạng thái" Tag=""/>
                    <ComboBoxItem Style="{StaticResource ReadableComboBoxItem}" Content="Đang hoạt động"/>
                </ComboBox>
                <Button x:Name="btnTimKhachHang" Content="Tìm kiếm" Click="btnTimKhachHang_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"/>
                <Button x:Name="btnMoiKhachHang" Content="Làm mới" Click="btnMoiKhachHang_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,0,8"/>
            </StackPanel>
        </ScrollViewer>
        <DataGrid Grid.Row="1" x:Name="dgvKhachHang" MouseDoubleClick="KhachHang_DoubleClick" Style="{StaticResource DarkDataGrid}"
                  CellStyle="{StaticResource DarkDataGridCell}" RowStyle="{StaticResource DarkDataGridRow}"
                  ColumnHeaderStyle="{StaticResource DarkColumnHeader}" IsReadOnly="True" SelectedIndex="0"
                  SelectedValuePath="MaKhachHang" AutoGenerateColumns="False" CanUserAddRows="False" MinHeight="180">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Mã" Binding="{Binding MaKhachHang}" Width="*" MinWidth="110"/>
                <DataGridTextColumn Header="Họ tên" Binding="{Binding HoTen}" Width="*" MinWidth="110"/>
                <DataGridTextColumn Header="Giấy tờ" Binding="{Binding SoGiayTo}" Width="*" MinWidth="110"/>
                <DataGridTextColumn Header="Điện thoại" Binding="{Binding SoDienThoai}" Width="*" MinWidth="110"/>
                <DataGridTextColumn Header="Quốc tịch" Binding="{Binding QuocTich}" Width="*" MinWidth="110"/>
                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="*" MinWidth="110"/>
                <DataGridTextColumn Header="Trạng thái" Binding="{Binding TrangThai, Converter={StaticResource StatusTextConverter}}" Width="*" MinWidth="110"/>
            </DataGrid.Columns></DataGrid>

        <TextBlock Grid.Row="2" Text=" Nhấp đúp để xem chi tiết"
                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,0" TextWrapping="Wrap"/>
    </Grid>
</UserControl>
