<UserControl x:Class="QuanLyKhachSan.Views.KhoView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource BackgroundBrush}" FontFamily="Segoe UI">
    <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/QuanLyKhachSan;component/Resources/Styles.xaml"/>
    </ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
    <!-- Bớt dữ liệu mẫu; danh sách lấy SQL khi Loaded, tìm/lọc và sau mỗi lần lưu. -->
    <TabControl x:Name="tabChinh" Style="{StaticResource DarkTabControl}">
        <TabItem x:Name="tabTonKho" Header="Tồn kho" Style="{StaticResource DarkTabItem}">
            <Grid Margin="0,14,0,0">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><StackPanel Orientation="Horizontal">
            <Button x:Name="btnTonKhoNhapKho" Content="Nhập nhanh" Click="btnTonKhoNhapKho_Click" Style="{StaticResource PrimaryButton}" Margin="8,4,0,4" MinWidth="100"/>
            <Button x:Name="btnTonKhoXuatKho" Content="Xuất nhanh" Click="btnTonKhoXuatKho_Click" Style="{StaticResource PrimaryButton}" Margin="8,4,0,4" MinWidth="100"/>
            <Button x:Name="btnTonKhoDieuChinhTon" Content="Kiểm kê" Click="btnTonKhoDieuChinhTon_Click" Style="{StaticResource PrimaryButton}" Margin="8,4,0,4" MinWidth="100"/>
                        <TextBox x:Name="txtTimTonKho" Width="220" Style="{StaticResource DarkTextBox}" Margin="8,4" ToolTip="Tìm không dấu: chữ, số và khoảng trắng"/>
                        <ComboBox x:Name="cboLocTonKho" Width="190" Style="{StaticResource DarkComboBox}" Margin="0,4,8,4"/>
            <Button x:Name="btnTimTonKho" Content="Tìm kiếm" Click="btnTimTonKho_Click" Style="{StaticResource SecondaryButton}" Margin="8,4,0,4" MinWidth="100"/>
            <Button x:Name="btnMoiTonKho" Content="Làm mới" Click="btnMoiTonKho_Click" Style="{StaticResource SecondaryButton}" Margin="8,4,0,4" MinWidth="100"/>
                    </StackPanel></ScrollViewer>
                    <TextBlock x:Name="txtLoiTimTonKho" Text="Chỉ nhập chữ, số và khoảng trắng." Foreground="{StaticResource DangerBrush}" Visibility="Collapsed" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>
                <DataGrid x:Name="dgvTonKho" MouseDoubleClick="TonKho_DoubleClick" Style="{StaticResource DarkDataGrid}" CellStyle="{StaticResource DarkDataGridCell}" RowStyle="{StaticResource DarkDataGridRow}" ColumnHeaderStyle="{StaticResource DarkColumnHeader}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Grid.Row="1" MinHeight="180" Margin="0,10,0,0">
                <DataGrid.Columns>
                <DataGridTextColumn Header="Mã vật tư" Binding="{Binding MaVatTu}" Width="*" MinWidth="110"/>
                <DataGridTextColumn Header="Vật tư" Binding="{Binding VatTu}" Width="*" MinWidth="110"/>
                <DataGridTextColumn Header="Nhóm" Binding="{Binding Nhom}" Width="*" MinWidth="110"/>
                <DataGridTextColumn Header="Kho" Binding="{Binding Kho}" Width="*" MinWidth="110"/>
                <DataGridTextColumn Header="Đơn vị" Binding="{Binding DonVi}" Width="*" MinWidth="110"/>
                <DataGridTextColumn Header="Tồn" Binding="{Binding Ton}" Width="*" MinWidth="110"/>
                <DataGridTextColumn Header="Tối thiểu" Binding="{Binding ToiThieu}" Width="*" MinWidth="110"/>
                <DataGridTextColumn Header="Cảnh báo" Binding="{Binding CanhBao}" Width="*" MinWidth="110"/>
                </DataGrid.Columns></DataGrid>

                <TextBlock x:Name="txtThongBaoTonKho" Grid.Row="2" Text="Nhấp đúp để xem chi tiết." TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,0"/>
            </Grid>
        </TabItem>
        <TabItem x:Name="tabPhieuNhapXuat" Header="Phiếu nhập / xuất" Style="{StaticResource DarkTabItem}">
            <Grid Margin="0,14,0,0">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><StackPanel Orientation="Horizontal">
            <Button x:Name="btnPhieuNhapXuatTaoPhieu" Content="Tạo phiếu" Click="btnPhieuNhapXuatTaoPhieu_Click" Style="{StaticResource PrimaryButton}" Margin="8,4,0,4" MinWidth="100"/>
                        <TextBox x:Name="txtTimPhieuNhapXuat" Width="220" Style="{StaticResource DarkTextBox}" Margin="8,4" ToolTip="Tìm không dấu: chữ, số và khoảng trắng"/>
                        <ComboBox x:Name="cboLocPhieuNhapXuat" Width="190" Style="{StaticResource DarkComboBox}" Margin="0,4,8,4"/>
            <Button x:Name="btnTimPhieuNhapXuat" Content="Tìm kiếm" Click="btnTimPhieuNhapXuat_Click" Style="{StaticResource SecondaryButton}" Margin="8,4,0,4" MinWidth="100"/>
            <Button x:Name="btnMoiPhieuNhapXuat" Content="Làm mới" Click="btnMoiPhieuNhapXuat_Click" Style="{StaticResource SecondaryButton}" Margin="8,4,0,4" MinWidth="100"/>
                    </StackPanel></ScrollViewer>
                    <TextBlock x:Name="txtLoiTimPhieuNhapXuat" Text="Chỉ nhập chữ, số và khoảng trắng." Foreground="{StaticResource DangerBrush}" Visibility="Collapsed" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>
                <DataGrid x:Name="dgvPhieuNhapXuat" MouseDoubleClick="PhieuNhapXuat_DoubleClick" Style="{StaticResource DarkDataGrid}" CellStyle="{StaticResource DarkDataGridCell}" RowStyle="{StaticResource DarkDataGridRow}" ColumnHeaderStyle="{StaticResource DarkColumnHeader}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Grid.Row="1" MinHeight="180" Margin="0,10,0,0">
                <DataGrid.Columns>
                <DataGridTextColumn Header="Mã phiếu" Binding="{Binding MaPhieu}" Width="*" MinWidth="110"/>
                <DataGridTextColumn Header="Loại" Binding="{Binding Loai}" Width="*" MinWidth="110"/>
                <DataGridTextColumn Header="Kho" Binding="{Binding Kho}" Width="*" MinWidth="110"/>
                <DataGridTextColumn Header="Nhà cung cấp" Binding="{Binding NhaCungCap}" Width="*" MinWidth="110"/>
                <DataGridTextColumn Header="Ngày" Binding="{Binding NgayPhieu, StringFormat={}{0:dd/MM/yyyy}}" Width="*" MinWidth="110"/>
                <DataGridTextColumn Header="Nhân viên" Binding="{Binding NhanVien}" Width="*" MinWidth="110"/>
                <DataGridTextColumn Header="Tổng tiền" Binding="{Binding TongTien, Converter={StaticResource VndConverter}}" Width="*" MinWidth="110"/>
                <DataGridTextColumn Header="Trạng thái" Binding="{Binding TrangThai, Converter={StaticResource StatusTextConverter}}" Width="*" MinWidth="110"/>
                </DataGrid.Columns></DataGrid>

                <TextBlock x:Name="txtThongBaoPhieuNhapXuat" Grid.Row="2" Text="Nhấp đúp để xem chi tiết." TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,0"/>
            </Grid>
        </TabItem>
        <TabItem x:Name="tabKho" Header="Kho" Style="{StaticResource DarkTabItem}">
            <Grid Margin="0,14,0,0">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><StackPanel Orientation="Horizontal">
            <Button x:Name="btnKhoThemMoi" Content="Thêm kho" Click="btnKhoThemMoi_Click" Style="{StaticResource PrimaryButton}" Margin="8,4,0,4" MinWidth="100"/>
                        <TextBox x:Name="txtTimKho" Width="220" Style="{StaticResource DarkTextBox}" Margin="8,4" ToolTip="Tìm không dấu: chữ, số và khoảng trắng"/>
                        <ComboBox x:Name="cboLocKho" Width="190" Style="{StaticResource DarkComboBox}" Margin="0,4,8,4"/>
            <Button x:Name="btnTimKho" Content="Tìm kiếm" Click="btnTimKho_Click" Style="{StaticResource SecondaryButton}" Margin="8,4,0,4" MinWidth="100"/>
            <Button x:Name="btnMoiKho" Content="Làm mới" Click="btnMoiKho_Click" Style="{StaticResource SecondaryButton}" Margin="8,4,0,4" MinWidth="100"/>
                    </StackPanel></ScrollViewer>
                    <TextBlock x:Name="txtLoiTimKho" Text="Chỉ nhập chữ, số và khoảng trắng." Foreground="{StaticResource DangerBrush}" Visibility="Collapsed" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>
                <DataGrid x:Name="dgvKho" MouseDoubleClick="Kho_DoubleClick" Style="{StaticResource DarkDataGrid}" CellStyle="{StaticResource DarkDataGridCell}" RowStyle="{StaticResource DarkDataGridRow}" ColumnHeaderStyle="{StaticResource DarkColumnHeader}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Grid.Row="1" MinHeight="180" Margin="0,10,0,0">
                <DataGrid.Columns>
                <DataGridTextColumn Header="Mã" Binding="{Binding MaKho}" Width="*" MinWidth="110"/>
                <DataGridTextColumn Header="Tên kho" Binding="{Binding TenKho}" Width="*" MinWidth="110"/>
                <DataGridTextColumn Header="Ghi chú" Binding="{Binding GhiChu}" Width="*" MinWidth="110"/>
                <DataGridTextColumn Header="Trạng thái" Binding="{Binding TrangThai, Converter={StaticResource BoolToStatusConverter}, ConverterParameter=Text}" Width="*" MinWidth="110"/>
                </DataGrid.Columns></DataGrid>

                <TextBlock x:Name="txtThongBaoKho" Grid.Row="2" Text="Nhấp đúp để xem chi tiết." TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,0"/>
            </Grid>
        </TabItem>
    </TabControl>
</UserControl>
