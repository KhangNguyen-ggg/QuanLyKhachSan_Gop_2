<UserControl x:Class="QuanLyKhachSan.Views.NhatKyView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:mau="clr-namespace:QuanLyKhachSan.Data"
    d:DesignWidth="1120" d:DesignHeight="720"
    Background="{StaticResource BackgroundBrush}" FontFamily="Segoe UI">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/QuanLyKhachSan;component/Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <!-- Mở file này bằng Designer. Mọi tab, nút và bảng đều khai báo cố định. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
<TabControl x:Name="tabChinh" Grid.Row="1" Style="{StaticResource DarkTabControl}">
            <TabItem x:Name="tabNhatKyThaoTac" Header="Nhật ký thao tác" Style="{StaticResource DarkTabItem}">
                <Grid Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ScrollViewer Grid.Row="0" Margin="0,6,0,14" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Focusable="False">
                        <StackPanel Orientation="Horizontal">



                            <Button x:Name="btnNhatKyThaoTacBoLocNhatKy" Content="Bộ lọc nhật ký" Click="btnNhatKyThaoTacBoLocNhatKy_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"/>


                            <TextBox x:Name="txtTimNhatKyThaoTac" Width="220" Style="{StaticResource DarkTextBox}" ToolTip="Từ khóa tìm kiếm" Margin="0,0,8,8"/>
                            <ComboBox x:Name="cboLocNhatKyThaoTac" Width="190" SelectedIndex="0" Style="{StaticResource DarkComboBox}" Margin="0,0,8,8">
                                <ComboBoxItem Style="{StaticResource ReadableComboBoxItem}" Content="Tất cả dữ liệu"/>
                            </ComboBox>
                            <Button x:Name="btnTimNhatKyThaoTac" Content="Tìm kiếm" Click="btnTimNhatKyThaoTac_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"/>
                            <Button x:Name="btnMoiNhatKyThaoTac" Content="Làm mới" Click="btnMoiNhatKyThaoTac_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,0,8"/>


                        </StackPanel>
                    </ScrollViewer>
                    <DataGrid Grid.Row="1" x:Name="dgvNhatKyThaoTac" MouseDoubleClick="NhatKyThaoTac_DoubleClick" Style="{StaticResource DarkDataGrid}"
                              CellStyle="{StaticResource DarkDataGridCell}" RowStyle="{StaticResource DarkDataGridRow}"
                              ColumnHeaderStyle="{StaticResource DarkColumnHeader}" IsReadOnly="True" SelectedIndex="0"
                              AutoGenerateColumns="False" CanUserAddRows="False" MinHeight="180">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mã" Binding="{Binding Ma}" Width="*" MinWidth="110"/>
                            <DataGridTextColumn Header="Thời điểm" Binding="{Binding ThoiDiem}" Width="*" MinWidth="110"/>
                            <DataGridTextColumn Header="Tài khoản" Binding="{Binding TaiKhoan}" Width="*" MinWidth="110"/>
                            <DataGridTextColumn Header="Hành động" Binding="{Binding HanhDong}" Width="*" MinWidth="110"/>
                            <DataGridTextColumn Header="Đối tượng" Binding="{Binding DoiTuong}" Width="*" MinWidth="110"/>
                            <DataGridTextColumn Header="Mã bản ghi" Binding="{Binding MaBanGhi}" Width="*" MinWidth="110"/>
                            <DataGridTextColumn Header="Nội dung" Binding="{Binding NoiDung}" Width="*" MinWidth="110"/>
                        </DataGrid.Columns></DataGrid>

                    <TextBlock Grid.Row="2" Text=" Nhấp đúp để xem chi tiết"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,0" TextWrapping="Wrap"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
