<UserControl x:Class="QuanLyKhachSan.Views.NhanSuView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:helpers="clr-namespace:QuanLyKhachSan.Helpers"
    d:DesignWidth="1120" d:DesignHeight="720"
    Background="{StaticResource BackgroundBrush}" FontFamily="Segoe UI">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/QuanLyKhachSan;component/Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
                <helpers:GioConverter x:Key="GioConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>
    <!-- Mở file này bằng Designer. Mọi tab, nút và bảng đều khai báo cố định. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
<TabControl x:Name="tabChinh" Grid.Row="1" Style="{StaticResource DarkTabControl}">
            <TabItem x:Name="tabCaLamViec" Header="Ca làm việc" Style="{StaticResource DarkTabItem}">
                <Grid Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ScrollViewer Grid.Row="0" Margin="0,6,0,14" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Focusable="False">
                        <StackPanel Orientation="Horizontal">
                        
                            <Button x:Name="btnCaLamViecThemMoi" Content="Thêm mới" Click="btnCaLamViecThemMoi_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8" VerticalAlignment="Top"/>
                        
                        
                            <StackPanel Width="220" Margin="0,0,8,8" VerticalAlignment="Top">
                                <TextBox x:Name="txtTimCaLamViec" Style="{StaticResource DarkTextBox}" MinHeight="36" ToolTip="Tìm kiếm có dấu hoặc không dấu" AutomationProperties.Name="Tìm kiếm CaLamViec"/>
                                <TextBlock x:Name="txtLoiTimCaLamViec" Text="Chỉ nhập chữ, số và khoảng trắng." Foreground="{StaticResource DangerBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed" AutomationProperties.LiveSetting="Assertive"/>
                            </StackPanel>
                            <ComboBox x:Name="cboLocCaLamViec" Width="190" Style="{StaticResource DarkComboBox}" Margin="0,0,8,8" VerticalAlignment="Top"/>
                            <Button x:Name="btnTimCaLamViec" Content="Tìm kiếm" Click="btnTimCaLamViec_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" VerticalAlignment="Top"/>
                            <Button x:Name="btnMoiCaLamViec" Content="Làm mới" Click="btnMoiCaLamViec_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,0,8" VerticalAlignment="Top"/>
                        
                    
                        </StackPanel>
                    </ScrollViewer>
                    <DataGrid Grid.Row="1" x:Name="dgvCaLamViec" SelectedValuePath="MaCa" MouseDoubleClick="CaLamViec_DoubleClick" Style="{StaticResource DarkDataGrid}"
                              CellStyle="{StaticResource DarkDataGridCell}" RowStyle="{StaticResource DarkDataGridRow}"
                              ColumnHeaderStyle="{StaticResource DarkColumnHeader}" IsReadOnly="True" SelectedIndex="0"
                              AutoGenerateColumns="False" CanUserAddRows="False" MinHeight="180" >
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mã" Binding="{Binding MaCa}" Width="*" MinWidth="65"/>
                            <DataGridTextColumn Header="Tên ca" Binding="{Binding TenCa}" Width="*" MinWidth="150"/>
                            <DataGridTextColumn Header="Giờ bắt đầu" Binding="{Binding GioBatDau, Converter={StaticResource GioConverter}}" Width="*" MinWidth="110"/>
                            <DataGridTextColumn Header="Giờ kết thúc" Binding="{Binding GioKetThuc, Converter={StaticResource GioConverter}}" Width="*" MinWidth="110"/>
                            <DataGridTextColumn Header="Số giờ" Binding="{Binding SoGioLam}" Width="*" MinWidth="110"/>
                            <DataGridTextColumn Header="Trạng thái" Binding="{Binding TrangThai, Converter={StaticResource BoolToStatusConverter}}" Width="*" MinWidth="150"/>
                        </DataGrid.Columns>
                        <!-- Bớt dữ liệu mẫu: ItemsSource nhận dữ liệu SQL từ BUS. -->
                        </DataGrid>

                    <TextBlock x:Name="txtThongBaoCaLamViec" Grid.Row="2" Text="Nhấp đúp để xem chi tiết"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,0" TextWrapping="Wrap"/>
                </Grid>
            </TabItem>
            <TabItem x:Name="tabLichLamViec" Header="Lịch làm việc" Style="{StaticResource DarkTabItem}">
                <Grid Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ScrollViewer Grid.Row="0" Margin="0,6,0,14" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Focusable="False">
                        <StackPanel Orientation="Horizontal">
                        
                            <Button x:Name="btnLichLamViecThemLich" Content="Thêm lịch" Click="btnLichLamViecThemLich_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8" VerticalAlignment="Top"/>
                        
                        
                            <StackPanel Width="220" Margin="0,0,8,8" VerticalAlignment="Top">
                                <TextBox x:Name="txtTimLichLamViec" Style="{StaticResource DarkTextBox}" MinHeight="36" ToolTip="Tìm kiếm có dấu hoặc không dấu" AutomationProperties.Name="Tìm kiếm LichLamViec"/>
                                <TextBlock x:Name="txtLoiTimLichLamViec" Text="Chỉ nhập chữ, số và khoảng trắng." Foreground="{StaticResource DangerBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed" AutomationProperties.LiveSetting="Assertive"/>
                            </StackPanel>
                            <ComboBox x:Name="cboLocLichLamViec" Width="190" Style="{StaticResource DarkComboBox}" Margin="0,0,8,8" VerticalAlignment="Top"/>
                            <Button x:Name="btnTimLichLamViec" Content="Tìm kiếm" Click="btnTimLichLamViec_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" VerticalAlignment="Top"/>
                            <Button x:Name="btnMoiLichLamViec" Content="Làm mới" Click="btnMoiLichLamViec_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,0,8" VerticalAlignment="Top"/>
                        
                    
                        </StackPanel>
                    </ScrollViewer>
                    <DataGrid Grid.Row="1" x:Name="dgvLichLamViec" SelectedValuePath="MaLich" MouseDoubleClick="LichLamViec_DoubleClick" Style="{StaticResource DarkDataGrid}"
                              CellStyle="{StaticResource DarkDataGridCell}" RowStyle="{StaticResource DarkDataGridRow}"
                              ColumnHeaderStyle="{StaticResource DarkColumnHeader}" IsReadOnly="True" SelectedIndex="0"
                              AutoGenerateColumns="False" CanUserAddRows="False" MinHeight="180">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mã" Binding="{Binding MaLich}" Width="*" MinWidth="65"/>
                            <DataGridTextColumn Header="Nhân viên" Binding="{Binding NhanVien}" Width="*" MinWidth="210"/>
                            <DataGridTextColumn Header="Ngày làm" Binding="{Binding NgayLam, StringFormat=dd/MM/yyyy}" Width="*" MinWidth="110"/>
                            <DataGridTextColumn Header="Ca" Binding="{Binding Ca}" Width="*" MinWidth="150"/>
                            <DataGridTextColumn Header="Trạng thái" Binding="{Binding TrangThai, Converter={StaticResource StatusTextConverter}}" Width="*" MinWidth="150"/>
                            <DataGridTextColumn Header="Ghi chú" Binding="{Binding GhiChu}" Width="*" MinWidth="220"/>
                        </DataGrid.Columns>
                        <!-- Bớt dữ liệu mẫu: ItemsSource nhận dữ liệu SQL từ BUS. -->
                        </DataGrid>

                    <TextBlock x:Name="txtThongBaoLichLamViec" Grid.Row="2" Text="Nhấp đúp để xem chi tiết"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,0" TextWrapping="Wrap"/>
                </Grid>
            </TabItem>
            <TabItem x:Name="tabChamCong" Header="Chấm công" Style="{StaticResource DarkTabItem}">
                <Grid Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ScrollViewer Grid.Row="0" Margin="0,6,0,14" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Focusable="False">
                        <StackPanel Orientation="Horizontal">
                        
                            <Button x:Name="btnChamCongThemChamCong" Content="Thêm chấm công" Click="btnChamCongThemChamCong_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8" VerticalAlignment="Top"/>
                        
                        
                            <StackPanel Width="220" Margin="0,0,8,8" VerticalAlignment="Top">
                                <TextBox x:Name="txtTimChamCong" Style="{StaticResource DarkTextBox}" MinHeight="36" ToolTip="Tìm kiếm có dấu hoặc không dấu" AutomationProperties.Name="Tìm kiếm ChamCong"/>
                                <TextBlock x:Name="txtLoiTimChamCong" Text="Chỉ nhập chữ, số và khoảng trắng." Foreground="{StaticResource DangerBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed" AutomationProperties.LiveSetting="Assertive"/>
                            </StackPanel>
                            <ComboBox x:Name="cboLocChamCong" Width="190" Style="{StaticResource DarkComboBox}" Margin="0,0,8,8" VerticalAlignment="Top"/>
                            <Button x:Name="btnTimChamCong" Content="Tìm kiếm" Click="btnTimChamCong_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" VerticalAlignment="Top"/>
                            <Button x:Name="btnMoiChamCong" Content="Làm mới" Click="btnMoiChamCong_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,0,8" VerticalAlignment="Top"/>
                        
                    
                        </StackPanel>
                    </ScrollViewer>
                    <DataGrid Grid.Row="1" x:Name="dgvChamCong" SelectedValuePath="MaChamCong" MouseDoubleClick="ChamCong_DoubleClick" Style="{StaticResource DarkDataGrid}"
                              CellStyle="{StaticResource DarkDataGridCell}" RowStyle="{StaticResource DarkDataGridRow}"
                              ColumnHeaderStyle="{StaticResource DarkColumnHeader}" IsReadOnly="True" SelectedIndex="0"
                              AutoGenerateColumns="False" CanUserAddRows="False" MinHeight="180">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mã" Binding="{Binding MaChamCong}" Width="*" MinWidth="65"/>
                            <DataGridTextColumn Header="Lịch" Binding="{Binding MaLich}" Width="*" MinWidth="65"/>
                            <DataGridTextColumn Header="Nhân viên" Binding="{Binding NhanVien}" Width="*" MinWidth="210"/>
                            <DataGridTextColumn Header="Ngày" Binding="{Binding NgayChamCong, StringFormat=dd/MM/yyyy}" Width="*" MinWidth="110"/>
                            <DataGridTextColumn Header="Giờ vào" Binding="{Binding GioVao, StringFormat=dd/MM/yyyy HH:mm}" Width="*" MinWidth="175"/>
                            <DataGridTextColumn Header="Giờ ra" Binding="{Binding GioRa, StringFormat=dd/MM/yyyy HH:mm}" Width="*" MinWidth="175"/>
                            <DataGridTextColumn Header="Giờ thường" Binding="{Binding SoGioLam}" Width="*" MinWidth="110"/>
                            <DataGridTextColumn Header="Tăng ca" Binding="{Binding SoGioTangCa}" Width="*" MinWidth="110"/>
                            <DataGridTextColumn Header="Trạng thái" Binding="{Binding TrangThai, Converter={StaticResource StatusTextConverter}}" Width="*" MinWidth="150"/>
                        </DataGrid.Columns>
                        <!-- Bớt dữ liệu mẫu: ItemsSource nhận dữ liệu SQL từ BUS. -->
                        </DataGrid>

                    <TextBlock x:Name="txtThongBaoChamCong" Grid.Row="2" Text="Nhấp đúp để xem chi tiết"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,0" TextWrapping="Wrap"/>
                </Grid>
            </TabItem>
            <TabItem x:Name="tabBangLuong" Header="Bảng lương" Style="{StaticResource DarkTabItem}">
                <Grid Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ScrollViewer Grid.Row="0" Margin="0,6,0,14" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Focusable="False">
                        <StackPanel Orientation="Horizontal">
                        
                            <Button x:Name="btnBangLuongLapBangLuong" Content="Lập bảng lương" Click="btnBangLuongLapBangLuong_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8" VerticalAlignment="Top"/>
                        
                        
                            <StackPanel Width="220" Margin="0,0,8,8" VerticalAlignment="Top">
                                <TextBox x:Name="txtTimBangLuong" Style="{StaticResource DarkTextBox}" MinHeight="36" ToolTip="Tìm kiếm có dấu hoặc không dấu" AutomationProperties.Name="Tìm kiếm BangLuong"/>
                                <TextBlock x:Name="txtLoiTimBangLuong" Text="Chỉ nhập chữ, số và khoảng trắng." Foreground="{StaticResource DangerBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed" AutomationProperties.LiveSetting="Assertive"/>
                            </StackPanel>
                            <ComboBox x:Name="cboLocBangLuong" Width="190" Style="{StaticResource DarkComboBox}" Margin="0,0,8,8" VerticalAlignment="Top"/>
                            <Button x:Name="btnTimBangLuong" Content="Tìm kiếm" Click="btnTimBangLuong_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" VerticalAlignment="Top"/>
                            <Button x:Name="btnMoiBangLuong" Content="Làm mới" Click="btnMoiBangLuong_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,0,8" VerticalAlignment="Top"/>
                        
                    
                        </StackPanel>
                    </ScrollViewer>
                    <DataGrid Grid.Row="1" x:Name="dgvBangLuong" SelectedValuePath="MaBangLuong" MouseDoubleClick="BangLuong_DoubleClick" Style="{StaticResource DarkDataGrid}"
                              CellStyle="{StaticResource DarkDataGridCell}" RowStyle="{StaticResource DarkDataGridRow}"
                              ColumnHeaderStyle="{StaticResource DarkColumnHeader}" IsReadOnly="True" SelectedIndex="0"
                              AutoGenerateColumns="False" CanUserAddRows="False" MinHeight="180">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mã" Binding="{Binding MaBangLuong}" Width="*" MinWidth="65"/>
                            <DataGridTextColumn Header="Nhân viên" Binding="{Binding NhanVien}" Width="*" MinWidth="210"/>
                            <DataGridTextColumn Header="Kỳ" Binding="{Binding Ky}" Width="*" MinWidth="110"/>
                            <DataGridTextColumn Header="Tiền công" Binding="{Binding TienCong, StringFormat=N2}" Width="*" MinWidth="140"/>
                            <DataGridTextColumn Header="Tăng ca" Binding="{Binding TienTangCa, StringFormat=N2}" Width="*" MinWidth="140"/>
                            <DataGridTextColumn Header="Thưởng" Binding="{Binding TienThuong, StringFormat=N2}" Width="*" MinWidth="140"/>
                            <DataGridTextColumn Header="Phụ cấp" Binding="{Binding TienPhuCap, StringFormat=N2}" Width="*" MinWidth="140"/>
                            <DataGridTextColumn Header="Khấu trừ" Binding="{Binding TienKhauTru, StringFormat=N2}" Width="*" MinWidth="140"/>
                            <DataGridTextColumn Header="Thực lĩnh" Binding="{Binding ThucLinh, StringFormat=N2}" Width="*" MinWidth="140"/>
                            <DataGridTextColumn Header="Trạng thái" Binding="{Binding TrangThai, Converter={StaticResource StatusTextConverter}}" Width="*" MinWidth="150"/>
                            <DataGridTextColumn Header="Thuế" Binding="{Binding Thue, StringFormat=N2}" Width="*" MinWidth="140"/>
                        </DataGrid.Columns>
                        <!-- Bớt dữ liệu mẫu: ItemsSource nhận dữ liệu SQL từ BUS. -->
                        </DataGrid>

                    <TextBlock x:Name="txtThongBaoBangLuong" Grid.Row="2" Text="Nhấp đúp để xem chi tiết"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,0" TextWrapping="Wrap"/>
                </Grid>
            </TabItem>
            <TabItem x:Name="tabKhenThuong" Header="Khen thưởng" Style="{StaticResource DarkTabItem}">
                <Grid Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ScrollViewer Grid.Row="0" Margin="0,6,0,14" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Focusable="False">
                        <StackPanel Orientation="Horizontal">
                        
                            <Button x:Name="btnKhenThuongThemKhenThuong" Content="Thêm khen thưởng" Click="btnKhenThuongThemKhenThuong_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8" VerticalAlignment="Top"/>
                        
                        
                            <StackPanel Width="220" Margin="0,0,8,8" VerticalAlignment="Top">
                                <TextBox x:Name="txtTimKhenThuong" Style="{StaticResource DarkTextBox}" MinHeight="36" ToolTip="Tìm kiếm có dấu hoặc không dấu" AutomationProperties.Name="Tìm kiếm KhenThuong"/>
                                <TextBlock x:Name="txtLoiTimKhenThuong" Text="Chỉ nhập chữ, số và khoảng trắng." Foreground="{StaticResource DangerBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed" AutomationProperties.LiveSetting="Assertive"/>
                            </StackPanel>
                            <ComboBox x:Name="cboLocKhenThuong" Width="190" Style="{StaticResource DarkComboBox}" Margin="0,0,8,8" VerticalAlignment="Top"/>
                            <Button x:Name="btnTimKhenThuong" Content="Tìm kiếm" Click="btnTimKhenThuong_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" VerticalAlignment="Top"/>
                            <Button x:Name="btnMoiKhenThuong" Content="Làm mới" Click="btnMoiKhenThuong_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,0,8" VerticalAlignment="Top"/>
                        
                    
                        </StackPanel>
                    </ScrollViewer>
                    <DataGrid Grid.Row="1" x:Name="dgvKhenThuong" SelectedValuePath="MaKhenThuong" MouseDoubleClick="KhenThuong_DoubleClick" Style="{StaticResource DarkDataGrid}"
                              CellStyle="{StaticResource DarkDataGridCell}" RowStyle="{StaticResource DarkDataGridRow}"
                              ColumnHeaderStyle="{StaticResource DarkColumnHeader}" IsReadOnly="True" SelectedIndex="0"
                              AutoGenerateColumns="False" CanUserAddRows="False" MinHeight="180">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mã" Binding="{Binding MaKhenThuong}" Width="*" MinWidth="65"/>
                            <DataGridTextColumn Header="Nhân viên" Binding="{Binding NhanVien}" Width="*" MinWidth="210"/>
                            <DataGridTextColumn Header="Ngày" Binding="{Binding NgayKhenThuong, StringFormat=dd/MM/yyyy}" Width="*" MinWidth="110"/>
                            <DataGridTextColumn Header="Lý do" Binding="{Binding LyDo}" Width="*" MinWidth="220"/>
                            <DataGridTextColumn Header="Hình thức" Binding="{Binding HinhThuc, Converter={StaticResource StatusTextConverter}}" Width="*" MinWidth="150"/>
                            <DataGridTextColumn Header="Số tiền" Binding="{Binding SoTien, StringFormat=N2}" Width="*" MinWidth="140"/>
                            <DataGridTextColumn Header="Trạng thái" Binding="{Binding TrangThai, Converter={StaticResource StatusTextConverter}}" Width="*" MinWidth="150"/>
                        </DataGrid.Columns>
                        <!-- Bớt dữ liệu mẫu: ItemsSource nhận dữ liệu SQL từ BUS. -->
                        </DataGrid>

                    <TextBlock x:Name="txtThongBaoKhenThuong" Grid.Row="2" Text="Nhấp đúp để xem chi tiết"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,0" TextWrapping="Wrap"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
