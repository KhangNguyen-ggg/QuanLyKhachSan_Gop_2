<UserControl x:Class="QuanLyKhachSan.Views.VatTuNhaCungCapView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource BackgroundBrush}" FontFamily="Segoe UI">
    <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/QuanLyKhachSan;component/Resources/Styles.xaml"/>
    </ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
    <!-- Bớt dữ liệu mẫu; danh sách lấy SQL khi Loaded, tìm/lọc và sau mỗi lần lưu. -->
    <TabControl x:Name="tabChinh" Style="{StaticResource DarkTabControl}">
        <TabItem x:Name="tabVatTu" Header="Vật tư" Style="{StaticResource DarkTabItem}">
            <Grid Margin="0,14,0,0">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><StackPanel Orientation="Horizontal">
            <Button x:Name="btnVatTuThemMoi" Content="Thêm vật tư" Click="btnVatTuThemMoi_Click" Style="{StaticResource PrimaryButton}" Margin="8,4,0,4" MinWidth="100"/>
                        <TextBox x:Name="txtTimVatTu" Width="220" Style="{StaticResource DarkTextBox}" Margin="8,4" ToolTip="Tìm không dấu: chữ, số và khoảng trắng"/>
                        <ComboBox x:Name="cboLocVatTu" Width="190" Style="{StaticResource DarkComboBox}" Margin="0,4,8,4"/>
            <Button x:Name="btnTimVatTu" Content="Tìm kiếm" Click="btnTimVatTu_Click" Style="{StaticResource SecondaryButton}" Margin="8,4,0,4" MinWidth="100"/>
            <Button x:Name="btnMoiVatTu" Content="Làm mới" Click="btnMoiVatTu_Click" Style="{StaticResource SecondaryButton}" Margin="8,4,0,4" MinWidth="100"/>
                    </StackPanel></ScrollViewer>
                    <TextBlock x:Name="txtLoiTimVatTu" Text="Chỉ nhập chữ, số và khoảng trắng." Foreground="{StaticResource DangerBrush}" Visibility="Collapsed" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>
                <DataGrid x:Name="dgvVatTu" MouseDoubleClick="VatTu_DoubleClick" Style="{StaticResource DarkDataGrid}" CellStyle="{StaticResource DarkDataGridCell}" RowStyle="{StaticResource DarkDataGridRow}" ColumnHeaderStyle="{StaticResource DarkColumnHeader}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Grid.Row="1" MinHeight="180" Margin="0,10,0,0">
                <DataGrid.Columns>
                <DataGridTextColumn Header="Mã" Binding="{Binding MaLoaiVatTu}" Width="*" MinWidth="110"/>
                <DataGridTextColumn Header="Tên vật tư" Binding="{Binding TenVatTu}" Width="*" MinWidth="110"/>
                <DataGridTextColumn Header="Nhóm" Binding="{Binding Nhom}" Width="*" MinWidth="110"/>
                <DataGridTextColumn Header="Đơn vị" Binding="{Binding DonViTinh}" Width="*" MinWidth="110"/>
                <DataGridTextColumn Header="Kho mặc định" Binding="{Binding KhoMacDinh}" Width="*" MinWidth="110"/>
                <DataGridTextColumn Header="Tồn tối thiểu" Binding="{Binding SoLuongToiThieu}" Width="*" MinWidth="110"/>
                <DataGridTextColumn Header="Trạng thái" Binding="{Binding TrangThai, Converter={StaticResource BoolToStatusConverter}, ConverterParameter=Text}" Width="*" MinWidth="110"/>
                </DataGrid.Columns></DataGrid>

                <TextBlock x:Name="txtThongBaoVatTu" Grid.Row="2" Text="Nhấp đúp để xem chi tiết." TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,0"/>
            </Grid>
        </TabItem>
        <TabItem x:Name="tabNhomVatTu" Header="Nhóm vật tư" Style="{StaticResource DarkTabItem}">
            <Grid Margin="0,14,0,0">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><StackPanel Orientation="Horizontal">
            <Button x:Name="btnNhomVatTuThemMoi" Content="Thêm nhóm" Click="btnNhomVatTuThemMoi_Click" Style="{StaticResource PrimaryButton}" Margin="8,4,0,4" MinWidth="100"/>
                        <TextBox x:Name="txtTimNhomVatTu" Width="220" Style="{StaticResource DarkTextBox}" Margin="8,4" ToolTip="Tìm không dấu: chữ, số và khoảng trắng"/>
                        <ComboBox x:Name="cboLocNhomVatTu" Width="190" Style="{StaticResource DarkComboBox}" Margin="0,4,8,4"/>
            <Button x:Name="btnTimNhomVatTu" Content="Tìm kiếm" Click="btnTimNhomVatTu_Click" Style="{StaticResource SecondaryButton}" Margin="8,4,0,4" MinWidth="100"/>
            <Button x:Name="btnMoiNhomVatTu" Content="Làm mới" Click="btnMoiNhomVatTu_Click" Style="{StaticResource SecondaryButton}" Margin="8,4,0,4" MinWidth="100"/>
                    </StackPanel></ScrollViewer>
                    <TextBlock x:Name="txtLoiTimNhomVatTu" Text="Chỉ nhập chữ, số và khoảng trắng." Foreground="{StaticResource DangerBrush}" Visibility="Collapsed" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>
                <DataGrid x:Name="dgvNhomVatTu" MouseDoubleClick="NhomVatTu_DoubleClick" Style="{StaticResource DarkDataGrid}" CellStyle="{StaticResource DarkDataGridCell}" RowStyle="{StaticResource DarkDataGridRow}" ColumnHeaderStyle="{StaticResource DarkColumnHeader}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Grid.Row="1" MinHeight="180" Margin="0,10,0,0">
                <DataGrid.Columns>
                <DataGridTextColumn Header="Mã" Binding="{Binding MaNhomVatTu}" Width="*" MinWidth="110"/>
                <DataGridTextColumn Header="Tên nhóm" Binding="{Binding TenNhomVatTu}" Width="*" MinWidth="110"/>
                <DataGridTextColumn Header="Mô tả" Binding="{Binding MoTa}" Width="*" MinWidth="110"/>
                <DataGridTextColumn Header="Trạng thái" Binding="{Binding TrangThai, Converter={StaticResource BoolToStatusConverter}, ConverterParameter=Text}" Width="*" MinWidth="110"/>
                </DataGrid.Columns></DataGrid>

                <TextBlock x:Name="txtThongBaoNhomVatTu" Grid.Row="2" Text="Nhấp đúp để xem chi tiết." TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,0"/>
            </Grid>
        </TabItem>
        <TabItem x:Name="tabNhaCungCap" Header="Nhà cung cấp" Style="{StaticResource DarkTabItem}">
            <Grid Margin="0,14,0,0">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><StackPanel Orientation="Horizontal">
            <Button x:Name="btnNhaCungCapThemMoi" Content="Thêm nhà cung cấp" Click="btnNhaCungCapThemMoi_Click" Style="{StaticResource PrimaryButton}" Margin="8,4,0,4" MinWidth="100"/>
                        <TextBox x:Name="txtTimNhaCungCap" Width="220" Style="{StaticResource DarkTextBox}" Margin="8,4" ToolTip="Tìm không dấu: chữ, số và khoảng trắng"/>
                        <ComboBox x:Name="cboLocNhaCungCap" Width="190" Style="{StaticResource DarkComboBox}" Margin="0,4,8,4"/>
            <Button x:Name="btnTimNhaCungCap" Content="Tìm kiếm" Click="btnTimNhaCungCap_Click" Style="{StaticResource SecondaryButton}" Margin="8,4,0,4" MinWidth="100"/>
            <Button x:Name="btnMoiNhaCungCap" Content="Làm mới" Click="btnMoiNhaCungCap_Click" Style="{StaticResource SecondaryButton}" Margin="8,4,0,4" MinWidth="100"/>
                    </StackPanel></ScrollViewer>
                    <TextBlock x:Name="txtLoiTimNhaCungCap" Text="Chỉ nhập chữ, số và khoảng trắng." Foreground="{StaticResource DangerBrush}" Visibility="Collapsed" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>
                <DataGrid x:Name="dgvNhaCungCap" MouseDoubleClick="NhaCungCap_DoubleClick" Style="{StaticResource DarkDataGrid}" CellStyle="{StaticResource DarkDataGridCell}" RowStyle="{StaticResource DarkDataGridRow}" ColumnHeaderStyle="{StaticResource DarkColumnHeader}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Grid.Row="1" MinHeight="180" Margin="0,10,0,0">
                <DataGrid.Columns>
                <DataGridTextColumn Header="Mã" Binding="{Binding MaNhaCungCap}" Width="*" MinWidth="110"/>
                <DataGridTextColumn Header="Nhà cung cấp" Binding="{Binding TenNhaCungCap}" Width="*" MinWidth="110"/>
                <DataGridTextColumn Header="Đại diện" Binding="{Binding NguoiDaiDien}" Width="*" MinWidth="110"/>
                <DataGridTextColumn Header="Điện thoại" Binding="{Binding SoDienThoai}" Width="*" MinWidth="110"/>
                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="*" MinWidth="110"/>
                <DataGridTextColumn Header="Trạng thái" Binding="{Binding TrangThai, Converter={StaticResource BoolToStatusConverter}, ConverterParameter=Text}" Width="*" MinWidth="110"/>
                </DataGrid.Columns></DataGrid>

                <TextBlock x:Name="txtThongBaoNhaCungCap" Grid.Row="2" Text="Nhấp đúp để xem chi tiết." TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,0"/>
            </Grid>
        </TabItem>
    </TabControl>
</UserControl>
