<UserControl x:Class="QuanLyKhachSan.Views.NhanVienView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:mau="clr-namespace:QuanLyKhachSan.Data"
    d:DesignWidth="1120" d:DesignHeight="720"
    Background="{StaticResource BackgroundBrush}" FontFamily="Segoe UI">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/QuanLyKhachSan;component/Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <!-- Mở file này bằng Designer. Mọi tab, nút và bảng đều khai báo cố định. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
<TabControl x:Name="tabChinh" Grid.Row="1" Style="{StaticResource DarkTabControl}">
            <TabItem x:Name="tabNhanVien" Header="Nhân viên" Style="{StaticResource DarkTabItem}">
                <Grid Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ScrollViewer Grid.Row="0" Margin="0,6,0,14" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Focusable="False">
                        <StackPanel Orientation="Horizontal">
                        
                            <Button x:Name="btnNhanVienThemMoi" Content="Thêm mới" Click="btnNhanVienThemMoi_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8" VerticalAlignment="Top"/>
                            <StackPanel Width="220" Margin="0,0,8,8" VerticalAlignment="Top">
                                <TextBox x:Name="txtTimNhanVien" Style="{StaticResource DarkTextBox}" MinHeight="36" ToolTip="Tìm kiếm có dấu hoặc không dấu" AutomationProperties.Name="Tìm kiếm NhanVien"/>
                                <TextBlock x:Name="txtLoiTimNhanVien" Text="Chỉ nhập chữ, số và khoảng trắng." Foreground="{StaticResource DangerBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed" AutomationProperties.LiveSetting="Assertive"/>
                            </StackPanel>
                            <ComboBox x:Name="cboLocNhanVien" Width="190" Style="{StaticResource DarkComboBox}" Margin="0,0,8,8" VerticalAlignment="Top"/>
                            <Button x:Name="btnTimNhanVien" Content="Tìm kiếm" Click="btnTimNhanVien_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" VerticalAlignment="Top"/>
                            <Button x:Name="btnMoiNhanVien" Content="Làm mới" Click="btnMoiNhanVien_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,0,8" VerticalAlignment="Top"/>
                        
                    
                        </StackPanel>
                    </ScrollViewer>
                    <DataGrid Grid.Row="1" x:Name="dgvNhanVien" SelectedValuePath="MaNhanVien" MouseDoubleClick="NhanVien_DoubleClick" Style="{StaticResource DarkDataGrid}"
                              CellStyle="{StaticResource DarkDataGridCell}" RowStyle="{StaticResource DarkDataGridRow}"
                              ColumnHeaderStyle="{StaticResource DarkColumnHeader}" IsReadOnly="True" SelectedIndex="0"
                              AutoGenerateColumns="False" CanUserAddRows="False" MinHeight="180">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mã" Binding="{Binding MaNhanVien}" Width="*" MinWidth="65"/>
                            <DataGridTextColumn Header="Họ tên" Binding="{Binding HoTen}" Width="*" MinWidth="210"/>
                            <DataGridTextColumn Header="Phòng ban" Binding="{Binding PhongBan}" Width="*" MinWidth="150"/>
                            <DataGridTextColumn Header="Chức vụ" Binding="{Binding ChucVu}" Width="*" MinWidth="150"/>
                            <DataGridTextColumn Header="Điện thoại" Binding="{Binding SoDienThoai}" Width="*" MinWidth="110"/>
                            <DataGridTextColumn Header="Lương cơ bản" Binding="{Binding LuongCoBan, StringFormat=N2}" Width="*" MinWidth="140"/>
                            <DataGridTextColumn Header="Trạng thái" Binding="{Binding TrangThai, Converter={StaticResource StatusTextConverter}}" Width="*" MinWidth="150"/>
                        </DataGrid.Columns>
                        <!-- Bớt dữ liệu mẫu: ItemsSource nhận dữ liệu SQL từ BUS. -->
                        </DataGrid>

                    <TextBlock x:Name="txtThongBaoNhanVien" Grid.Row="2" Text="Nhấp đúp để xem chi tiết"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,0" TextWrapping="Wrap"/>
                </Grid>
            </TabItem>
            <TabItem x:Name="tabPhongBan" Header="Phòng ban" Style="{StaticResource DarkTabItem}">
                <Grid Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ScrollViewer Grid.Row="0" Margin="0,6,0,14" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Focusable="False">
                        <StackPanel Orientation="Horizontal">
                        
                            <Button x:Name="btnPhongBanThemMoi" Content="Thêm mới" Click="btnPhongBanThemMoi_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8" VerticalAlignment="Top"/>
                            <StackPanel Width="220" Margin="0,0,8,8" VerticalAlignment="Top">
                                <TextBox x:Name="txtTimPhongBan" Style="{StaticResource DarkTextBox}" MinHeight="36"
                                         ToolTip="Tìm theo tên hoặc mô tả, có dấu hoặc không dấu"
                                         AutomationProperties.Name="Tìm kiếm phòng ban"
                                         AutomationProperties.HelpText="Chỉ nhập chữ, số và khoảng trắng. Hỗ trợ tìm không dấu."/>
                                <TextBlock x:Name="txtLoiTimPhongBan" Text="Chỉ nhập chữ, số và khoảng trắng."
                                           Foreground="{StaticResource DangerBrush}" FontSize="11" TextWrapping="Wrap"
                                           Margin="0,4,0,0" Visibility="Collapsed" AutomationProperties.LiveSetting="Assertive"/>
                            </StackPanel>
                            <ComboBox x:Name="cboLocPhongBan" Width="190" SelectedIndex="0" SelectedValuePath="Tag" Style="{StaticResource DarkComboBox}" Margin="0,0,8,8" VerticalAlignment="Top" SelectionChanged="cboLocPhongBan_SelectionChanged">
                                <ComboBoxItem Style="{StaticResource ReadableComboBoxItem}" Content="Tất cả trạng thái"/>
                                <ComboBoxItem Style="{StaticResource ReadableComboBoxItem}" Content="Đang hoạt động">
                                    <ComboBoxItem.Tag><sys:Boolean>True</sys:Boolean></ComboBoxItem.Tag>
                                </ComboBoxItem>
                                <ComboBoxItem Style="{StaticResource ReadableComboBoxItem}" Content="Ngừng hoạt động">
                                    <ComboBoxItem.Tag><sys:Boolean>False</sys:Boolean></ComboBoxItem.Tag>
                                </ComboBoxItem>
                            </ComboBox>
                            <Button x:Name="btnTimPhongBan" Content="Tìm kiếm" Click="btnTimPhongBan_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" VerticalAlignment="Top"/>
                            <Button x:Name="btnMoiPhongBan" Content="Làm mới" Click="btnMoiPhongBan_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,0,8" VerticalAlignment="Top"/>
                        
                    
                        </StackPanel>
                    </ScrollViewer>
                    <DataGrid Grid.Row="1" x:Name="dgvPhongBan" MouseDoubleClick="PhongBan_DoubleClick" Style="{StaticResource DarkDataGrid}"
                              SelectedValuePath="MaPhongBan"
                              CellStyle="{StaticResource DarkDataGridCell}" RowStyle="{StaticResource DarkDataGridRow}"
                              ColumnHeaderStyle="{StaticResource DarkColumnHeader}" IsReadOnly="True" SelectedIndex="0"
                              AutoGenerateColumns="False" CanUserAddRows="False" MinHeight="180">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mã" Binding="{Binding MaPhongBan}" Width="*" MinWidth="65"/>
                            <DataGridTextColumn Header="Tên phòng ban" Binding="{Binding TenPhongBan}" Width="*" MinWidth="110"/>
                            <DataGridTextColumn Header="Mô tả" Binding="{Binding MoTa}" Width="*" MinWidth="110"/>
                            <DataGridTemplateColumn Header="Trạng thái" Width="*" MinWidth="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Ngừng hoạt động"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding TrangThai}" Value="True">
                                                            <Setter Property="Text" Value="Đang hoạt động"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock x:Name="txtThongBaoPhongBan" Grid.Row="2" Text="Nhấp đúp để xem chi tiết / sửa"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,0" TextWrapping="Wrap"/>
                </Grid>
            </TabItem>
            <TabItem x:Name="tabChucVu" Header="Chức vụ" Style="{StaticResource DarkTabItem}">
                <Grid Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ScrollViewer Grid.Row="0" Margin="0,6,0,14" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Focusable="False">
                        <StackPanel Orientation="Horizontal">
                        
                            <Button x:Name="btnChucVuThemMoi" Content="Thêm mới" Click="btnChucVuThemMoi_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8" VerticalAlignment="Top"/>
                            <StackPanel Width="220" Margin="0,0,8,8" VerticalAlignment="Top">
                                <TextBox x:Name="txtTimChucVu" Style="{StaticResource DarkTextBox}" MinHeight="36"
                                         ToolTip="Tìm theo tên hoặc mô tả, có dấu hoặc không dấu"
                                         AutomationProperties.Name="Tìm kiếm chức vụ"
                                         AutomationProperties.HelpText="Chỉ nhập chữ, số và khoảng trắng. Hỗ trợ tìm không dấu."/>
                                <TextBlock x:Name="txtLoiTimChucVu" Text="Chỉ nhập chữ, số và khoảng trắng."
                                           Foreground="{StaticResource DangerBrush}" FontSize="11" TextWrapping="Wrap"
                                           Margin="0,4,0,0" Visibility="Collapsed" AutomationProperties.LiveSetting="Assertive"/>
                            </StackPanel>
                            <ComboBox x:Name="cboLocChucVu" Width="190" SelectedIndex="0" SelectedValuePath="Tag" Style="{StaticResource DarkComboBox}" Margin="0,0,8,8" VerticalAlignment="Top" SelectionChanged="cboLocChucVu_SelectionChanged">
                                <ComboBoxItem Style="{StaticResource ReadableComboBoxItem}" Content="Tất cả trạng thái"/>
                                <ComboBoxItem Style="{StaticResource ReadableComboBoxItem}" Content="Đang hoạt động">
                                    <ComboBoxItem.Tag><sys:Boolean>True</sys:Boolean></ComboBoxItem.Tag>
                                </ComboBoxItem>
                                <ComboBoxItem Style="{StaticResource ReadableComboBoxItem}" Content="Ngừng hoạt động">
                                    <ComboBoxItem.Tag><sys:Boolean>False</sys:Boolean></ComboBoxItem.Tag>
                                </ComboBoxItem>
                            </ComboBox>
                            <Button x:Name="btnTimChucVu" Content="Tìm kiếm" Click="btnTimChucVu_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" VerticalAlignment="Top"/>
                            <Button x:Name="btnMoiChucVu" Content="Làm mới" Click="btnMoiChucVu_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,0,8" VerticalAlignment="Top"/>
                        
                    
                        </StackPanel>
                    </ScrollViewer>
                    <DataGrid Grid.Row="1" x:Name="dgvChucVu" MouseDoubleClick="ChucVu_DoubleClick" Style="{StaticResource DarkDataGrid}"
                              SelectedValuePath="MaChucVu"
                              CellStyle="{StaticResource DarkDataGridCell}" RowStyle="{StaticResource DarkDataGridRow}"
                              ColumnHeaderStyle="{StaticResource DarkColumnHeader}" IsReadOnly="True" SelectedIndex="0"
                              AutoGenerateColumns="False" CanUserAddRows="False" MinHeight="180">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mã" Binding="{Binding MaChucVu}" Width="*" MinWidth="65"/>
                            <DataGridTextColumn Header="Tên chức vụ" Binding="{Binding TenChucVu}" Width="*" MinWidth="110"/>
                            <DataGridTextColumn Header="Mô tả" Binding="{Binding MoTa}" Width="*" MinWidth="110"/>
                            <DataGridTextColumn Header="Mức lương" Binding="{Binding Chucvu, StringFormat=N2}" Width="*" MinWidth="110"/>

                            <DataGridTemplateColumn Header="Trạng thái" Width="*" MinWidth="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Ngừng hoạt động"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding TrangThai}" Value="True">
                                                            <Setter Property="Text" Value="Đang hoạt động"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock x:Name="txtThongBaoChucVu" Grid.Row="2" Text="Nhấp đúp để xem chi tiết / sửa"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,0" TextWrapping="Wrap"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
