<UserControl x:Class="QuanLyKhachSan.Views.BaoCaoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,12,20">
            <!-- KPI Cards -->
            <UniformGrid x:Name="kpiGrid" Rows="1" Margin="0,0,0,14"/>

            <!-- Revenue chart -->
            <Border Background="{StaticResource SurfaceBrush}" Padding="16,14" Margin="0,0,0,14">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="📈  Doanh thu theo tháng (triệu ₫)" FontWeight="SemiBold"
                               Foreground="{StaticResource GoldBrush}" Margin="0,0,0,10"/>
                    <Canvas x:Name="chartCanvas" Height="260" ClipToBounds="True" SizeChanged="ChartCanvas_SizeChanged"/>
                </DockPanel>
            </Border>

            <!-- Room occupancy table -->
            <Border Background="{StaticResource SurfaceBrush}" Padding="16,14" Margin="0,0,0,14">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="🛏️  Phân tích tình trạng phòng" FontWeight="SemiBold"
                               Foreground="{StaticResource GoldBrush}" Margin="0,0,0,10"/>
                    <DataGrid x:Name="dgvPhong" Style="{StaticResource DarkDataGrid}" CellStyle="{StaticResource DarkDataGridCell}"
                              RowStyle="{StaticResource DarkDataGridRow}" ColumnHeaderStyle="{StaticResource DarkColumnHeader}" MaxHeight="300">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Loại phòng" Binding="{Binding LoaiPhong}" Width="*"/>
                            <DataGridTextColumn Header="Tổng phòng" Binding="{Binding Tong}" Width="100"/>
                            <DataGridTextColumn Header="Đang ở" Binding="{Binding DangO}" Width="90"/>
                            <DataGridTextColumn Header="Trống" Binding="{Binding Trong}" Width="90"/>
                            <DataGridTextColumn Header="Bảo trì" Binding="{Binding BaoTri}" Width="90"/>
                            <DataGridTextColumn Header="Giá TB/đêm" Binding="{Binding GiaTB}" Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- Top customers -->
            <Border Background="{StaticResource SurfaceBrush}" Padding="16,14" Margin="0,0,0,14">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="👥  Top 10 khách hàng chi tiêu nhiều nhất" FontWeight="SemiBold"
                               Foreground="{StaticResource GoldBrush}" Margin="0,0,0,10"/>
                    <DataGrid x:Name="dgvTopKH" Style="{StaticResource DarkDataGrid}" CellStyle="{StaticResource DarkDataGridCell}"
                              RowStyle="{StaticResource DarkDataGridRow}" ColumnHeaderStyle="{StaticResource DarkColumnHeader}" MaxHeight="340">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding STT}" Width="40"/>
                            <DataGridTextColumn Header="Khách hàng" Binding="{Binding HoTen}" Width="*"/>
                            <DataGridTextColumn Header="Quốc tịch" Binding="{Binding QuocTich}" Width="100"/>
                            <DataGridTextColumn Header="Số lần đặt" Binding="{Binding SoLanDat}" Width="100"/>
                            <DataGridTextColumn Header="Tổng chi tiêu" Binding="{Binding TongChiTieu}" Width="160"/>
                            <DataGridTextColumn Header="Hạng" Binding="{Binding Hang}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- Revenue by department -->
            <Border Background="{StaticResource SurfaceBrush}" Padding="16,14">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="💼  Tổng chi phí nhân sự theo phòng ban" FontWeight="SemiBold"
                               Foreground="{StaticResource GoldBrush}" Margin="0,0,0,10"/>
                    <DataGrid x:Name="dgvDept" Style="{StaticResource DarkDataGrid}" CellStyle="{StaticResource DarkDataGridCell}"
                              RowStyle="{StaticResource DarkDataGridRow}" ColumnHeaderStyle="{StaticResource DarkColumnHeader}" MaxHeight="300">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Phòng ban" Binding="{Binding PB}" Width="*"/>
                            <DataGridTextColumn Header="Số NV" Binding="{Binding SoNV}" Width="90"/>
                            <DataGridTextColumn Header="Lương TB" Binding="{Binding LuongTB}" Width="160"/>
                            <DataGridTextColumn Header="Tổng lương" Binding="{Binding TongLuong}" Width="160"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
