<UserControl x:Class="QuanLyKhachSan.Views.LuuTruView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:mau="clr-namespace:QuanLyKhachSan.Data"
    d:DesignWidth="1120" d:DesignHeight="720"
    Background="{StaticResource BackgroundBrush}" FontFamily="Segoe UI">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/QuanLyKhachSan;component/Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="0,14,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" Margin="0,6,0,14" HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="btnKhachLuuTruThemKhachLuuTru" Content="Thêm khách lưu trú" Click="btnKhachLuuTruThemKhachLuuTru_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8"/>
                <TextBox x:Name="txtTimKhachLuuTru" Width="220" Style="{StaticResource DarkTextBox}" ToolTip="Từ khóa tìm kiếm" Margin="0,0,8,8"/>
                <ComboBox x:Name="cboLocKhachLuuTru" Width="190" SelectedValuePath="Tag" SelectedIndex="0" Style="{StaticResource DarkComboBox}" Margin="0,0,8,8">
                    <ComboBoxItem Style="{StaticResource ReadableComboBoxItem}" Content="Tất cả dữ liệu" Tag=""/>
                </ComboBox>
                <Button x:Name="btnTimKhachLuuTru" Content="Tìm kiếm" Click="btnTimKhachLuuTru_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"/>
                <Button x:Name="btnMoiKhachLuuTru" Content="Làm mới" Click="btnMoiKhachLuuTru_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,0,8"/>
            </StackPanel>
        </ScrollViewer>
        <DataGrid Grid.Row="1" x:Name="dgvKhachLuuTru" MouseDoubleClick="KhachLuuTru_DoubleClick" Style="{StaticResource DarkDataGrid}"
                  CellStyle="{StaticResource DarkDataGridCell}" RowStyle="{StaticResource DarkDataGridRow}"
                  ColumnHeaderStyle="{StaticResource DarkColumnHeader}" IsReadOnly="True" SelectedIndex="0"
                  SelectedValuePath="MaXepPhong" AutoGenerateColumns="False" CanUserAddRows="False" MinHeight="180">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Mã" Binding="{Binding MaXepPhong}" Width="*" MinWidth="110"/>
                <DataGridTextColumn Header="Đặt phòng" Binding="{Binding MaDatPhong}" Width="*" MinWidth="110"/>
                <DataGridTextColumn Header="Phòng" Binding="{Binding SoPhong}" Width="*" MinWidth="110"/>
                <DataGridTextColumn Header="Khách hàng" Binding="{Binding HoTen}" Width="*" MinWidth="110"/>
                <DataGridTextColumn Header="Giấy tờ" Binding="{Binding SoGiayTo}" Width="*" MinWidth="110"/>
                <DataGridTextColumn Header="Ngày vào" Binding="{Binding NgayNhanThucTe}" Width="*" MinWidth="110"/>
                <DataGridTextColumn Header="Ngày ra" Binding="{Binding NgayTraThucTe}" Width="*" MinWidth="110"/>
            <DataGridTemplateColumn Header="Nhóm khách" Width="*" MinWidth="110"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="—" ToolTip="Thông tin hiển thị của chức năng này" Foreground="{StaticResource TextPrimaryBrush}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
</DataGrid.Columns></DataGrid>

        <TextBlock Grid.Row="2" Text=" Nhấp đúp để xem chi tiết"
                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,0" TextWrapping="Wrap"/>
    </Grid>
</UserControl>
