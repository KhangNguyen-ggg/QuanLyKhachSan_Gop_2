<UserControl x:Class="QuanLyKhachSan.Views.DashboardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mau="clr-namespace:QuanLyKhachSan.Data"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" d:DesignWidth="1120" d:DesignHeight="720"
    Background="{StaticResource BackgroundBrush}">
    <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/QuanLyKhachSan;component/Resources/Styles.xaml"/>
    </ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
    <!-- Biểu đồ và số liệu khai báo cố định; không vẽ control trong code-behind. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,0,20">
            <UniformGrid Columns="5" Margin="0,0,-12,16">
                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource InfoBrush}" BorderThickness="4,0,0,0" Margin="0,0,12,0" Padding="16,20" MinHeight="136">
                    <StackPanel><TextBlock Text="Phòng đang có khách" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/><TextBlock Text="24" FontSize="25" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,12,0,8"/><TextBlock Text="/ 40 phòng" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/></StackPanel>
                </Border>
                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource SuccessBrush}" BorderThickness="4,0,0,0" Margin="0,0,12,0" Padding="16,20" MinHeight="136">
                    <StackPanel><TextBlock Text="Phòng trống" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/><TextBlock Text="14" FontSize="25" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,12,0,8"/><TextBlock Text="Sẵn sàng đón khách" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/></StackPanel>
                </Border>
                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource WarningBrush}" BorderThickness="4,0,0,0" Margin="0,0,12,0" Padding="16,20" MinHeight="136">
                    <StackPanel><TextBlock Text="Phòng bảo trì" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/><TextBlock Text="2" FontSize="25" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,12,0,8"/><TextBlock Text="Đang sửa chữa" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/></StackPanel>
                </Border>
                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource GoldBrush}" BorderThickness="4,0,0,0" Margin="0,0,12,0" Padding="16,20" MinHeight="136">
                    <StackPanel><TextBlock Text="Đặt phòng hôm nay" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/><TextBlock Text="8" FontSize="25" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,12,0,8"/><TextBlock Text="Đơn đặt phòng mới" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/></StackPanel>
                </Border>
                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource SuccessBrush}" BorderThickness="4,0,0,0" Margin="0,0,12,0" Padding="16,20" MinHeight="136">
                    <StackPanel><TextBlock Text="Doanh thu hôm nay" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/><TextBlock Text="56.000.000 đ" FontSize="25" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,12,0,8"/><TextBlock Text="Thanh toán tiền mặt" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/></StackPanel>
                </Border>
            </UniformGrid>
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" Padding="16,18">
                    <StackPanel>
                        <TextBlock Text="Doanh thu 7 ngày gần nhất" Foreground="{StaticResource GoldBrush}" FontSize="17" FontWeight="SemiBold"/>
                        <TextBlock Text="21/09 – 27/09/2026 · Đơn vị: triệu đồng" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,6,0,12"/>
                        <Viewbox Stretch="Uniform" Height="300">
                            <Canvas x:Name="chartCanvas" Width="540" Height="300">
                                <Line X1="54" Y1="254" X2="528" Y2="254" Stroke="#26334B" StrokeThickness="1"/>
                                <TextBlock Text="0 tr" Canvas.Left="4" Canvas.Top="247" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                <Line X1="54" Y1="199" X2="528" Y2="199" Stroke="#26334B" StrokeThickness="1"/>
                                <TextBlock Text="40 tr" Canvas.Left="4" Canvas.Top="192" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                <Line X1="54" Y1="144" X2="528" Y2="144" Stroke="#26334B" StrokeThickness="1"/>
                                <TextBlock Text="80 tr" Canvas.Left="4" Canvas.Top="137" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                <Line X1="54" Y1="89" X2="528" Y2="89" Stroke="#26334B" StrokeThickness="1"/>
                                <TextBlock Text="120 tr" Canvas.Left="4" Canvas.Top="82" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                <Line X1="54" Y1="34" X2="528" Y2="34" Stroke="#26334B" StrokeThickness="1"/>
                                <TextBlock Text="160 tr" Canvas.Left="4" Canvas.Top="27" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                <Rectangle x:Name="cotNgay1" Width="40" Height="116.875" Canvas.Left="65" Canvas.Top="137.125">
                                    <Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#EBC869" Offset="0"/><GradientStop Color="#C9A84C" Offset="1"/></LinearGradientBrush></Rectangle.Fill>
                                </Rectangle>
                                <TextBlock Text="85 tr" Canvas.Left="67" Canvas.Top="116.125" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11"/>
                                <TextBlock Text="21/09" Canvas.Left="68" Canvas.Top="267" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                <Rectangle x:Name="cotNgay2" Width="40" Height="85.25" Canvas.Left="131" Canvas.Top="168.75">
                                    <Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#EBC869" Offset="0"/><GradientStop Color="#C9A84C" Offset="1"/></LinearGradientBrush></Rectangle.Fill>
                                </Rectangle>
                                <TextBlock Text="62 tr" Canvas.Left="133" Canvas.Top="147.75" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11"/>
                                <TextBlock Text="22/09" Canvas.Left="134" Canvas.Top="267" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                <Rectangle x:Name="cotNgay3" Width="40" Height="165" Canvas.Left="197" Canvas.Top="89">
                                    <Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#EBC869" Offset="0"/><GradientStop Color="#C9A84C" Offset="1"/></LinearGradientBrush></Rectangle.Fill>
                                </Rectangle>
                                <TextBlock Text="120 tr" Canvas.Left="199" Canvas.Top="68" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11"/>
                                <TextBlock Text="23/09" Canvas.Left="200" Canvas.Top="267" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                <Rectangle x:Name="cotNgay4" Width="40" Height="130.625" Canvas.Left="263" Canvas.Top="123.375">
                                    <Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#EBC869" Offset="0"/><GradientStop Color="#C9A84C" Offset="1"/></LinearGradientBrush></Rectangle.Fill>
                                </Rectangle>
                                <TextBlock Text="95 tr" Canvas.Left="265" Canvas.Top="102.375" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11"/>
                                <TextBlock Text="24/09" Canvas.Left="266" Canvas.Top="267" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                <Rectangle x:Name="cotNgay5" Width="40" Height="196.625" Canvas.Left="329" Canvas.Top="57.375">
                                    <Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#EBC869" Offset="0"/><GradientStop Color="#C9A84C" Offset="1"/></LinearGradientBrush></Rectangle.Fill>
                                </Rectangle>
                                <TextBlock Text="143 tr" Canvas.Left="331" Canvas.Top="36.375" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11"/>
                                <TextBlock Text="25/09" Canvas.Left="332" Canvas.Top="267" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                <Rectangle x:Name="cotNgay6" Width="40" Height="107.25" Canvas.Left="395" Canvas.Top="146.75">
                                    <Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#EBC869" Offset="0"/><GradientStop Color="#C9A84C" Offset="1"/></LinearGradientBrush></Rectangle.Fill>
                                </Rectangle>
                                <TextBlock Text="78 tr" Canvas.Left="397" Canvas.Top="125.75" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11"/>
                                <TextBlock Text="26/09" Canvas.Left="398" Canvas.Top="267" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                <Rectangle x:Name="cotNgay7" Width="40" Height="77" Canvas.Left="461" Canvas.Top="177">
                                    <Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#EBC869" Offset="0"/><GradientStop Color="#C9A84C" Offset="1"/></LinearGradientBrush></Rectangle.Fill>
                                </Rectangle>
                                <TextBlock Text="56 tr" Canvas.Left="463" Canvas.Top="156" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11"/>
                                <TextBlock Text="27/09" Canvas.Left="464" Canvas.Top="267" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                            </Canvas>
                        </Viewbox>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" Padding="0,18,0,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Đặt phòng gần đây" Foreground="{StaticResource GoldBrush}" FontSize="17" FontWeight="SemiBold" Margin="16,0,16,18"/>
                        <DataGrid x:Name="dgvRecent" Style="{StaticResource DarkDataGrid}" CellStyle="{StaticResource DarkDataGridCell}"
                                  RowStyle="{StaticResource DarkDataGridRow}" ColumnHeaderStyle="{StaticResource DarkColumnHeader}" MinHeight="300">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Mã" Binding="{Binding Ma}" Width="65"/>
                                <DataGridTextColumn Header="Khách hàng" Binding="{Binding KhachHang}" Width="*" MinWidth="130"/>
                                <DataGridTextColumn Header="Nhận phòng" Binding="{Binding NhanPhong}" Width="100"/>
                                <DataGridTextColumn Header="Trạng thái" Binding="{Binding TrangThai}" Width="125"/>
                            </DataGrid.Columns>
                            <mau:DatPhongMau Ma="DP008" KhachHang="Nguyễn Minh Anh" NhanPhong="27/09/2026" TrangThai="Đang ở"/>
                            <mau:DatPhongMau Ma="DP007" KhachHang="Trần Quốc Bảo" NhanPhong="28/09/2026" TrangThai="Chờ xác nhận"/>
                            <mau:DatPhongMau Ma="DP006" KhachHang="Lê Thảo Vy" NhanPhong="29/09/2026" TrangThai="Đã xác nhận"/>
                            <mau:DatPhongMau Ma="DP005" KhachHang="Phạm Gia Hân" NhanPhong="27/09/2026" TrangThai="Đang ở"/>
                            <mau:DatPhongMau Ma="DP004" KhachHang="Võ Hoàng Nam" NhanPhong="26/09/2026" TrangThai="Đang ở"/>
                            <mau:DatPhongMau Ma="DP003" KhachHang="Đặng Ngọc Mai" NhanPhong="26/09/2026" TrangThai="Đã trả phòng"/>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </Grid>
            <UniformGrid Columns="5" Margin="0,0,-12,0">
                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource InfoBrush}" BorderThickness="0,3,0,0" Padding="16,20" Margin="0,0,12,0"><StackPanel><TextBlock Text="Tổng khách hàng" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/><TextBlock Text="128" Foreground="{StaticResource InfoBrush}" FontSize="30" FontWeight="Bold" Margin="0,10,0,0"/></StackPanel></Border>
                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource SuccessBrush}" BorderThickness="0,3,0,0" Padding="16,20" Margin="0,0,12,0"><StackPanel><TextBlock Text="Nhân viên đang làm" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/><TextBlock Text="24" Foreground="{StaticResource SuccessBrush}" FontSize="30" FontWeight="Bold" Margin="0,10,0,0"/></StackPanel></Border>
                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource GoldBrush}" BorderThickness="0,3,0,0" Padding="16,20" Margin="0,0,12,0"><StackPanel><TextBlock Text="Dịch vụ đang cung cấp" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/><TextBlock Text="12" Foreground="{StaticResource GoldBrush}" FontSize="30" FontWeight="Bold" Margin="0,10,0,0"/></StackPanel></Border>
                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource WarningBrush}" BorderThickness="0,3,0,0" Padding="16,20" Margin="0,0,12,0"><StackPanel><TextBlock Text="Ưu đãi đang áp dụng" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/><TextBlock Text="3" Foreground="{StaticResource WarningBrush}" FontSize="30" FontWeight="Bold" Margin="0,10,0,0"/></StackPanel></Border>
                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource DangerBrush}" BorderThickness="0,3,0,0" Padding="16,20" Margin="0,0,12,0"><StackPanel><TextBlock Text="Hóa đơn chưa thanh toán" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/><TextBlock Text="5" Foreground="{StaticResource DangerBrush}" FontSize="30" FontWeight="Bold" Margin="0,10,0,0"/></StackPanel></Border>
            </UniformGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
