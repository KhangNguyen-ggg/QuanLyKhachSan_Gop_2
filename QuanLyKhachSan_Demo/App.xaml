<Application x:Class="QuanLyKhachSan.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:QuanLyKhachSan.Helpers">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Global Converters -->
            <helpers:StatusTextConverter x:Key="StatusTextConverter"/>
            <helpers:StatusColorConverter x:Key="StatusColorConverter"/>
            <helpers:StatusBadgeBgConverter x:Key="StatusBadgeBgConverter"/>
            <helpers:VndConverter x:Key="VndConverter"/>
            <helpers:BoolToStatusConverter x:Key="BoolToStatusConverter"/>
            <helpers:CustomerRankConverter x:Key="CustomerRankConverter"/>
            <helpers:CustomerRankColorConverter x:Key="CustomerRankColorConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
